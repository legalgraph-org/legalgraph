---
// The method page's diagram: how the graph is made, from the official text to the site, with the
// check that proves each step. The numbers match the sections of the method page. Everything left
// of the graph is kept in Git; the graph and what is made from it are generated. Dashes flow along
// the arrows; with reduced motion they stand still. Wide: on narrow screens it scrolls sideways.
// The boxes' descriptions and the checks are HTML inside the SVG (foreignObject), so a sentence in
// any language wraps to its box by itself.
import type { Translate } from "../i18n/t";

interface Props {
  t: Translate;
}

const { t } = Astro.props;
type Box = { x: number; y: number; w: number; h: number; step?: string; title: string; text: string; path?: string };

const stages: Box[] = [
  { x: 24, y: 64, w: 200, h: 150, step: "1", title: t("Official text"), text: t("Laws, judgments, guidelines as the portal publishes them: XML, HTML or PDF"), path: "sources/" },
  { x: 268, y: 64, w: 200, h: 150, step: "2", title: t("Annotated text"), text: t("Our marks on the official XML, or a transcription into our XML schema"), path: "*.annotated.xml" },
  { x: 512, y: 64, w: 200, h: 150, step: "4", title: t("Generated Turtle"), text: t("Provisions and quotes, extracted by a program, never edited by hand"), path: "data/extracted/" },
  { x: 776, y: 64, w: 200, h: 150, title: t("The graph"), text: t("All the Turtle, checked against the ontology and its SHACL shapes"), path: "legalgraph.ttl" },
];
const editorial: Box = {
  x: 390, y: 298, w: 240, h: 132, step: "5", title: t("Editorial Turtle"), text: t("Rules, cases, translations: each cites its provisions, Draft until reviewed"), path: "data/rules/ …",
};
const outputs = [
  { x: 814, y: 276, title: t("Static site"), text: "legalgraph.org" },
  { x: 814, y: 336, title: t("Downloads"), text: "TTL · NT · JSON-LD · JSON" },
  { x: 814, y: 396, title: "SPARQL", text: t("your own questions") },
];
// The check under each stage: what fails the build if the step went wrong.
const checks = [
  { x: 124, text: t("hash + date; re-checked upstream") },
  { x: 368, text: t("marks removed = the original") },
  { x: 612, text: t("same input, same bytes") },
  { x: 876, text: t("syntax · terms · shapes · English") },
];

const arrows = [
  "M224 130 L262 130",
  "M468 130 L506 130",
  "M712 130 L770 130",
  // editorial joins the graph from below, into its left side
  "M630 364 L742 364 Q754 364 754 352 L754 180 Q754 168 766 168 L770 168",
  // the graph feeds the site, the downloads and SPARQL: one branch to each, off a trunk below
  "M792 300 L810 300",
  "M792 360 L810 360",
  "M792 420 L810 420",
];
// The trunk those branches leave from: down from the graph's check, no arrowhead of its own.
const trunk = "M792 250 L792 420";
---

<figure class="pipeline -mx-1 overflow-x-auto pb-2" aria-labelledby="pipeline-caption">
  <svg viewBox="0 0 1000 468" class="h-auto w-full min-w-[760px]" role="img" aria-labelledby="pipeline-title pipeline-desc">
    <title id="pipeline-title">{t("From the law text to the site")}</title>
    <desc id="pipeline-desc">
      {t("The official text is kept in Git unchanged. It is annotated, and the annotation is proved against the original. A program extracts Turtle from it. Editorial Turtle (rules, cases, translations) is added. The whole graph is validated, then published as a static site, as downloads and for SPARQL queries.")}
    </desc>
    <defs>
      <marker id="pipeline-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="pipeline-head"></path>
      </marker>
    </defs>

    <!-- What is kept in Git -->
    <rect x="8" y="14" width="726" height="432" rx="16" class="pipeline-git"></rect>
    <text x="28" y="42" class="pipeline-git-label">{t("Kept in Git: every change versioned and reviewed")}</text>
    <text x="776" y="42" class="pipeline-git-label">{t("Generated on every build")}</text>

    <path d={trunk} class="pipeline-arrow" />
    {arrows.map((d) => <path d={d} class="pipeline-arrow" marker-end="url(#pipeline-head)" />)}

    {
      [...stages, editorial].map((box) => (
        <g>
          <rect x={box.x} y={box.y} width={box.w} height={box.h} rx="12" class:list={["pipeline-box", box === stages[3] && "pipeline-box-graph"]} />
          {box.step && (
            <>
              <circle cx={box.x + 22} cy={box.y + 24} r="11" class="pipeline-step" />
              <text x={box.x + 22} y={box.y + 28} text-anchor="middle" class="pipeline-step-text">
                {box.step}
              </text>
            </>
          )}
          <text x={box.x + (box.step ? 42 : 18)} y={box.y + 29} class="pipeline-title">
            {box.title}
          </text>
          <foreignObject x={box.x + 16} y={box.y + 40} width={box.w - 30} height={box.h - 66}>
            <div class="pipeline-text">
              {box.text}
            </div>
          </foreignObject>
          {box.path && (
            <text x={box.x + 18} y={box.y + box.h - 14} class="pipeline-path">
              {box.path}
            </text>
          )}
        </g>
      ))
    }

    {
      checks.map((check) => (
        <g>
          <rect x={check.x - 114} y="224" width="228" height="26" rx="13" class="pipeline-check" />
          <foreignObject x={check.x - 112} y="224" width="224" height="26">
            <div class="pipeline-check-text">
              ✓ {check.text}
            </div>
          </foreignObject>
        </g>
      ))
    }

    {
      outputs.map((box) => (
        <g>
          <rect x={box.x} y={box.y} width="176" height="48" rx="10" class="pipeline-box pipeline-out" />
          <text x={box.x + 14} y={box.y + 20} class="pipeline-out-title">
            {box.title}
          </text>
          <text x={box.x + 14} y={box.y + 38} class="pipeline-line">
            {box.text}
          </text>
        </g>
      ))
    }
  </svg>
  <figcaption id="pipeline-caption" class="mt-2 text-sm text-muted-foreground">
    {t("From the law text to the site. Numbers are the sections below; each tick is a check that fails the build if the step went wrong.")}
  </figcaption>
</figure>

<style>
  .pipeline svg {
    font-family: inherit;
  }
  .pipeline-git {
    fill: color-mix(in oklab, var(--teal-600) 5%, transparent);
    stroke: color-mix(in oklab, var(--teal-600) 45%, transparent);
    stroke-width: 1.25;
    stroke-dasharray: 6 6;
  }
  .pipeline-git-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    fill: var(--primary);
  }
  .pipeline-box {
    fill: var(--background);
    stroke: var(--border-strong);
    stroke-width: 1.25;
  }
  .pipeline-box-graph {
    stroke: var(--blue-600);
    stroke-width: 2;
  }
  .pipeline-out {
    fill: color-mix(in oklab, var(--blue-600) 6%, var(--background));
  }
  .pipeline-step {
    fill: color-mix(in oklab, var(--primary) 14%, var(--background));
  }
  .pipeline-step-text {
    font-size: 12px;
    font-weight: 700;
    fill: var(--primary);
  }
  .pipeline-title {
    font-size: 15px;
    font-weight: 700;
    fill: var(--text);
  }
  .pipeline-out-title {
    font-size: 13px;
    font-weight: 700;
    fill: var(--text);
  }
  .pipeline-line {
    font-size: 12.5px;
    fill: var(--text-2);
  }
  .pipeline-path {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    fill: var(--primary);
  }
  .pipeline-check {
    fill: color-mix(in oklab, var(--teal-600) 10%, var(--background));
    stroke: color-mix(in oklab, var(--teal-600) 40%, transparent);
  }
  .pipeline-text {
    font-size: 12.5px;
    line-height: 1.42;
    color: var(--text-2);
  }
  .pipeline-check-text {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--teal-800);
  }
  .pipeline-arrow {
    fill: none;
    stroke: var(--teal-600);
    stroke-width: 1.75;
    stroke-dasharray: 5 5;
    animation: pipeline-flow 1.1s linear infinite;
  }
  .pipeline-head {
    fill: var(--teal-600);
  }
  @keyframes pipeline-flow {
    to {
      stroke-dashoffset: -10;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pipeline-arrow {
      animation: none;
    }
  }
</style>
