---
// Information items × jurisdictions: which law requires which detail where.
import Layout from "../../layouts/Layout.astro";
import type { Translate } from "../../i18n/t";
import { loadGraph } from "../../lib/data";

interface Props {
  t: Translate;
}

const { t } = Astro.props;

const graph = await loadGraph();
const provisions = [...graph.provisions.values()];
// One group of rows per disclosure (Impressum, privacy information, …): the items required by
// provisions that regulate it or one of its narrower types. A provision that regulates several
// disclosures (an Impressum article that also covers prices) counts once, for the largest of them.
const disclosures = [...graph.concepts.values()].filter((c) => c.data.kind === "disclosure" && c.data.broader.length === 0);
const scopeOf = (disclosure: (typeof disclosures)[number]) => new Set([disclosure.id, ...disclosure.data.narrower]);
const regulating = (disclosure: (typeof disclosures)[number]) =>
  provisions.filter((p) => p.data.requires.length > 0 && p.data.regulates.some((id) => scopeOf(disclosure).has(id)));
const bySize = [...disclosures].sort((a, b) => regulating(b).length - regulating(a).length || a.id.localeCompare(b.id));
const assigned = new Set<string>();
const groups = bySize
  .map((disclosure) => {
    const members = regulating(disclosure).filter((p) => !assigned.has(p.id));
    members.forEach((p) => assigned.add(p.id));
    const items = [...new Set(members.flatMap((p) => p.data.requires))]
      .map((id) => graph.concepts.get(id)!)
      .sort((a, b) => a.data.label.localeCompare(b.data.label));
    return { disclosure, members, items };
  })
  .filter((group) => group.items.length > 0);
const withProvisions = new Set(provisions.filter((p) => p.data.requires.length > 0).map((p) => p.data.jurisdiction));
const jurisdictions = [...graph.jurisdictions.values()]
  .filter((j) => withProvisions.has(j.id))
  .sort((a, b) => (a.data.kind === b.data.kind ? a.data.label.localeCompare(b.data.label) : a.data.kind === "organisation" ? -1 : 1));
const cell = (members: typeof provisions, item: string, jurisdiction: string) =>
  members.filter((p) => p.data.jurisdiction === jurisdiction && p.data.requires.includes(item));
---

<Layout
  t={t}
  page="items"
  title="Compare"
  header={{ title: "Compare", description: "What a website must disclose, country by country, with the provisions that require it." }}
>
  <p class="mt-1 mb-6 max-w-3xl text-muted-foreground">
    Each cell links to the provisions that require the information item in that jurisdiction. Only jurisdictions with
    analysed provisions are shown; an empty cell means none of the provisions recorded so far names the item, not that
    no law does.
  </p>
  <div class="mb-4" data-items-filter hidden>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="text-xs font-medium tracking-wide text-muted-foreground uppercase">Filter by disclosure</span>
      {
        groups.map(({ disclosure, items }) => (
          <button
            type="button"
            aria-pressed="false"
            data-items-filter-type={disclosure.id}
            class="control rounded-full px-2.5 text-xs hover:border-primary"
            title={disclosure.data.altLabels.map((l) => l.text).join(" · ")}
          >
            {disclosure.data.label}
            <span class="ml-1 text-muted-foreground/70">{items.length}</span>
          </button>
        ))
      }
      <div class="relative ml-auto">
        <input
          type="text"
          placeholder="Search items — e.g. Imprint"
          class="w-56 rounded-full border border-border-strong py-1 pr-7 pl-3 text-sm"
          data-items-filter-search
        />
        <button
          type="button"
          aria-label="Clear search"
          class="absolute top-1/2 right-2 -translate-y-1/2 text-muted-foreground/70 hover:text-foreground/80"
          data-items-filter-clear
          hidden
        >
          ×
        </button>
      </div>
    </div>
    <p class="mt-2 text-sm text-muted-foreground" data-items-filter-empty hidden>
      Nothing matches — disclosures combine with OR, the search narrows them down.
    </p>
  </div>
  <div class="card max-h-[calc(100vh-6rem)] overflow-auto p-0" data-items-table>
    <table class="table border-separate border-spacing-0">
      <thead>
        <tr>
          <th class="sticky left-0 top-0 z-20 bg-card">Information item</th>
          {
            jurisdictions.map((j) => (
              <th class="sticky top-0 z-10 bg-card text-center">
                <a href={`/id/${j.id}`} title={j.data.label}>
                  {j.data.code}
                </a>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          groups.map(({ disclosure, members, items }) => [
            <tr data-group-header={disclosure.id}>
              <th colspan={jurisdictions.length + 1} class="sticky left-0 bg-muted text-left">
                <a href={`/vocab/${disclosure.id}`}>{disclosure.data.label}</a>
                {disclosure.data.altLabels.length > 0 && (
                  <span class="ml-2 text-xs font-normal text-muted-foreground">
                    {disclosure.data.altLabels.slice(0, 3).map((l) => l.text).join(" · ")}
                  </span>
                )}
              </th>
            </tr>,
            ...items.map((item) => (
            <tr
              data-group={disclosure.id}
              data-filter={`${item.data.label} ${disclosure.data.label} ${disclosure.data.altLabels.map((l) => l.text).join(" ")}`.toLowerCase()}
            >
              <td class="sticky left-0 bg-card">
                <a href={`/vocab/${item.id}`}>{item.data.label}</a>
              </td>
              {jurisdictions.map((j) => {
                const found = cell(members, item.id, j.id);
                return (
                  <td class="text-center">
                    {found.map((p) => (
                      <a
                        href={`/id/${p.id}`}
                        title={p.data.citation}
                        class:list={[
                          "tag no-underline text-xs",
                          p.data.reviewStatus === "SourceChecked" ? "tone-checked" : "tone-draft",
                        ]}
                      >
                        ✓
                      </a>
                    ))}
                  </td>
                );
              })}
            </tr>
            )),
          ])
        }
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-sm text-muted-foreground">
    <span class="tag tone-checked">✓</span> source checked ·
    <span class="tag tone-draft">✓</span> draft. Hover a mark for the citation.
  </p>
</Layout>

<script>
  import { startItemFilter } from "../../scripts/item-filter";
  startItemFilter(document.querySelector<HTMLElement>("[data-items-filter]")!);
</script>
