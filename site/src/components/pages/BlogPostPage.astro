---
// /blog/<slug>, in every language: one article, from <slug>.<locale>.md or, untranslated, <slug>.md.
// The header in a full-width tinted band (PageHeader) with the back
// link, title, description and the date, reading time, author and category; then the text with its
// table of contents on the left (Article).
import { render, type CollectionEntry } from "astro:content";
import T from "../../i18n/T.astro";
import type { Translate } from "../../i18n/t";
import { abbreviationMarker } from "../../lib/glossary";
import Layout from "../../layouts/Layout.astro";
import { formatDate, readingMinutes, type Localized } from "../../lib/content";
import { pagePath } from "../../lib/routes";
import Article from "../ds/Article.astro";
import PageHeader from "../ds/PageHeader.astro";
import Section from "../ds/Section.astro";

interface Props {
  t: Translate;
  post: Localized<CollectionEntry<"blog">>;
}

const { t, post } = Astro.props;
const mark = await abbreviationMarker(t.locale);
const { entry, translated } = post;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description} t={t} page={`blog/${post.slug}`} bare>
  <PageHeader title={entry.data.title} description={entry.data.description}>
    <a slot="above" href={pagePath("blog", t.locale)} class="mb-4 inline-block text-sm text-muted-foreground no-underline hover:text-foreground">
      ← {t("Back to articles")}
    </a>
    <p class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
      <span>{formatDate(t.locale, entry.data.published)}</span>
      {entry.data.updated && <span>{t("updated {date}", { date: formatDate(t.locale, entry.data.updated) })}</span>}
      <span>{t("{minutes} min read", { minutes: readingMinutes(entry) })}</span>
      <span>{entry.data.author}</span>
      {entry.data.category && <span class="rounded-full bg-background/70 px-3 py-1 font-medium text-primary">{entry.data.category}</span>}
      {entry.data.draft && <span class="tag tone-draft">{t("draft")}</span>}
    </p>
  </PageHeader>
  <Section space="small">
    <Article label={t("On this page")} collapseLabel={t("Collapse")} expandLabel={t("Expand")} mark={mark} class="mx-auto max-w-5xl">
      {!translated && <p class="notice mb-8">{t("This article has not been translated yet. Here it is in English.")}</p>}
      <div class="prose sectioned" lang={translated ? undefined : "en"}>
        <Content />
      </div>
      <p class="notice mt-12">
        <T
          msg={t("<0>Not legal advice.</0> Written by researchers, not lawyers. Check the official text before relying on it.")}
          tags={[{ kind: "strong" }]}
        />
      </p>
    </Article>
  </Section>
</Layout>
