---
// All rules of the rules layer, filterable by jurisdiction, by the notice or topic they concern and
// by what they ask for, and searchable by their words, conditions, items and provisions.
import FilterList from "../ds/FilterList.astro";
import { tagId, type FilterGroup } from "../ds/filter-list.types";
import Pointer from "../Pointer.astro";
import Refs from "../Refs.astro";
import Status from "../Status.astro";
import Layout from "../../layouts/Layout.astro";
import type { Translate } from "../../i18n/t";
import { loadGraph } from "../../lib/data";
import { pagePath } from "../../lib/routes";

interface Props {
  t: Translate;
}

const { t } = Astro.props;

const graph = await loadGraph();
const label = (id: string) => graph.concepts.get(id)?.data.label ?? graph.provisions.get(id)?.data.citation ?? id;
const ACTIONS = "actions";

const entries = [...graph.obligations.values()].map((rule) => {
  const d = rule.data;
  const topic = d.disclosure ?? ACTIONS;
  const asks = [d.items.length > 0 && "disclose", d.actions.length > 0 && "act"].filter(Boolean) as string[];
  const tags = [`j-${tagId(d.appliesIn)}`, `topic-${tagId(topic)}`, ...asks.map((a) => `asks-${a}`)];
  const search = [d.label, d.comment, rule.id, ...[...d.appliesWhen, ...d.unless, ...d.items, ...d.actions, ...d.establishedBy].map(label)]
    .filter(Boolean)
    .join(" ")
    .toLocaleLowerCase();
  return { rule, topic, tags, search };
});
const jurisdictionLabel = (id: string) => graph.jurisdictions.get(id)?.data.label ?? id;
const topicLabel = (id: string) => (id === ACTIONS ? "Other duties (actions)" : label(id));
entries.sort(
  (a, b) =>
    jurisdictionLabel(a.rule.data.appliesIn).localeCompare(jurisdictionLabel(b.rule.data.appliesIn)) ||
    topicLabel(a.topic).localeCompare(topicLabel(b.topic)) ||
    a.rule.data.label.localeCompare(b.rule.data.label),
);

const count = (id: string) => entries.filter((e) => e.tags.includes(id)).length;
const distinct = <T,>(values: T[]) => [...new Set(values)];
const groups: FilterGroup[] = [
  {
    title: "Jurisdiction",
    options: distinct(entries.map((e) => e.rule.data.appliesIn))
      .map((j) => ({ id: `j-${tagId(j)}`, label: jurisdictionLabel(j), count: count(`j-${tagId(j)}`) }))
      .sort((a, b) => a.label.localeCompare(b.label)),
  },
  {
    title: "Topic",
    options: distinct(entries.map((e) => e.topic))
      .map((t) => ({ id: `topic-${tagId(t)}`, label: topicLabel(t), count: count(`topic-${tagId(t)}`) }))
      .sort((a, b) => b.count - a.count),
  },
  {
    title: "Asks for",
    options: [
      { id: "asks-disclose", label: "Information to disclose", count: count("asks-disclose") },
      { id: "asks-act", label: "Something to do", count: count("asks-act") },
    ],
  },
];
---

<Layout
  t={t}
  page="rules"
  title="Rules"
  header={{
    title: "Rules",
    description: "Who must do what, and when, read from the provisions in the graph.",
    note: "Rules are interpretation: drafts until a lawyer reviews them. Not legal advice.",
  }}
>
  <p class="mb-8 max-w-3xl text-muted-foreground">
    Each rule names the conditions it applies under, its exemptions, what it requires and the provisions it comes from.
    Answer the questions in the <a href={pagePath("checklist", t.locale)}>checklist</a> to see which apply to a business.
  </p>
  <FilterList
    id="rules"
    groups={groups}
    total={entries.length}
    allLabel="All rules"
    searchLabel="Search the rules"
    searchPlaceholder="Search rules, conditions or provisions, e.g. cookies, VAT, § 5 DDG"
    emptyText="No rule matches your search."
    pageSize={10}
  >
    {
      entries.map(({ rule, topic, tags, search }) => (
        <article class="filter-entry card space-y-2 p-5 text-sm" data-tags={tags.join(" ")} data-search={search}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <a href={`/id/${rule.id}`} class="text-base font-semibold">
              {rule.data.label}
            </a>
            <span class="text-muted-foreground">
              {jurisdictionLabel(rule.data.appliesIn)} · {topicLabel(topic)}
            </span>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <Status status={rule.data.reviewStatus} />
            <Pointer id={rule.id} />
          </div>
          <p><span class="text-muted-foreground">When:</span> <Refs ids={rule.data.appliesWhen} /></p>
          {rule.data.unless.length > 0 && <p><span class="text-muted-foreground">Unless:</span> <Refs ids={rule.data.unless} /></p>}
          {rule.data.items.length > 0 && <p><span class="text-muted-foreground">Disclose:</span> <Refs ids={rule.data.items} /></p>}
          {rule.data.actions.length > 0 && <p><span class="text-muted-foreground">Do:</span> <Refs ids={rule.data.actions} /></p>}
          <p class="text-muted-foreground">From <Refs ids={rule.data.establishedBy} /></p>
        </article>
      ))
    }
  </FilterList>
</Layout>
