---
// A rule of the rules layer: who must do what, when, and the words of the law it comes from.
import { loadGraph, type Obligation } from "../../lib/data";
import CaseList from "../CaseList.astro";
import MiniGraph from "../MiniGraph.astro";
import QuoteBlock from "../QuoteBlock.astro";
import Refs from "../Refs.astro";
import Header from "./Header.astro";

interface Props {
  obligation: Obligation;
}

const { obligation } = Astro.props;
const o = obligation.data;
const graph = await loadGraph();
const DEONTIC: Record<string, string> = { Must: "Obligation", MustNot: "Prohibition", May: "Permission" };
const provisions = o.establishedBy.map((id) => graph.provisions.get(id)).filter((p) => p !== undefined);
const refinedBy = [...graph.obligations.values()].filter((r) => r.data.refines.includes(obligation.id)).map((r) => r.id);
const national = Object.entries(o.implementedBy);
const penalties = o.penalties.map((id) => graph.provisions.get(id)).filter((p) => p !== undefined);
---

<Header
  kind={`Rule · ${DEONTIC[o.deonticType] ?? o.deonticType}`}
  title={o.label}
  subtitle={o.comment}
  id={obligation.id}
  status={o.reviewStatus}
/>

<div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
  <div class="space-y-4">
    <section class="card">
      <h2 class="!mt-0 text-base">When it applies</h2>
      <p class="text-sm">All of these hold:</p>
      <Refs ids={o.appliesWhen} inline={false} />
      {o.unless.length > 0 && (
        <>
          <p class="mt-3 text-sm">and none of these (exemptions):</p>
          <Refs ids={o.unless} inline={false} />
        </>
      )}
    </section>
    <section class="card">
      <h2 class="!mt-0 text-base">What it requires</h2>
      {o.items.length > 0 && (
        <>
          <p class="text-sm">Disclose{o.disclosure && <> (in the <Refs ids={[o.disclosure]} />)</>}:</p>
          <Refs ids={o.items} inline={false} />
        </>
      )}
      {o.actions.length > 0 && (
        <>
          <p class="mt-3 text-sm">Do:</p>
          <Refs ids={o.actions} inline={false} />
        </>
      )}
    </section>
    {o.cases.length > 0 && (
      <section class="card">
        <h2 class="!mt-0 text-base">Cases</h2>
        <p class="text-sm text-muted-foreground">Decisions of courts and authorities that show this rule at work.</p>
        <CaseList ids={o.cases} />
      </section>
    )}
    <h2>Where it comes from</h2>
    <p class="text-sm text-muted-foreground">
      The provisions this rule is read from, in the words of the law. The rule is our reading of them: a draft until a
      lawyer reviews it.
    </p>
    {
      provisions.map((provision) => (
        <section class="space-y-2">
          <h3 class="text-base font-semibold">
            <a href={`/id/${provision.id}`}>{provision.data.citation}</a>
          </h3>
          {provision.data.quotes.map((quote) => <QuoteBlock quote={quote} />)}
        </section>
      ))
    }
    {penalties.length > 0 && (
      <>
        <h2>Penalties</h2>
        <p class="text-sm text-muted-foreground">The provisions that make a breach an offence or set the fine for it.</p>
        {penalties.map((provision) => (
          <section class="space-y-2">
            <h3 class="text-base font-semibold">
              <a href={`/id/${provision.id}`}>{provision.data.citation}</a>
            </h3>
            {provision.data.quotes.map((quote) => <QuoteBlock quote={quote} />)}
          </section>
        ))}
      </>
    )}
  </div>
  <aside class="space-y-4">
    <dl class="card text-sm">
      <dt>Applies in</dt><dd><Refs ids={[o.appliesIn]} /></dd>
      <dt>Addressed to</dt><dd><Refs ids={o.bearer} /></dd>
      <dt>Established by</dt><dd><Refs ids={o.establishedBy} inline={false} /></dd>
      {o.refines.length > 0 && (<><dt>Spells out</dt><dd><Refs ids={o.refines} inline={false} /></dd></>)}
      {refinedBy.length > 0 && (<><dt>Spelled out by</dt><dd><Refs ids={refinedBy} inline={false} /></dd></>)}
    </dl>
    {national.length > 0 && (
      <section class="card text-sm">
        <h2 class="!mt-0 text-base">National law</h2>
        <p class="text-muted-foreground">The provisions implementing it, by country. The checklist names the one where the business is established.</p>
        <dl>
          {national.map(([jurisdiction, ids]) => (
            <>
              <dt><Refs ids={[jurisdiction]} /></dt>
              <dd><Refs ids={ids} /></dd>
            </>
          ))}
        </dl>
      </section>
    )}
    <p class="card text-sm">
      Try it in the <a href="/en/checklist">checklist</a>, or run <code>uv run legalgraph checklist --fact …</code> in the
      repository.
    </p>
  </aside>
</div>

<div class="mt-6"><MiniGraph focus={obligation.id} /></div>
