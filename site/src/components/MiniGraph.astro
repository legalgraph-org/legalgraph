---
// The resource and its nearest neighbours (at most 24). Click a node to open its page. The
// neighbourhood is worked out at build time and written into the page, so the page fetches nothing
// for it, however large the graph grows.
import { neighbourhood } from "../lib/graph-export";
import { graphPath } from "../lib/links";
import { localeOfPath } from "../lib/routes";

interface Props {
  focus: string;
}

const { focus } = Astro.props;
const view = neighbourhood(focus, 24);
---

{
  view && (
    <section class="card p-0">
      <div class="flex items-center justify-between border-b border-border px-4 py-2 text-sm">
        <span class="text-muted-foreground">Neighbours in the graph · click a node to open it</span>
        <a href={graphPath(focus, localeOfPath(Astro.url.pathname))}>Explore in the full graph →</a>
      </div>
      <div class="mini-graph h-80" data-focus={focus} data-view={JSON.stringify(view)} />
    </section>
  )
}

<script>
  import { GraphData, mountGraph, nodeHref, type GraphEdge, type GraphNode } from "../scripts/graph-view";

  for (const container of document.querySelectorAll<HTMLElement>(".mini-graph")) {
    const focus = container.dataset.focus!;
    const view = JSON.parse(container.dataset.view!) as { ids: string[]; nodes: GraphNode[]; edges: GraphEdge[] };
    const data = new GraphData(view.nodes, view.edges);
    const cy = mountGraph(container, { data, ids: new Set(view.ids), focus, compact: true });
    cy.on("tap", "node", (event) => {
      const node = data.nodes.get(event.target.id());
      if (node && node.id !== focus) window.location.href = nodeHref(node);
    });
  }
</script>
