@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Facts about a business on which obligations depend (lgo:appliesWhen, lgo:unless). Each has the
# yes/no question a checklist asks, or follows from other answers. Where the business is established
# and where it offers its services are asked once, as jurisdictions: the conditions tied to them
# (lgo:establishedIn, lgo:offersIn) and which provision a condition comes from (lgo:basedOn) are
# recorded with the rules in the graph (data/rules/), since they point at the graph's resources.

lgv:Conditions a skos:ConceptScheme ;
    skos:prefLabel "Conditions"@en .

# --- Where the business is ------------------------------------------------------

lgv:EstablishedInGermany a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Established in Germany"@en .

lgv:EstablishedInTheUnion a lgo:Condition .

lgv:EstablishedInTheEea a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Established in the European Economic Area"@en ;
    skos:definition "Established in an EU member state, or in Iceland, Liechtenstein or Norway, where internal-market law such as the e-Commerce Directive applies through the EEA Agreement."@en .

lgv:OffersGoodsOrServicesInTheUnion a lgo:Condition ;
    lgo:holdsWhenAny lgv:OffersGoodsOrServicesInGermany , lgv:OffersGoodsOrServicesInFrance ,
        lgv:OffersGoodsOrServicesInAustria , lgv:OffersGoodsOrServicesInSpain ,
        lgv:OffersGoodsOrServicesInIreland , lgv:OffersGoodsOrServicesInItaly .

lgv:OffersGoodsOrServicesInTheEea a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Offers goods or services in the European Economic Area"@en ;
    lgo:holdsWhenAny lgv:OffersGoodsOrServicesInTheUnion .

lgv:OffersGoodsOrServicesInGermany a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Offers goods or services in Germany"@en .

lgv:OffersGoodsOrServicesInFrance a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Offers goods or services in France"@en .

lgv:OffersGoodsOrServicesInAustria a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Offers goods or services in Austria"@en .

lgv:OffersGoodsOrServicesInSpain a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Offers goods or services in Spain"@en .

lgv:OffersGoodsOrServicesInIreland a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Offers goods or services in Ireland"@en .

lgv:OffersGoodsOrServicesInItaly a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Offers goods or services in Italy"@en .

lgv:SellsToConsumersInAustria a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells to consumers in Austria"@en ;
    lgo:holdsWhenAll lgv:OffersGoodsOrServicesInAustria , lgv:SellsToConsumers .

lgv:SellsToConsumersInSpain a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells to consumers in Spain"@en ;
    lgo:holdsWhenAll lgv:OffersGoodsOrServicesInSpain , lgv:SellsToConsumers .

lgv:SellsToConsumersInIreland a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells to consumers in Ireland"@en ;
    lgo:holdsWhenAll lgv:OffersGoodsOrServicesInIreland , lgv:SellsToConsumers .

lgv:SellsToConsumersInItaly a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells to consumers in Italy"@en ;
    lgo:holdsWhenAll lgv:OffersGoodsOrServicesInItaly , lgv:SellsToConsumers .

lgv:SellsToConsumersInTheEea a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells to consumers in the EEA"@en ;
    skos:definition "Deals with consumers in a country of the EEA: a consumer contract is governed by the law of the consumer's country when the business directs its activities there (Article 6 Rome I), wherever the business is established."@en ;
    lgo:holdsWhenAll lgv:OffersGoodsOrServicesInTheEea , lgv:SellsToConsumers ;
    lgo:holdsWhenAny lgv:SellsToConsumersInGermany , lgv:SellsToConsumersInFrance , lgv:SellsToConsumersInAustria , lgv:SellsToConsumersInSpain , lgv:SellsToConsumersInIreland , lgv:SellsToConsumersInItaly .

lgv:SellsToConsumersInGermany a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells to consumers in Germany"@en ;
    lgo:holdsWhenAll lgv:OffersGoodsOrServicesInGermany , lgv:SellsToConsumers .

lgv:SellsToConsumersInFrance a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells to consumers in France"@en ;
    lgo:holdsWhenAll lgv:OffersGoodsOrServicesInFrance , lgv:SellsToConsumers .

lgv:TdddgApplies a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "The German TDDDG applies"@en ;
    skos:definition "Established in Germany, or providing services there: § 1(3) TDDDG makes the German cookie rule apply to both."@en ;
    lgo:holdsWhenAny lgv:EstablishedInGermany , lgv:OffersGoodsOrServicesInGermany .

lgv:CompetesOnTheGermanMarket a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Competes for customers in Germany"@en ;
    skos:definition "Offers goods or services to people in Germany. Unfair-competition rules (price display, reviews, advertising email) follow the market where competitors meet and consumers' interests are affected (Article 6(1) Rome II), wherever the business is established."@en ;
    lgo:holdsWhenAny lgv:OffersGoodsOrServicesInGermany .

lgv:BfsgApplies a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "The German Accessibility Act (BFSG) applies"@en ;
    skos:definition "Provides services to consumers in Germany: the BFSG covers the listed services provided to consumers (§ 1(3) BFSG, Article 2(2) European Accessibility Act), wherever the provider is established."@en ;
    lgo:holdsWhenAll lgv:OffersGoodsOrServicesInGermany , lgv:SellsToConsumers .

lgv:ActiveInTheEea a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Established in or offering services in the EEA"@en ;
    lgo:holdsWhenAny lgv:EstablishedInTheEea , lgv:OffersGoodsOrServicesInTheEea , lgv:TdddgApplies .

lgv:MonitorsBehaviourInTheUnion a lgo:Condition ;
    lgo:question "Does the business track or profile the online behaviour of people in the EU?"@en .

lgv:GdprTerritorialScope a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Within the GDPR's territorial scope"@en ;
    skos:definition "Established in the EU, or outside it but offering goods or services to, or monitoring, people in the EU (Article 3 GDPR)."@en ;
    lgo:holdsWhenAny lgv:EstablishedInTheUnion , lgv:OffersGoodsOrServicesInTheUnion , lgv:MonitorsBehaviourInTheUnion .

# --- What the website is --------------------------------------------------------

lgv:CommercialDigitalService a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Commercial digital service"@en ;
    skos:definition "A website or app offered in a business-like way, usually for payment: selling, advertising, affiliate links or promoting a business all count."@en ;
    lgo:question "Does the website serve business purposes (selling, advertising, affiliate links, promoting a business)?"@en .

lgv:InfluencesPublicOpinion a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Content that can influence public opinion"@en ;
    skos:definition "Content beyond the owner's personal life or self-presentation that can influence public opinion: news, commentary, a blog on public topics. Austrian media law asks such media for the full disclosure; others give only name, business purpose and residence or seat (§ 25 Abs. 5 MedienG)."@en ;
    lgo:question "Does the website go beyond presenting yourself or your business, with content that can influence public opinion, such as news, commentary or a blog on public topics?"@en .

lgv:NonPrivateTelemedia a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Website not purely personal or family"@en ;
    lgo:holdsWhenAny lgv:CommercialDigitalService ;
    lgo:question "Is the website more than purely personal or family use?"@en .

lgv:JournalisticEditorialContent a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Journalistic or editorial content"@en ;
    skos:definition "Content that reproduces printed periodicals or takes part in forming public opinion, such as a regularly updated blog or magazine."@en ;
    lgo:question "Does the website publish journalistic or editorial content, such as a blog or news?"@en .

lgv:AudiovisualMediaService a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Audiovisual media service"@en ;
    lgo:question "Does the business provide an audiovisual media service (video on demand under editorial responsibility)?"@en .

# --- What the business is ------------------------------------------------------

lgv:LegalPerson a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Legal person"@en ;
    lgo:question "Is the business a legal person or partnership with legal capacity (GmbH, UG, AG, e.V., OHG, KG)?"@en .

lgv:RegisteredInPublicRegister a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Entered in a public register"@en ;
    lgo:question "Is the business entered in a commercial, partnership, cooperative or association register?"@en .

lgv:ActivityRequiresAuthorisation a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Activity requires official authorisation"@en ;
    lgo:question "Does the activity need an official licence or authorisation?"@en .

lgv:RegulatedProfession a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Regulated profession"@en ;
    lgo:question "Is the service provided in a regulated profession (lawyer, doctor, architect, tax adviser…)?"@en .

lgv:HasVatId a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Has a VAT identification number"@en ;
    lgo:question "Does the business have a VAT identification number?"@en .

lgv:HasEconomicIdNumber a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Has an economic identification number"@en ;
    lgo:question "Does the business have a German economic identification number (Wirtschafts-Identifikationsnummer)?"@en .

lgv:InLiquidation a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Company in liquidation"@en ;
    lgo:question "Is the company (AG, KGaA or GmbH) being wound up or in liquidation?"@en .

lgv:SellsToConsumers a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Deals with consumers"@en ;
    lgo:question "Does the business sell to or contract with consumers (B2C) through the website or its terms?"@en .

lgv:TenOrFewerEmployees a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Ten or fewer employees"@en ;
    lgo:question "Did the business employ ten people or fewer on 31 December of last year?"@en .

lgv:TakesPartInConsumerDisputeResolution a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Takes part in consumer dispute resolution"@en ;
    lgo:question "Has the business agreed, or is it obliged, to take part in proceedings before a consumer arbitration board?"@en .

# --- Personal data -------------------------------------------------------------

lgv:ProcessesPersonalData a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Processes personal data"@en ;
    skos:definition "Almost every website does: server logs with IP addresses, contact forms, accounts, newsletters, analytics."@en ;
    lgo:question "Does the website process personal data (IP addresses in logs, forms, accounts, analytics)?"@en .

lgv:GdprApplies a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "The GDPR applies"@en ;
    lgo:holdsWhenAll lgv:ProcessesPersonalData , lgv:GdprTerritorialScope .

lgv:CollectsDataFromDataSubjects a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Collects data from the people themselves"@en ;
    lgo:holdsWhenAny lgv:ProcessesPersonalData ;
    lgo:question "Does the website collect personal data from the people it concerns (forms, logs, cookies)?"@en .

lgv:ObtainsDataFromOtherSources a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Obtains personal data from other sources"@en ;
    lgo:question "Does the business obtain personal data from other sources (bought lists, partners, public sources)?"@en .

lgv:ReliesOnConsent a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Relies on consent"@en ;
    lgo:holdsWhenAny lgv:NonEssentialDeviceAccess ;
    lgo:question "Does any processing rely on consent (newsletter, analytics, marketing cookies)?"@en .

lgv:ReliesOnLegitimateInterests a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Relies on legitimate interests"@en ;
    lgo:question "Does any processing rely on legitimate interests (security logs, fraud prevention, direct marketing to customers)?"@en .

lgv:TransfersOutsideEEA a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Transfers data outside the EEA"@en ;
    lgo:question "Is personal data transferred outside the EU/EEA, for example to US-based analytics, hosting or email providers?"@en .

lgv:ProcessesSpecialCategories a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Processes special categories of personal data"@en ;
    lgo:question "Does the business process health, biometric, genetic, religious, political or other special categories of personal data?"@en .

lgv:HighRiskProcessing a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Processing likely to result in a high risk"@en ;
    lgo:question "Is any processing likely to result in a high risk to people's rights and freedoms: systematic profiling with significant effects, large-scale special categories, large-scale monitoring of public areas, or an activity on the supervisory authority's DPIA list?"@en .

lgv:UnmitigatedHighRisk a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "High risk the controller cannot mitigate"@en ;
    lgo:question "Has an impact assessment shown a high risk that the business's own measures cannot reduce?"@en .

lgv:UsesAutomatedDecisionMaking a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Uses automated decision-making"@en ;
    lgo:question "Are decisions with legal or similarly significant effects made solely by automated means, including profiling?"@en .

lgv:VoluntaryDataProtectionOfficer a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Has designated a data protection officer voluntarily"@en ;
    lgo:question "Has the business designated a data protection officer although not required to?"@en .

lgv:PublicAuthorityProcessing a lgo:Condition ;
    lgo:question "Is the business a public authority or body?"@en .

lgv:LargeScaleMonitoring a lgo:Condition ;
    lgo:question "Is large-scale, regular and systematic monitoring of people a core activity (e.g. tracking-based advertising as a business)?"@en .

lgv:LargeScaleSpecialCategories a lgo:Condition ;
    lgo:question "Is large-scale processing of health, religious or other special categories of data a core activity?"@en .

lgv:TwentyOrMoreProcessPersonalData a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "At least 20 people regularly process personal data"@en ;
    lgo:question "Do at least 20 people regularly work with personal data by automated means (email, CRM, accounting)?"@en .

lgv:ImpactAssessmentOrDataTrading a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "High-risk processing or data trading"@en ;
    lgo:question "Does the business carry out processing that needs a data protection impact assessment, or process personal data commercially for transfer or market research?"@en .

lgv:DataProtectionOfficerRequiredByGdpr a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Data protection officer required by the GDPR"@en ;
    lgo:holdsWhenAny lgv:PublicAuthorityProcessing , lgv:LargeScaleMonitoring , lgv:LargeScaleSpecialCategories .

lgv:DataProtectionOfficerRequiredInGermany a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Data protection officer required by German law"@en ;
    lgo:holdsWhenAny lgv:TwentyOrMoreProcessPersonalData , lgv:ImpactAssessmentOrDataTrading .

lgv:HasDataProtectionOfficer a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Has a data protection officer"@en ;
    lgo:holdsWhenAny lgv:VoluntaryDataProtectionOfficer , lgv:DataProtectionOfficerRequiredByGdpr , lgv:DataProtectionOfficerRequiredInGermany .

# --- Cookies and marketing -----------------------------------------------------

lgv:AccessesTerminalEquipment a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Stores or reads information on users' devices"@en ;
    lgo:holdsWhenAny lgv:NonEssentialDeviceAccess ;
    lgo:question "Does the website set cookies or use local storage, tracking pixels, fingerprinting or similar?"@en .

lgv:NonEssentialDeviceAccess a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Uses cookies or similar that are not strictly necessary"@en ;
    lgo:question "Are any of them not strictly necessary for a service the user asked for (analytics, advertising, embedded videos, social plugins)?"@en .

lgv:SendsMarketingEmails a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sends advertising by email"@en ;
    lgo:question "Does the business send advertising or newsletters by email?"@en .

lgv:EmailsOnlyExistingCustomers a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Emails only existing customers about similar products"@en ;
    lgo:question "Are advertising emails sent only to customers who bought from the business, about its own similar products, without their objection?"@en .

# --- Selling online, accessibility, platforms, AI ----------------------------------

lgv:SellsOnlineToConsumers a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Concludes contracts with consumers online"@en ;
    lgo:question "Can consumers buy or subscribe directly on the website or app (online shop, booking, subscription)?"@en .

lgv:ShowsPricesToConsumers a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Shows prices to consumers"@en ;
    lgo:holdsWhenAny lgv:SellsOnlineToConsumers ;
    lgo:question "Does the website show prices of goods or services to consumers?"@en .

lgv:SellsGoodsByQuantity a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells goods by weight, volume, length or area"@en ;
    lgo:question "Are goods sold by weight, volume, length or area (food, cosmetics, fabric…)?"@en .

lgv:Microenterprise a lgo:Condition , lgo:LegalConcept ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Microenterprise"@en ;
    lgo:question "Does the business employ fewer than 10 people with an annual turnover or balance sheet of at most EUR 2 million?"@en .

lgv:ProvidesIntermediaryService a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Provides an intermediary service"@en ;
    lgo:holdsWhenAny lgv:OperatesOnlinePlatform ;
    lgo:question "Does the service host or transmit content provided by users (comments, uploads, listings, forums)?"@en .

lgv:OperatesOnlinePlatform a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Operates an online platform"@en ;
    lgo:holdsWhenAny lgv:OperatesMarketplace ;
    lgo:question "Does the service publish users' content to the public (social network, marketplace, review or video platform)?"@en .

lgv:ShowsAdvertisementsOnPlatform a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Shows advertisements on its platform"@en ;
    lgo:question "Does the platform show advertisements to its users?"@en .

lgv:OperatesMarketplace a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Operates a marketplace"@en ;
    lgo:question "Can third-party traders sell to consumers on the platform (a marketplace)?"@en .

lgv:SmallPlatformExempt a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Micro or small enterprise (platform rules)"@en ;
    lgo:question "Is the platform operated by a micro or small enterprise (fewer than 50 people, at most EUR 10 million turnover) that is not a very large platform?"@en .

lgv:ActiveInTheUnion a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Established in or offering services in the EU"@en ;
    lgo:holdsWhenAny lgv:EstablishedInTheUnion , lgv:OffersGoodsOrServicesInTheUnion .

lgv:UsesChatbot a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Lets people interact with an AI system"@en ;
    lgo:question "Does the website or app offer a chatbot or other AI system people interact with directly?"@en .

lgv:PublishesAiGeneratedMedia a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Publishes AI-generated media or public-interest text"@en ;
    lgo:question "Does the business publish AI-generated or manipulated images, audio or video that look real (deep fakes), or AI-generated text informing the public on matters of public interest?"@en .

# --- United Kingdom and United States ----------------------------------------------

lgv:EstablishedInTheUnitedKingdom a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Established in the United Kingdom"@en .

lgv:UkCompany a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "A company registered in the UK"@en ;
    lgo:question "Is the business a company registered at Companies House (Ltd, plc, LLP)?"@en .

lgv:LimitedLiabilityCompany a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "A limited-liability company"@en ;
    lgo:question "Is the business a limited-liability company (GmbH, AG, SA, SARL, BV, Srl, OÜ, s.r.o., Kft or similar)?"@en .

lgv:StatesShareCapital a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "States share capital"@en ;
    lgo:question "Does the company state its capital on letters, order forms or the website?"@en .

lgv:CcpaBusiness a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "A business under the CCPA"@en ;
    lgo:question "Does the business do business in California and meet a CCPA threshold (revenue above about USD 26.6 million, or personal information of 100,000+ Californians, or half its revenue from selling or sharing it)?"@en .

lgv:SellsOrSharesPersonalData a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells or shares personal information"@en ;
    lgo:question "Does the business sell personal information, or share it for cross-context behavioural advertising (e.g. third-party advertising pixels)?"@en .

lgv:PlaceOfPublicAccommodation a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "A place of public accommodation in the US"@en ;
    lgo:question "Is the business open to the public in the US (shop, restaurant, hotel, service provider), or does it sell to the US public online?"@en .

lgv:SendsCommercialEmailInTheUs a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sends commercial email to US recipients"@en ;
    lgo:question "Does the business send commercial emails to recipients in the US?"@en .

# --- Switzerland --------------------------------------------------------------------

lgv:EstablishedInSwitzerland a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Established in Switzerland"@en .

lgv:EffectsInSwitzerland lgo:holdsWhenAny lgv:EstablishedInSwitzerland .

lgv:OffersGoodsOrServicesInSwitzerland a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Offers goods or services in Switzerland"@en .

lgv:CompetesOnTheSwissMarket a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Competes for customers in Switzerland"@en ;
    skos:definition "Offers goods or services to people in Switzerland. Unfair-competition rules such as UWG Art. 3 follow the market where competitors meet and consumers' interests are affected, wherever the business is established."@en ;
    lgo:holdsWhenAny lgv:OffersGoodsOrServicesInSwitzerland .

lgv:TransfersOutsideSwitzerland a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Discloses personal data abroad (from Switzerland)"@en ;
    lgo:question "Is personal data of people in Switzerland disclosed abroad, for example to cloud, analytics or email providers outside Switzerland?"@en .

lgv:RegularHighRiskProcessingOfSwissResidents a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Regular, extensive, high-risk processing of data of people in Switzerland"@en ;
    lgo:question "Does the business, from abroad, regularly and extensively process data of people in Switzerland in connection with offering them goods or services or monitoring their behaviour, with a high risk to their personality?"@en .

lgv:HonoursOptOutPreferenceSignal a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Honours opt-out preference signals (Global Privacy Control)"@en ;
    lgo:question "Does the website honour opt-out preference signals such as Global Privacy Control as the CCPA regulations specify, instead of showing opt-out links?"@en .

lgv:UsesSensitiveDataForOtherPurposes a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Uses sensitive personal information beyond what the CCPA allows without notice"@en ;
    lgo:question "Does the business use or disclose sensitive personal information (precise location, health, account log-ins…) for purposes beyond providing the goods or services the consumer requested?"@en .

lgv:LikelyAccessedByChildren a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Likely to be accessed by children"@en ;
    lgo:question "Is the service likely to be accessed by children (under 18)?"@en .

lgv:PublishesConsumerReviews a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Publishes consumer reviews"@en ;
    lgo:question "Does the website publish customer reviews or ratings?"@en .

lgv:UkGdprApplies a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "The UK GDPR applies"@en ;
    lgo:holdsWhenAll lgv:ProcessesPersonalData , lgv:UkGdprTerritorialScope .

lgv:UkGdprTerritorialScope a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Within the UK GDPR's territorial scope"@en ;
    lgo:holdsWhenAny lgv:EstablishedInTheUnitedKingdom , lgv:OffersGoodsOrServicesInTheUk , lgv:MonitorsBehaviourInTheUk .

lgv:SellsToUkConsumers a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells to consumers in the UK online"@en ;
    lgo:question "Does the business sell online to consumers in the UK?"@en ;
    lgo:holdsWhenAll lgv:OffersGoodsOrServicesInTheUk , lgv:SellsToConsumers .

lgv:AnnouncesPriceReductions a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Announces price reductions"@en ;
    lgo:question "Does the website announce price reductions (sales, “was/now” prices, discounts)?"@en .

lgv:SellsProductsOnline a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells physical consumer products online"@en ;
    lgo:question "Does the website offer physical consumer products (not only services or digital content)?"@en .

lgv:SellsEnergyLabelledProducts a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Sells energy-labelled products"@en ;
    lgo:question "Does the website sell products that carry an EU energy label (appliances, lamps, TVs, tyres…)?"@en .

lgv:PublishesPoliticalAdvertising a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Publishes political advertising"@en ;
    lgo:question "Does the website publish paid political advertising?"@en .

lgv:YouthImpairingContent a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Offers content that can impair minors"@en ;
    lgo:question "Does the website offer content not suitable for all ages (e.g. violence, sexual content, gambling-like mechanics), or that is harmful to minors?"@en .

lgv:SmallTelemediaWithSelfRegulation a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Small provider in a self-regulation body"@en ;
    lgo:question "Does the provider have fewer than 50 employees or fewer than 10 million monthly visits, and has it joined a self-regulation body (e.g. FSM) that acts as its youth protection officer?"@en .

lgv:ProducesElectricalEquipment a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Producer of electrical or electronic equipment in Germany"@en ;
    lgo:question "Does the business place electrical or electronic devices on the German market as producer (own brand, or first importer, or selling from abroad directly to German customers)?"@en .

lgv:LargeElectricalSeller a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Seller obliged to take back old devices"@en ;
    lgo:question "Does the business sell electrical devices with at least 400 m² of storage and dispatch area for them (or 800 m² total for food retailers), or sell e-cigarettes?"@en .

lgv:PlacesPackagingOnMarket a lgo:Condition ;
    skos:inScheme lgv:Conditions ;
    skos:prefLabel "Places packaging on the German market"@en ;
    lgo:question "Does the business ship goods in packaging to customers in Germany (including shipping boxes and filling material)?"@en .

