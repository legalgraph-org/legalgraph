@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lgs:  <https://legalgraph.org/shapes#> .
@prefix eli:  <http://data.europa.eu/eli/ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# SHACL shapes every graph built on this ontology must conform to.

lgs:JurisdictionShape a sh:NodeShape ;
    sh:targetClass lgo:Country , lgo:SupranationalOrganisation , lgo:Subdivision ;
    sh:property [
        sh:path lgo:isoCode ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^([A-Z]{2}|[A-Z]{2}-[A-Z0-9]{1,3}|EU|EEA)$" ;
        sh:message "A jurisdiction needs exactly one ISO code (ISO 3166-1 or 3166-2, or EU / EEA)." ;
    ] , [
        sh:path rdfs:label ;
        sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A jurisdiction needs an English rdfs:label." ;
    ] , [
        sh:path lgo:memberOf ;
        sh:class lgo:SupranationalOrganisation ;
    ] .

lgs:LegalActShape a sh:NodeShape ;
    sh:targetClass lgo:LegalAct ;
    sh:property [
        sh:path lgo:jurisdiction ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class lgo:Jurisdiction ;
        sh:message "A legal act needs exactly one jurisdiction." ;
    ] , [
        sh:path eli:title ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "A legal act needs a language-tagged eli:title." ;
    ] , [
        sh:path lgo:actType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( lgv:Directive lgv:Regulation lgv:Statute lgv:Code lgv:Decree lgv:Ordinance lgv:StatutoryInstrument lgv:StateTreaty lgv:Proposal lgv:Decision ) ;
        sh:message "lgo:actType must be a concept of the act-type scheme (vocab/act-types.ttl)." ;
    ] , [
        sh:path lgo:sourceUrl ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:message "A legal act needs a source URL (xsd:anyURI)." ;
    ] , [
        sh:path lgo:reviewStatus ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( lgv:SourceChecked lgv:Draft ) ;
    ] , [
        sh:path eli:date_document ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] , [
        sh:path eli:first_date_entry_in_force ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] , [
        sh:path eli:date_no_longer_in_force ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] , [
        sh:path eli:transposes ;
        sh:class lgo:LegalAct ;
    ] , [
        sh:path lgo:amendmentCheck ;
        sh:maxCount 1 ;
        sh:class lgo:AmendmentCheck ;
        sh:message "A legal act has at most one amendment check, its latest." ;
    ] .

lgs:DecisionShape a sh:NodeShape ;
    sh:targetClass lgo:CourtDecision , lgo:Guidance , lgo:AuthorityDecision ;
    sh:property [
        sh:path lgo:jurisdiction ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class lgo:Jurisdiction ;
    ] , [
        sh:path eli:title ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
    ] , [
        sh:path lgo:actType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( lgv:Judgment lgv:Guidelines lgv:AuthorityDecision ) ;
    ] , [
        sh:path lgo:sourceUrl ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI ;
    ] .

lgs:CourtDecisionShape a sh:NodeShape ;
    sh:targetClass lgo:CourtDecision ;
    sh:property [
        sh:path lgo:ecli ;
        sh:maxCount 1 ;
        sh:pattern "^ECLI:[A-Z]{2}:[A-Z0-9]+:[0-9]{4}:[A-Za-z0-9.]+$" ;
        sh:message "An ECLI, where the court publishes one, is a European Case Law Identifier. (Courts outside the EU, and some German courts' published decisions, have none.)" ;
    ] .

lgs:ProvisionShape a sh:NodeShape ;
    sh:targetClass lgo:Provision ;
    sh:property [
        sh:path eli:is_part_of ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class lgo:LegalDocument ;
        sh:message "A provision is part of exactly one legal act, court decision or guidance document." ;
    ] , [
        sh:path lgo:citation ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] , [
        sh:path lgo:enforces ;
        sh:class lgo:DisclosureType ;
    ] , [
        sh:path lgo:regulates ;
        sh:or ( [ sh:class lgo:DisclosureType ] [ sh:class lgo:LegalConcept ] ) ;
        sh:message "lgo:regulates points to a disclosure type or a legal concept." ;
    ] , [
        sh:path lgo:defines ;
        sh:or ( [ sh:class lgo:InformationItem ] [ sh:class lgo:LegalConcept ] ) ;
        sh:message "lgo:defines points to an information item or a legal concept." ;
    ] , [
        sh:path lgo:authorises ;
        sh:class lgo:LegalAct ;
    ] , [
        sh:path lgo:requiresDisclosureOf ;
        sh:class lgo:InformationItem ;
    ] , [
        sh:path lgo:explains ;
        sh:class lgo:LegalConcept ;
    ] , [
        sh:path lgo:interprets ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:specifies ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:takesPrecedenceOver ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:refersTo ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:applies ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:penalises ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:continues ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:readUnder ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:implements ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:reviewStatus ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( lgv:SourceChecked lgv:Draft ) ;
    ] ;
    sh:or (
        [ sh:path lgo:regulates ; sh:minCount 1 ]
        [ sh:path lgo:enforces ; sh:minCount 1 ]
        [ sh:path lgo:defines ; sh:minCount 1 ]
        [ sh:path lgo:authorises ; sh:minCount 1 ]
        [ sh:path lgo:explains ; sh:minCount 1 ]
        [ sh:path lgo:interprets ; sh:minCount 1 ]
        [ sh:path lgo:specifies ; sh:minCount 1 ]
        [ sh:path lgo:applies ; sh:minCount 1 ]
        [ sh:path lgo:penalises ; sh:minCount 1 ]
        [ sh:path [ sh:inversePath lgo:continues ] ; sh:minCount 1 ]
    ) ;
    sh:sparql [
        sh:message "A provision marked SourceChecked needs at least one quote." ;
        sh:select """
            PREFIX lgo: <https://legalgraph.org/ontology#>
            PREFIX lgv: <https://legalgraph.org/vocab/>
            SELECT $this WHERE {
                $this lgo:reviewStatus lgv:SourceChecked .
                FILTER NOT EXISTS { ?quote lgo:quoteOf $this }
            }
        """ ;
    ] .

lgs:QuoteShape a sh:NodeShape ;
    sh:targetClass lgo:Quote ;
    sh:property [
        sh:path lgo:quoteOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:text ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:minLength 20 ;
        sh:message "A quote needs exactly one language-tagged text." ;
    ] , [
        sh:path lgo:sourceUrl ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:message "A quote needs the URL it was taken from." ;
    ] , [
        sh:path lgo:retrievedOn ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] , [
        sh:path lgo:officialLanguageVersion ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] .

lgs:TranslationShape a sh:NodeShape ;
    sh:targetClass lgo:Translation ;
    sh:property [
        sh:path lgo:translationOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path lgo:translatedProperty ;
        sh:maxCount 1 ;
    ] , [
        sh:path lgo:text ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" ) ;
        sh:message "A translation needs exactly one @en text." ;
    ] , [
        sh:path lgo:translationMethod ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( lgv:MachineTranslation lgv:HumanTranslation lgv:OfficialTranslation ) ;
    ] , [
        sh:path lgo:translatedBy ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] , [
        sh:path lgo:translatedOn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] , [
        sh:path lgo:sourceTextSha256 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{64}$" ;
    ] , [
        sh:path lgo:reviewStatus ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( lgv:Draft lgv:Reviewed ) ;
    ] ;
    sh:sparql [
        sh:message "A Reviewed translation needs lgo:reviewedBy." ;
        sh:select """
            PREFIX lgo: <https://legalgraph.org/ontology#>
            PREFIX lgv: <https://legalgraph.org/vocab/>
            SELECT $this WHERE {
                $this lgo:reviewStatus lgv:Reviewed .
                FILTER NOT EXISTS { $this lgo:reviewedBy ?reviewer }
            }
        """ ;
    ] .

lgs:SourceDocumentShape a sh:NodeShape ;
    sh:targetClass lgo:SourceDocument ;
    sh:property [
        sh:path lgo:repositoryPath ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] , [
        sh:path lgo:sha256 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{64}$" ;
    ] , [
        sh:path lgo:sourceUrl ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI ;
    ] , [
        sh:path lgo:retrievedOn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] .

lgs:ObligationShape a sh:NodeShape ;
    sh:targetClass lgo:Obligation ;
    sh:property [
        sh:path rdfs:label ;
        sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An obligation needs an English rdfs:label." ;
    ] , [
        sh:path lgo:establishedBy ;
        sh:minCount 1 ;
        sh:class lgo:Provision ;
        sh:message "An obligation names the provision(s) it comes from." ;
    ] , [
        sh:path lgo:bearer ;
        sh:minCount 1 ;
        sh:class lgo:ActorRole ;
    ] , [
        sh:path lgo:deonticType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( lgv:Must lgv:MustNot lgv:May ) ;
    ] , [
        sh:path lgo:appliesIn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class lgo:Jurisdiction ;
    ] , [
        sh:path lgo:appliesWhen ;
        sh:minCount 1 ;
        sh:class lgo:Condition ;
    ] , [
        sh:path lgo:unless ;
        sh:class lgo:Condition ;
    ] , [
        sh:path lgo:partOfDisclosure ;
        sh:maxCount 1 ;
        sh:class lgo:DisclosureType ;
    ] , [
        sh:path lgo:requiresAction ;
        sh:class lgo:Action ;
    ] , [
        sh:path lgo:refines ;
        sh:class lgo:Obligation ;
    ] , [
        sh:path lgo:reviewStatus ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( lgv:Draft lgv:Reviewed ) ;
    ] ;
    sh:or (
        [ sh:path lgo:requiresDisclosureOf ; sh:minCount 1 ]
        [ sh:path lgo:requiresAction ; sh:minCount 1 ]
    ) .

lgs:ConditionShape a sh:NodeShape ;
    sh:targetClass lgo:Condition ;
    sh:property [
        sh:path lgo:basedOn ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:holdsWhenAny ;
        sh:class lgo:Condition ;
    ] , [
        sh:path lgo:holdsWhenAll ;
        sh:class lgo:Condition ;
    ] , [
        sh:path lgo:establishedIn ;
        sh:maxCount 1 ;
        sh:class lgo:Jurisdiction ;
    ] , [
        sh:path lgo:offersIn ;
        sh:maxCount 1 ;
        sh:class lgo:Jurisdiction ;
    ] , [
        sh:path lgo:question ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
    ] .

# --- Cases and enforcement ---------------------------------------------------

lgs:CaseLinksShape a sh:NodeShape ;
    sh:targetSubjectsOf lgo:hasOutcome , lgo:illustrates , lgo:follows ;
    sh:or ( [ sh:class lgo:CourtDecision ] [ sh:class lgo:AuthorityDecision ] ) ;
    sh:message "Only court and authority decisions have outcomes, illustrate rules or follow other decisions." ;
    sh:property [
        sh:path lgo:hasOutcome ;
        sh:class lgo:Outcome ;
    ] , [
        sh:path lgo:illustrates ;
        sh:class lgo:Obligation ;
    ] , [
        sh:path lgo:follows ;
        sh:or ( [ sh:class lgo:CourtDecision ] [ sh:class lgo:AuthorityDecision ] ) ;
    ] , [
        sh:path lgo:caseNumber ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

lgs:OutcomeShape a sh:NodeShape ;
    sh:targetClass lgo:Outcome ;
    sh:property [
        sh:path lgo:outcomeType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( lgv:Fine lgv:Damages lgv:Injunction lgv:ComplianceOrder lgv:Settlement lgv:FindingOfInfringement ) ;
    ] , [
        sh:path lgo:against ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] , [
        sh:path lgo:amount ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
    ] , [
        sh:path lgo:currency ;
        sh:maxCount 1 ;
        sh:pattern "^[A-Z]{3}$" ;
    ] , [
        sh:path lgo:statedIn ;
        sh:minCount 1 ;
        sh:class lgo:Provision ;
        sh:message "An outcome names the point of the decision that states it, so it can be checked against the quoted words." ;
    ] , [
        sh:path lgo:forBreachOf ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:sanctionedUnder ;
        sh:class lgo:Provision ;
    ] , [
        sh:path lgo:reviewStatus ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( lgv:SourceChecked lgv:Draft ) ;
    ] ;
    sh:sparql [
        sh:message "An amount needs a currency." ;
        sh:select """
            PREFIX lgo: <https://legalgraph.org/ontology#>
            SELECT $this WHERE { $this lgo:amount ?a . FILTER NOT EXISTS { $this lgo:currency ?c } }
        """ ;
    ] , [
        sh:message "An outcome is stated in a point of the decision that has it." ;
        sh:select """
            PREFIX lgo: <https://legalgraph.org/ontology#>
            PREFIX eli: <http://data.europa.eu/eli/ontology#>
            SELECT $this WHERE {
                ?decision lgo:hasOutcome $this .
                $this lgo:statedIn ?point .
                FILTER NOT EXISTS { ?point eli:is_part_of ?decision }
            }
        """ ;
    ] .

lgs:ReadUnderShape a sh:NodeShape ;
    sh:targetSubjectsOf lgo:readUnder ;
    sh:sparql [
        sh:message "A point read under a repealed provision interprets the provision that continues it." ;
        sh:select """
            PREFIX lgo: <https://legalgraph.org/ontology#>
            SELECT $this WHERE {
                $this lgo:readUnder ?old .
                FILTER NOT EXISTS { $this lgo:interprets ?new . ?new lgo:continues ?old }
            }
        """ ;
    ] .

lgs:LicencedSourceShape a sh:NodeShape ;
    sh:targetClass lgo:SourceDocument ;
    sh:property [
        sh:path lgo:licence ;
        sh:maxCount 1 ;
        sh:in ( lgv:PublicDomain lgv:OfficialWork lgv:LicenceOuverte2 lgv:OpenGovernmentLicence3 lgv:ReuseWithAttribution ) ;
    ] , [
        sh:path lgo:licenceBasis ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

lgs:ExternalReferenceShape a sh:NodeShape ;
    sh:targetClass lgo:ExternalReference ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path dcterms:publisher ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] , [
        sh:path lgo:sourceUrl ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
    ] , [
        sh:path lgo:linkOnlyReason ;
        sh:minCount 1 ;
    ] , [
        sh:path lgo:excerpt ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "At most one short excerpt of someone else's work." ;
    ] , [
        sh:path lgo:supports ;
        sh:minCount 1 ;
    ] ;
    sh:sparql [
        sh:message "An excerpt of someone else's work stays short: at most 300 characters, with its locator." ;
        sh:select """
            PREFIX lgo: <https://legalgraph.org/ontology#>
            SELECT $this WHERE {
                $this lgo:excerpt ?e .
                FILTER (STRLEN(?e) > 300 || NOT EXISTS { $this lgo:excerptLocator ?l })
            }
        """ ;
    ] .

lgs:AmendmentCheckShape a sh:NodeShape ;
    sh:targetClass lgo:AmendmentCheck ;
    sh:property [
        sh:path [ sh:inversePath lgo:amendmentCheck ] ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An amendment check belongs to exactly one legal act." ;
    ] , [
        sh:path lgo:checkedOn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "An amendment check needs the day it was made (lgo:checkedOn)." ;
    ] , [
        sh:path lgo:sourceUrl ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:message "An amendment check needs the official source it was made against (lgo:sourceUrl)." ;
    ] , [
        sh:path lgo:lastKnownAmendment ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] , [
        sh:path lgo:lastKnownAmendmentDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] , [
        sh:path lgo:lastKnownAmendmentInForce ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
    ] , [
        sh:path lgo:lastKnownAmendingAct ;
        sh:maxCount 1 ;
        sh:class lgo:LegalAct ;
    ] , [
        sh:path lgo:sourceIsCurrent ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] ;
    sh:sparql [
        sh:message "An amendment check that names an amendment needs its date (lgo:lastKnownAmendmentDate), and one that dates it needs its citation." ;
        sh:select """
            PREFIX lgo: <https://legalgraph.org/ontology#>
            SELECT $this WHERE {
                { $this lgo:lastKnownAmendment ?a . FILTER NOT EXISTS { $this lgo:lastKnownAmendmentDate ?d } }
                UNION
                { $this lgo:lastKnownAmendmentDate ?d . FILTER NOT EXISTS { $this lgo:lastKnownAmendment ?a } }
            }
        """ ;
    ] .
