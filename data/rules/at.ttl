@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:  <https://legalgraph.org/id/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Austria: cookie consent under § 165(3) TKG 2021, the transposition of ePrivacy art. 5(3).

lg:AT-R-cookie-consent a lgo:Obligation ;
    rdfs:label "Consent before cookies and similar technologies that are not strictly necessary"@en ;
    rdfs:comment "Austria's transposition covers the confidentiality of communications data stored or accessed on the user's device; the same two ePrivacy exceptions apply (transmission and strict necessity)."@en ;
    lgo:refines lg:EU-R-cookie-consent ;
    lgo:establishedBy lg:AT-TKG-2021-s165-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:MustNot ;
    lgo:appliesIn lg:AT ;
    lgo:appliesWhen lgv:EstablishedInAustria , lgv:NonEssentialDeviceAccess ;
    lgo:requiresAction lgv:ObtainConsentBeforeDeviceAccess ;
    lgo:reviewStatus lgv:Draft .

# --- Pre-contractual information for distance contracts (§ 4 Abs. 1 FAGG) -------------------

lg:AT-R-pre-contract-information a lgo:Obligation ;
    rdfs:label "Pre-contractual information for online sales to consumers"@en ;
    rdfs:comment "Items marked “where applicable” in the law depend on the product; the checklist lists them all for the trader to check. § 4 Abs. 1 FAGG is Austria's transposition of Article 6(1) of the Consumer Rights Directive, the phone number included."@en ;
    lgo:refines lg:EU-R-pre-contract-information ;
    lgo:establishedBy lg:AT-FAGG-s4-1 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:AT ;
    lgo:appliesWhen lgv:SellsToConsumersInAustria , lgv:SellsOnlineToConsumers ;
    lgo:partOfDisclosure lgv:PreContractInformation ;
    lgo:requiresDisclosureOf lgv:MainCharacteristics , lgv:ProviderName , lgv:GeographicAddress , lgv:PhoneNumber , lgv:EmailAddress ,
        lgv:RapidContact , lgv:ComplaintAddress , lgv:TotalPrice , lgv:DeliveryCosts , lgv:PersonalisedPricing ,
        lgv:SubscriptionCosts , lgv:CommunicationCosts , lgv:PaymentAndDeliveryTerms , lgv:WithdrawalInformation ,
        lgv:ReturnCosts , lgv:NoWithdrawalRight , lgv:LegalGuarantee , lgv:CommercialGuarantee , lgv:SoftwareUpdatePeriod ,
        lgv:CodesOfConduct , lgv:ContractDuration , lgv:Deposit , lgv:DigitalProductInformation ,
        lgv:DisputeResolutionStatement , lgv:RepairInformation ;
    lgo:reviewStatus lgv:Draft .

# --- Unfair terms in consumer contracts (§ 6 KSchG) -----------------------------------------

lg:AT-R-unfair-terms a lgo:Obligation ;
    rdfs:label "No unfair terms in standard consumer contracts"@en ;
    rdfs:comment "§ 6 Abs. 1 is the statutory blacklist of terms that are never effective against consumers, tied to the general clause of § 879 ABGB; Abs. 3 voids unclear or unintelligible terms in standard conditions and contract forms."@en ;
    lgo:refines lg:EU-R-unfair-terms ;
    lgo:establishedBy lg:AT-KSCHG-s6-1 , lg:AT-KSCHG-s6-3 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:MustNot ;
    lgo:appliesIn lg:AT ;
    lgo:appliesWhen lgv:SellsToConsumersInAustria ;
    lgo:requiresAction lgv:ImposeUnfairTerms ;
    lgo:reviewStatus lgv:Draft .

# --- Media owner disclosure (§ 25 MedienG) ------------------------------------------------------
# Austrian media law asks every website, as a periodical electronic medium, to disclose its owner.
# Sites limited to the owner's personal life or self-presentation give name, business purpose and
# residence or seat only (Abs. 5); the others give the full disclosure of Abs. 2 and 4 as well.

lg:AT-R-media-owner-disclosure a lgo:Obligation ;
    rdfs:label "Media owner disclosure: name, business purpose, residence or seat"@en ;
    rdfs:comment "Every website of an owner established in Austria, private ones included: § 25 MedienG applies to periodical electronic media, and Abs. 5 keeps the disclosure this short for sites limited to the owner's personal life or self-presentation. It may be published together with the e-Commerce imprint of § 5 ECG (Abs. 1)."@en ;
    lgo:establishedBy lg:AT-MEDIENG-s25-1 , lg:AT-MEDIENG-s25-5 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:AT ;
    lgo:appliesWhen lgv:EstablishedInAustria ;
    lgo:partOfDisclosure lgv:MediaOwnerDisclosure ;
    lgo:requiresDisclosureOf lgv:ProviderName , lgv:BusinessPurpose , lgv:GeographicAddress ;
    lgo:reviewStatus lgv:Draft .

lg:AT-R-media-owner-disclosure-full a lgo:Obligation ;
    rdfs:label "Media owner disclosure in full: representatives, ownership and editorial line"@en ;
    rdfs:comment "For websites whose content can influence public opinion beyond the owner's personal life or self-presentation: the representatives of the media owner, who owns it directly or indirectly, and a statement of its basic direction (Blattlinie)."@en ;
    lgo:establishedBy lg:AT-MEDIENG-s25-2 , lg:AT-MEDIENG-s25-4 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:AT ;
    lgo:appliesWhen lgv:EstablishedInAustria , lgv:InfluencesPublicOpinion ;
    lgo:partOfDisclosure lgv:MediaOwnerDisclosure ;
    lgo:requiresDisclosureOf lgv:AuthorisedRepresentative , lgv:OwnershipStructure , lgv:EditorialLine ;
    lgo:reviewStatus lgv:Draft .

# --- Company details on the website (Directive 2017/1132 Art. 26) ---

lg:AT-R-company-website a lgo:Obligation ;
    rdfs:label "Firmenbuch details on the website"@en ;
    rdfs:comment "Firmenbuch-registered traders give the firm name, legal form, seat, Firmenbuch number and court on their websites (§ 14(1) UGB). The section reaches every registered trader, not only companies; the rule covers limited-liability companies, as the EU rule it refines does."@en ;
    lgo:refines lg:EU-R-company-website-disclosure ;
    lgo:establishedBy lg:AT-UGB-s14-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:AT ;
    lgo:appliesWhen lgv:EstablishedInAustria , lgv:LimitedLiabilityCompany ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProviderName , lgv:LegalForm , lgv:GeographicAddress , lgv:RegisterEntry ;
    lgo:reviewStatus lgv:Draft .

# --- Consumer dispute resolution (Directive 2013/11 Art. 13) ---

lg:AT-R-adr-information a lgo:Obligation ;
    rdfs:label "Name the consumer ADR entity on the website and in the terms"@en ;
    rdfs:comment "§ 19(1)-(2) AStG: the ADR body or bodies covering the trader, with their website address, on the trader's website and in its general terms, where it has them."@en ;
    lgo:refines lg:EU-R-adr-information ;
    lgo:establishedBy lg:AT-ASTG-s19-1 , lg:AT-ASTG-s19-2 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:AT ;
    lgo:appliesWhen lgv:EstablishedInAustria , lgv:SellsToConsumers , lgv:TakesPartInConsumerDisputeResolution ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:Draft .

lg:AT-R-adr-information-after-complaint a lgo:Obligation ;
    rdfs:label "Point the consumer to ADR after an unsettled complaint"@en ;
    rdfs:comment "§ 19(3) AStG: on paper or another durable medium, the competent ADR body, and whether the trader will take part."@en ;
    lgo:refines lg:EU-R-adr-information-after-complaint ;
    lgo:establishedBy lg:AT-ASTG-s19-3 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:AT ;
    lgo:appliesWhen lgv:EstablishedInAustria , lgv:SellsToConsumers ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody , lgv:DisputeResolutionStatement ;
    lgo:reviewStatus lgv:Draft .
