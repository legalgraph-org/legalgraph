@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:   <https://legalgraph.org/id/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Estonia: provider information under § 4 of the Infoühiskonna teenuse seadus (Information Society
# Services Act), the transposition of Article 5 of the e-Commerce Directive. For an activity that needs
# registration or a licence it asks for the registration or licence number, not the supervisory authority.

lg:EE-R-impressum a lgo:Obligation ;
    rdfs:label "Provider information: name, address and e-mail"@en ;
    rdfs:comment "Name, address and other contact details including e-mail, directly and permanently available to the recipient (§ 4 lõige 1 punkt 1 InfoTS)."@en ;
    lgo:refines lg:EU-R-service-provider-information ;
    lgo:establishedBy lg:EE-ISSA-s4-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EE ;
    lgo:appliesWhen lgv:EstablishedInEstonia, lgv:CommercialDigitalService ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProviderName, lgv:GeographicAddress, lgv:EmailAddress, lgv:RapidContact ;
    lgo:reviewStatus lgv:Draft .

lg:EE-R-impressum-register a lgo:Obligation ;
    rdfs:label "Provider information: register entry"@en ;
    rdfs:comment "The registry code and the name of the register (§ 4 lõige 1 punkt 1)."@en ;
    lgo:refines lg:EU-R-service-provider-information-register ;
    lgo:establishedBy lg:EE-ISSA-s4-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EE ;
    lgo:appliesWhen lgv:EstablishedInEstonia, lgv:CommercialDigitalService, lgv:RegisteredInPublicRegister ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:RegisterEntry ;
    lgo:reviewStatus lgv:Draft .

lg:EE-R-impressum-vat a lgo:Obligation ;
    rdfs:label "Provider information: VAT identification number"@en ;
    rdfs:comment "The VAT registration number of a provider registered for VAT (§ 4 lõige 1 punkt 4)."@en ;
    lgo:refines lg:EU-R-service-provider-information-vat ;
    lgo:establishedBy lg:EE-ISSA-s4-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EE ;
    lgo:appliesWhen lgv:EstablishedInEstonia, lgv:CommercialDigitalService, lgv:HasVatId ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:VatId ;
    lgo:reviewStatus lgv:Draft .

lg:EE-R-impressum-authorisation a lgo:Obligation ;
    rdfs:label "Provider information: registration or licence number"@en ;
    rdfs:comment "Where the law requires registration in the register of economic activities for the field, the registration number, or the activity licence number (§ 4 lõige 1 punkt 2). Estonia asks for the number, not for the supervisory authority's particulars."@en ;
    lgo:refines lg:EU-R-service-provider-information-authorisation ;
    lgo:establishedBy lg:EE-ISSA-s4-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EE ;
    lgo:appliesWhen lgv:EstablishedInEstonia, lgv:CommercialDigitalService, lgv:ActivityRequiresAuthorisation ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:LicenceDetails ;
    lgo:reviewStatus lgv:Draft .

lg:EE-R-impressum-profession a lgo:Obligation ;
    rdfs:label "Provider information: regulated profession details"@en ;
    rdfs:comment "Professional organisation or association, professional title and the member state that granted it, and a reference to the professional requirements of the state of establishment with how to read them (§ 4 lõige 2)."@en ;
    lgo:refines lg:EU-R-service-provider-information-profession ;
    lgo:establishedBy lg:EE-ISSA-s4-2 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EE ;
    lgo:appliesWhen lgv:EstablishedInEstonia, lgv:CommercialDigitalService, lgv:RegulatedProfession ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProfessionalBody, lgv:ProfessionalTitle, lgv:ProfessionalRules ;
    lgo:reviewStatus lgv:Draft .

# --- Consumer ADR (Directive 2013/11/EU Art. 13) ---

lg:EE-R-adr-information a lgo:Obligation ;
    rdfs:label "Name the consumer ADR entity on the website and in the terms"@en ;
    rdfs:comment "§ 26(2)–(3) of the Tarbijakaitseseadus (Consumer Protection Act): the trader names the recognised ADR body the consumer can turn to (in Estonia the Consumer Disputes Committee), with its name, contact details, website address and where its rules of procedure can be read, clearly and accessibly on its website, where it has one, and in its general terms."@en ;
    lgo:refines lg:EU-R-adr-information ;
    lgo:establishedBy lg:EE-TKS-s26-2, lg:EE-TKS-s26-3 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EE ;
    lgo:appliesWhen lgv:EstablishedInEstonia , lgv:SellsToConsumers , lgv:TakesPartInConsumerDisputeResolution ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:Draft .

lg:EE-R-adr-information-every-trader a lgo:Obligation ;
    rdfs:label "Name the recognised consumer ADR body, whether or not the business takes part"@en ;
    rdfs:comment "§ 26(2)–(3) of the Tarbijakaitseseadus binds every trader, not only one committed to ADR: it names the recognised ADR body the consumer can turn to, with its contact details, website and rules of procedure, on its website and in its general terms."@en ;
    lgo:establishedBy lg:EE-TKS-s26-2 , lg:EE-TKS-s26-3 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EE ;
    lgo:appliesWhen lgv:EstablishedInEstonia , lgv:SellsToConsumers ;
    lgo:unless lgv:TakesPartInConsumerDisputeResolution ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:Draft .

lg:EE-R-adr-information-after-complaint a lgo:Obligation ;
    rdfs:label "Point the consumer to ADR after an unsettled complaint"@en ;
    rdfs:comment "§ 26(4) Tarbijakaitseseadus: when the trader refuses a claim in a consumer's complaint or finds it cannot be met, it gives the consumer, on paper or another durable medium, the information on the recognised ADR body the consumer can turn to."@en ;
    lgo:refines lg:EU-R-adr-information-after-complaint ;
    lgo:establishedBy lg:EE-TKS-s26-4 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EE ;
    lgo:appliesWhen lgv:EstablishedInEstonia , lgv:SellsToConsumers ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody , lgv:DisputeResolutionStatement ;
    lgo:reviewStatus lgv:Draft .
