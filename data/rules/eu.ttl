@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:  <https://legalgraph.org/id/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# EU: obligations of the GDPR and other regulations that apply directly, read from
# data/extracted/eu/. Directives address member states, so a rule resting on a directive stands for
# the national rules transposing it: the checklist names the national provisions of the places the
# business follows it in (the provisions with lgo:implements), and national rules that spell it out
# (lgo:refines) take its place where they cover them. Rules on consumer contracts follow the
# consumer's country (Article 6 Rome I), the others the country of establishment. Interpretation, so
# Draft until a lawyer reviews it.

# --- Service provider information (Article 5(1) e-Commerce Directive) --------------------
# The country of establishment's law applies (Article 3(1)), so these follow where the business is
# established, in the EEA as a whole. The Annex to the Directive carves consumer contracts (among
# others) out of the country-of-origin principle — it does not touch the Article 5 provider-information
# duty, which is exactly why the imprint follows the establishment while the pre-contract information
# follows the consumer's country.

lg:EU-R-service-provider-information a lgo:Obligation ;
    rdfs:label "Provider information: name, address and fast electronic contact"@en ;
    rdfs:comment "Every business-like website or app run from the EEA, easily, directly and permanently accessible: in most countries an imprint (Impressum, mentions légales) linked from every page. The binding text is the national law transposing the Directive; many add items of their own."@en ;
    lgo:establishedBy lg:EU-2000-31-art5-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:CommercialDigitalService ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProviderName , lgv:GeographicAddress , lgv:EmailAddress , lgv:RapidContact ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-service-provider-information-register a lgo:Obligation ;
    rdfs:label "Provider information: register and registration number"@en ;
    lgo:establishedBy lg:EU-2000-31-art5-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:CommercialDigitalService , lgv:RegisteredInPublicRegister ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:RegisterEntry ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-service-provider-information-authorisation a lgo:Obligation ;
    rdfs:label "Provider information: supervisory authority"@en ;
    lgo:establishedBy lg:EU-2000-31-art5-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:CommercialDigitalService , lgv:ActivityRequiresAuthorisation ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:SupervisoryAuthority ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-service-provider-information-profession a lgo:Obligation ;
    rdfs:label "Provider information: professional body, title and rules"@en ;
    lgo:establishedBy lg:EU-2000-31-art5-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:CommercialDigitalService , lgv:RegulatedProfession ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProfessionalBody , lgv:ProfessionalTitle , lgv:ProfessionalRules ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-service-provider-information-vat a lgo:Obligation ;
    rdfs:label "Provider information: VAT identification number"@en ;
    lgo:establishedBy lg:EU-2000-31-art5-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:CommercialDigitalService , lgv:HasVatId ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:VatId ;
    lgo:reviewStatus lgv:Draft .

# --- Contract terms in storable form (Article 10(3) e-Commerce Directive) -----------------
# Germany transposes it as § 312i BGB; the German rule refines this one.

lg:EU-R-contract-terms-storable a lgo:Obligation ;
    rdfs:label "Provide the contract terms so the customer can store and reproduce them"@en ;
    rdfs:comment "Contract terms and general conditions must reach the customer in a form that keeps — downloadable, printable, in the confirmation email or as a retrievable copy; a webpage that can quietly change afterwards is not enough (art. 10(3) e-Commerce Directive; § 312i(1) Nr. 4 BGB in Germany)."@en ;
    lgo:establishedBy lg:EU-2000-31-art10-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:SellsOnlineToConsumers ;
    lgo:requiresAction lgv:ProvideContractTermsInStorableForm ;
    lgo:requiresDisclosureOf lgv:GeneralTermsAvailability ;
    lgo:reviewStatus lgv:Draft .

# --- Company website disclosure (Article 26(1) Directive 2017/1132) ---------------------
# Company law, not the e-Commerce Directive, but it follows the establishment too: a company's
# website carries the register, legal form and seat its business letters must state. Member
# states transpose it in their company or commerce acts (Germany: § 5 DDG together with
# § 35a GmbHG for letters; Austria: § 14 UGB).

lg:EU-R-company-website-disclosure a lgo:Obligation ;
    rdfs:label "Company details on the website: register, legal form and seat"@en ;
    rdfs:comment "For limited-liability companies. The website shows at least the particulars the law wants on letters and order forms: the register and the company's number in it, the legal form and the registered office."@en ;
    lgo:establishedBy lg:EU-2017-1132-art26-1-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:LimitedLiabilityCompany ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:RegisterEntry , lgv:LegalForm , lgv:GeographicAddress ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-company-website-liquidation a lgo:Obligation ;
    rdfs:label "Company website: state when the company is being wound up"@en ;
    lgo:establishedBy lg:EU-2017-1132-art26-1-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:LimitedLiabilityCompany , lgv:InLiquidation ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:LiquidationStatus ;
    lgo:reviewStatus lgv:Draft .

# --- Consumer ADR information (Article 13 Directive 2013/11/EU) ---------------------------
# The EU floor for naming the dispute-resolution body; Germany transposes it in §§ 36, 37 VSBG.
# Directive (EU) 2025/2647 rewords Article 13(2) and (3) — member states apply it from
# 20 September 2028.

lg:EU-R-adr-information a lgo:Obligation ;
    rdfs:label "Name the consumer ADR entity on the website and in the terms"@en ;
    rdfs:comment "Only for a trader committed or obliged to use alternative dispute resolution: it names the ADR entity covering it, with the entity's website address, on its own website and in its general terms."@en ;
    lgo:establishedBy lg:EU-2013-11-art13-1 , lg:EU-2013-11-art13-2 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:SellsToConsumers , lgv:TakesPartInConsumerDisputeResolution ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-adr-information-after-complaint a lgo:Obligation ;
    rdfs:label "Point the consumer to ADR after an unsettled complaint"@en ;
    rdfs:comment "When a dispute over a consumer contract cannot be settled after a direct complaint, the trader provides the ADR entity information and says whether it will use ADR. Germany implements it as § 37 VSBG for every trader."@en ;
    lgo:establishedBy lg:EU-2013-11-art13-3 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:SellsToConsumers ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody , lgv:DisputeResolutionStatement ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-company-website-capital a lgo:Obligation ;
    rdfs:label "Company website: subscribed and paid-up capital"@en ;
    rdfs:comment "Where the company mentions its capital, the figure must be the capital subscribed and paid up."@en ;
    lgo:establishedBy lg:EU-2017-1132-art26-1-2 , lg:EU-2017-1132-art26-1-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:EstablishedInTheEea , lgv:LimitedLiabilityCompany , lgv:StatesShareCapital ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ShareCapital ;
    lgo:reviewStatus lgv:Draft .

# --- Privacy information (Articles 12 and 13 GDPR) -------------------------------------

lg:EU-R-pre-contract-information a lgo:Obligation ;
    rdfs:label "Pre-contractual information for online sales to consumers"@en ;
    rdfs:comment "Items marked “where applicable” in the law depend on the product; the checklist lists them all for the trader to check. Before the contract a trader selling online to consumers gives the whole Article 6(1) list, including the trader's telephone number since Directive (EU) 2019/2161 (in force 28 May 2022). It follows the consumer's country, not the trader's: a consumer contract is governed by the law of the country the business directs its sales to (Article 6 Rome I)."@en ;
    lgo:establishedBy lg:EU-2011-83-art6-1 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:SellsToConsumersInTheEea , lgv:SellsOnlineToConsumers ;
    lgo:partOfDisclosure lgv:PreContractInformation ;
    lgo:requiresDisclosureOf lgv:MainCharacteristics , lgv:ProviderName , lgv:GeographicAddress , lgv:PhoneNumber , lgv:EmailAddress ,
        lgv:ComplaintAddress , lgv:TotalPrice , lgv:PersonalisedPricing , lgv:CommunicationCosts , lgv:PaymentAndDeliveryTerms ,
        lgv:WithdrawalInformation , lgv:ReturnCosts , lgv:NoWithdrawalRight , lgv:LegalGuarantee , lgv:CommercialGuarantee ,
        lgv:SoftwareUpdatePeriod , lgv:CodesOfConduct , lgv:ContractDuration , lgv:Deposit , lgv:DigitalProductInformation ,
        lgv:DisputeResolutionStatement , lgv:RepairInformation ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-privacy-information a lgo:Obligation ;
    rdfs:label "Privacy information: who, why, on which basis, to whom, how long, which rights"@en ;
    rdfs:comment "Given when data are collected: on a website, a privacy policy reachable from every page. Recipients are named if there are any."@en ;
    lgo:establishedBy lg:EU-2016-679-art12-1 , lg:EU-2016-679-art13-1 , lg:EU-2016-679-art13-2 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:CollectsDataFromDataSubjects ;
    lgo:partOfDisclosure lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:ControllerIdentity , lgv:ProcessingPurposes , lgv:LegalBasisOfProcessing , lgv:Recipients ,
        lgv:RetentionPeriod , lgv:DataSubjectRights , lgv:ComplaintRight , lgv:ProvisionRequirement ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-privacy-information-dpo a lgo:Obligation ;
    rdfs:label "Privacy information: contact details of the data protection officer"@en ;
    lgo:establishedBy lg:EU-2016-679-art13-1 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:CollectsDataFromDataSubjects , lgv:HasDataProtectionOfficer ;
    lgo:partOfDisclosure lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:DataProtectionOfficerContact ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-privacy-information-legitimate-interests a lgo:Obligation ;
    rdfs:label "Privacy information: the legitimate interests pursued"@en ;
    lgo:establishedBy lg:EU-2016-679-art13-1 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:CollectsDataFromDataSubjects , lgv:ReliesOnLegitimateInterests ;
    lgo:partOfDisclosure lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:LegitimateInterests ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-privacy-information-transfers a lgo:Obligation ;
    rdfs:label "Privacy information: transfers outside the EU and their safeguards"@en ;
    lgo:establishedBy lg:EU-2016-679-art13-1 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:CollectsDataFromDataSubjects , lgv:TransfersOutsideEEA ;
    lgo:partOfDisclosure lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:ThirdCountryTransfer ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-privacy-information-consent a lgo:Obligation ;
    rdfs:label "Privacy information: the right to withdraw consent"@en ;
    lgo:establishedBy lg:EU-2016-679-art13-2 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:CollectsDataFromDataSubjects , lgv:ReliesOnConsent ;
    lgo:partOfDisclosure lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:ConsentWithdrawalRight ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-privacy-information-automated-decisions a lgo:Obligation ;
    rdfs:label "Privacy information: automated decision-making and profiling"@en ;
    lgo:establishedBy lg:EU-2016-679-art13-2 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:CollectsDataFromDataSubjects , lgv:UsesAutomatedDecisionMaking ;
    lgo:partOfDisclosure lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:AutomatedDecisionMaking ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-privacy-information-representative a lgo:Obligation ;
    rdfs:label "Privacy information: the representative in the EU"@en ;
    lgo:establishedBy lg:EU-2016-679-art13-1 , lg:EU-2016-679-art27-1 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:CollectsDataFromDataSubjects ;
    lgo:unless lgv:EstablishedInTheUnion ;
    lgo:partOfDisclosure lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:ControllerRepresentative ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-privacy-information-other-sources a lgo:Obligation ;
    rdfs:label "Privacy information for data obtained elsewhere: categories and source"@en ;
    lgo:establishedBy lg:EU-2016-679-art14-1 , lg:EU-2016-679-art14-2 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:ObtainsDataFromOtherSources ;
    lgo:partOfDisclosure lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:ControllerIdentity , lgv:ProcessingPurposes , lgv:LegalBasisOfProcessing ,
        lgv:CategoriesOfPersonalData , lgv:Recipients , lgv:RetentionPeriod , lgv:DataSubjectRights , lgv:ComplaintRight ,
        lgv:SourceOfPersonalData ;
    lgo:reviewStatus lgv:Draft .

# --- Lawfulness and consent (Articles 6 and 7 GDPR) ------------------------------------

lg:EU-R-lawful-basis a lgo:Obligation ;
    rdfs:label "A lawful basis for every processing purpose"@en ;
    lgo:establishedBy lg:EU-2016-679-art6-1 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:HaveLawfulBasis ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-consent-conditions a lgo:Obligation ;
    rdfs:label "Consent that can be proven and withdrawn as easily as given"@en ;
    lgo:establishedBy lg:EU-2016-679-art7-1 , lg:EU-2016-679-art7-3 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:ReliesOnConsent ;
    lgo:requiresAction lgv:DemonstrateConsent , lgv:MakeWithdrawalAsEasyAsConsent ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-consent-separate a lgo:Obligation ;
    rdfs:label "Ask for consent apart from other matters"@en ;
    rdfs:comment "Where consent is given inside a written declaration that also covers other matters — accepting terms of business, a purchase — the request must stand out clearly, in an accessible form and plain language. A marketing-consent checkbox fused into the terms acceptance fails this."@en ;
    lgo:establishedBy lg:EU-2016-679-art7-2 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:ReliesOnConsent ;
    lgo:requiresAction lgv:KeepConsentRequestSeparate ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-consent-no-tying a lgo:Obligation ;
    rdfs:label "No service conditioned on unnecessary consent"@en ;
    rdfs:comment "Consent is not freely given when the contract or service is made to depend on processing the service does not need (Art. 7(4); Recital 43; the EDPB reads the bundling prohibition against cookie walls in its consent guidelines)."@en ;
    lgo:establishedBy lg:EU-2016-679-art7-4 , lg:EU-2016-679-rec43 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:MustNot ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:ReliesOnConsent ;
    lgo:requiresAction lgv:ConditionServiceOnConsent ;
    lgo:reviewStatus lgv:Draft .

# --- Data protection officer and representative (Articles 27 and 37 GDPR) --------------

lg:EU-R-data-protection-officer a lgo:Obligation ;
    rdfs:label "Designate a data protection officer (GDPR cases)"@en ;
    lgo:establishedBy lg:EU-2016-679-art37-1 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:DataProtectionOfficerRequiredByGdpr ;
    lgo:requiresAction lgv:DesignateDataProtectionOfficer ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-data-protection-officer-contact a lgo:Obligation ;
    rdfs:label "Publish the data protection officer's contact details"@en ;
    lgo:establishedBy lg:EU-2016-679-art37-7 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:HasDataProtectionOfficer ;
    lgo:requiresAction lgv:PublishDataProtectionOfficerContact ;
    lgo:requiresDisclosureOf lgv:DataProtectionOfficerContact ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-representative a lgo:Obligation ;
    rdfs:label "Designate a representative in the EU"@en ;
    rdfs:comment "For businesses outside the EU that target or monitor people in it. Article 27(2) exempts occasional, low-risk processing; not modelled yet."@en ;
    lgo:establishedBy lg:EU-2016-679-art27-1 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:unless lgv:EstablishedInTheUnion ;
    lgo:requiresAction lgv:DesignateRepresentativeInTheUnion ;
    lgo:reviewStatus lgv:Draft .

# --- Digital Services Act -----------------------------------------------------------------

lg:EU-R-dsa-points-of-contact a lgo:Obligation ;
    rdfs:label "Points of contact for authorities and users"@en ;
    lgo:establishedBy lg:EU-2022-2065-art11-1 , lg:EU-2022-2065-art12-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:ActiveInTheUnion , lgv:ProvidesIntermediaryService ;
    lgo:requiresAction lgv:DesignatePointsOfContact ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-dsa-terms a lgo:Obligation ;
    rdfs:label "Content restrictions and moderation in the terms and conditions"@en ;
    lgo:establishedBy lg:EU-2022-2065-art14-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:ActiveInTheUnion , lgv:ProvidesIntermediaryService ;
    lgo:requiresDisclosureOf lgv:ContentModerationRules ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-dsa-advertising a lgo:Obligation ;
    rdfs:label "Mark advertisements on online platforms"@en ;
    lgo:establishedBy lg:EU-2022-2065-art26-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:ActiveInTheUnion , lgv:OperatesOnlinePlatform , lgv:ShowsAdvertisementsOnPlatform ;
    lgo:unless lgv:SmallPlatformExempt ;
    lgo:partOfDisclosure lgv:CommercialCommunication ;
    lgo:requiresDisclosureOf lgv:AdvertisementMarking , lgv:Advertiser , lgv:AdTargetingParameters ;
    lgo:requiresAction lgv:LabelAdvertisements ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-dsa-trader-traceability a lgo:Obligation ;
    rdfs:label "Know the traders on a marketplace"@en ;
    lgo:establishedBy lg:EU-2022-2065-art30-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:ActiveInTheUnion , lgv:OperatesMarketplace ;
    lgo:unless lgv:SmallPlatformExempt ;
    lgo:requiresAction lgv:VerifyTraders ;
    lgo:reviewStatus lgv:Draft .

# --- AI Act, Article 50 -----------------------------------------------------------------

lg:EU-R-ai-chatbot a lgo:Obligation ;
    rdfs:label "Tell people they are talking to an AI"@en ;
    rdfs:comment "Article 50(1) addresses providers, who must design the system to inform people; a business deploying a third-party chatbot should make sure it does. Unless it is obvious from the context."@en ;
    lgo:establishedBy lg:EU-2024-1689-art50-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:ActiveInTheUnion , lgv:UsesChatbot ;
    lgo:partOfDisclosure lgv:AiTransparency ;
    lgo:requiresDisclosureOf lgv:AiInteractionNotice ;
    lgo:requiresAction lgv:DiscloseAiInteraction ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-ai-generated-content a lgo:Obligation ;
    rdfs:label "Disclose deep fakes and AI-generated public-interest text"@en ;
    lgo:establishedBy lg:EU-2024-1689-art50-4 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:ActiveInTheUnion , lgv:PublishesAiGeneratedMedia ;
    lgo:partOfDisclosure lgv:AiTransparency ;
    lgo:requiresDisclosureOf lgv:AiGeneratedContentLabel ;
    lgo:requiresAction lgv:DiscloseAiGeneratedContent ;
    lgo:reviewStatus lgv:Draft .

# --- Product safety, energy labels, geo-blocking, political ads (regulations) -----------

lg:EU-R-product-safety-information a lgo:Obligation ;
    rdfs:label "Product safety information in every online offer"@en ;
    rdfs:comment "Since 13 December 2024. Applies to economic operators selling consumer products online, including marketplace sellers."@en ;
    lgo:establishedBy lg:EU-2023-988-art19 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:ActiveInTheUnion , lgv:SellsProductsOnline ;
    lgo:partOfDisclosure lgv:ProductSafetyInformation ;
    lgo:requiresDisclosureOf lgv:ManufacturerIdentity , lgv:ResponsiblePersonInTheUnion , lgv:ProductIdentification , lgv:SafetyWarnings ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-energy-label a lgo:Obligation ;
    rdfs:label "Energy label and product information sheet online"@en ;
    rdfs:comment "The product-group regulations (delegated acts) say how the label is shown online, usually as a nested display next to the price."@en ;
    lgo:establishedBy lg:EU-2017-1369-art5-1 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:ActiveInTheUnion , lgv:SellsEnergyLabelledProducts ;
    lgo:partOfDisclosure lgv:PreContractInformation ;
    lgo:requiresDisclosureOf lgv:EnergyLabel ;
    lgo:requiresAction lgv:DisplayEnergyLabel ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-geo-blocking a lgo:Obligation ;
    rdfs:label "No geo-blocking of customers from other EU countries"@en ;
    rdfs:comment "Selling to customers from every EU country on the same terms does not oblige a trader to deliver everywhere."@en ;
    lgo:establishedBy lg:EU-2018-302-art3-1 , lg:EU-2018-302-art4-1 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:MustNot ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:ActiveInTheUnion , lgv:SellsOnlineToConsumers ;
    lgo:requiresAction lgv:NoGeoBlocking ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-political-advertising a lgo:Obligation ;
    rdfs:label "Label political advertisements with their sponsor and a transparency notice"@en ;
    rdfs:comment "Since 10 October 2025."@en ;
    lgo:establishedBy lg:EU-2024-900-art11-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:ActiveInTheUnion , lgv:PublishesPoliticalAdvertising ;
    lgo:partOfDisclosure lgv:PoliticalAdvertisingTransparency ;
    lgo:requiresDisclosureOf lgv:PoliticalAdSponsor ;
    lgo:reviewStatus lgv:Draft .

# --- Cookies and similar access to the user's device (ePrivacy art. 5(3)) --------------------
# National rules for the same duty (Germany's TDDDG, the UK's PECR) refine this one.

lg:EU-R-cookie-consent a lgo:Obligation ;
    rdfs:label "Consent before storing or accessing information on the user's device"@en ;
    rdfs:comment "The ePrivacy ground rule for cookies, pixels and similar — exempt only: transmission over a network and what is strictly necessary for a service the user asked for. How it is read: no pre-ticked boxes (CJEU Planet49; IAB Europe C-604/22), refusing as easy as accepting (EDPB Cookie Banner Taskforce; CNIL 2020-092), purposes stated before the choice. The rule protects the user's device, so it is read as applying wherever the users are as well as where the business is; Germany says so in § 1(3) TDDDG."@en ;
    lgo:establishedBy lg:EU-2002-58-art5-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:MustNot ;
    lgo:appliesIn lg:EEA ;
    lgo:appliesWhen lgv:ActiveInTheEea , lgv:NonEssentialDeviceAccess ;
    lgo:requiresAction lgv:ObtainConsentBeforeDeviceAccess ;
    lgo:reviewStatus lgv:Draft .

# --- Unfair terms in consumer contracts (Directive 93/13/EEC) --------------------------------

lg:EU-R-unfair-terms a lgo:Obligation ;
    rdfs:label "No unfair terms in consumer contracts"@en ;
    rdfs:comment "A non-negotiated term is not binding where, contrary to good faith, it causes a significant imbalance to the consumer's detriment — the Annex is the indicative grey list. The CJEU read it in Amazon (C-191/15) on choice of law. It follows the consumer's country, not the trader's: a consumer contract is governed by the law of the country the business directs its sales to (Article 6 Rome I)."@en ;
    lgo:establishedBy lg:EU-1993-13-art3-1 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:MustNot ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:SellsToConsumersInTheEea ;
    lgo:requiresAction lgv:ImposeUnfairTerms ;
    lgo:reviewStatus lgv:Draft .

# --- Processor contracts, records, retention and design (GDPR arts. 5, 25, 28, 30) -----------

lg:EU-R-processing-agreement a lgo:Obligation ;
    rdfs:label "A data processing agreement with every processor"@en ;
    rdfs:comment "Hosting, mailing tools, form processors, analytics vendors: each needs a contract with the Article 28(3) terms — documented instructions, confidentiality, security, sub-processor control, assistance with data-subject rights, and deletion or return of the data at the end of the service at the controller's choice (art. 28(3)(g))."@en ;
    lgo:establishedBy lg:EU-2016-679-art28-1 , lg:EU-2016-679-art28-3 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:EngagesProcessors ;
    lgo:requiresAction lgv:HaveProcessingAgreement ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-processing-record a lgo:Obligation ;
    rdfs:label "Keep a record of processing activities"@en ;
    rdfs:comment "Purposes, categories, recipients, transfers and retention periods, in writing — the small-business exemption in art. 30(5) does not apply where processing is not occasional, so a website business is covered."@en ;
    lgo:establishedBy lg:EU-2016-679-art30-1 , lg:EU-2016-679-art30-2 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:KeepProcessingRecord ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-storage-limitation a lgo:Obligation ;
    rdfs:label "Keep personal data no longer than the purpose needs"@en ;
    rdfs:comment "Retention periods and deletion: identifying data only while the purpose lasts; the GDPR sets no period for evidence of consent. In practice it is often kept while the processing runs and then for the time claims could still be brought — in Germany, for example, three years for civil claims (§ 195 BGB) and six months for unfair-competition claims (§ 11 UWG); that is a reading, not a rule of the GDPR."@en ;
    lgo:establishedBy lg:EU-2016-679-art5-1-e ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:KeepDataNoLongerThanNecessary ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-privacy-by-design a lgo:Obligation ;
    rdfs:label "Data protection by design and by default"@en ;
    rdfs:comment "Build the service so defaults collect the minimum the purpose needs — a form should not ask for more than the feature requires, and consent mechanisms should reflect the design standard, not retrofit it."@en ;
    lgo:establishedBy lg:EU-2016-679-art25-1 , lg:EU-2016-679-art25-2 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:DesignForDataProtection ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-consent-specific a lgo:Obligation ;
    rdfs:label "One purpose per consent"@en ;
    rdfs:comment "Consent is only valid for the purpose it was given for: granular, separate choices — one checkbox must not cover newsletter, profiling and partner offers at once (Art. 4(11) 'specific'; Recital 43; Art. 7(2) keeps the request apart from other matters)."@en ;
    lgo:establishedBy lg:EU-2016-679-art4-11 , lg:EU-2016-679-art7-2 , lg:EU-2016-679-rec43 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:ReliesOnConsent ;
    lgo:requiresAction lgv:ObtainConsentPerPurpose ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-processor-end-of-service a lgo:Obligation ;
    rdfs:label "Delete or return personal data when the service ends"@en ;
    rdfs:comment "The processor's own duty at contract end: the controller chooses deletion or return, existing copies go unless the law requires storage. A processor that decides purposes and means itself is treated as a controller of that processing (art. 28(10))."@en ;
    lgo:establishedBy lg:EU-2016-679-art28-3-g , lg:EU-2016-679-art28-10 ;
    lgo:bearer lgv:Processor ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:ActsAsProcessor ;
    lgo:requiresAction lgv:ReturnOrDeleteAtEndOfService ;
    lgo:reviewStatus lgv:Draft .

# --- Data subject rights (Chapter III GDPR) ---------------------------------------------------

lg:EU-R-access-request a lgo:Obligation ;
    rdfs:label "Answer access requests with a copy of the personal data"@en ;
    rdfs:comment "Within one month (two more for complex requests) a person gets confirmation, a copy of their data and the Article 15(1) information; the copy must not affect the rights and freedoms of others (Article 15(4)), which include trade secrets (recital 63) but do not justify refusing all information."@en ;
    lgo:establishedBy lg:EU-2016-679-art15-1 , lg:EU-2016-679-art12-3 , lg:EU-2016-679-art15-4 , lg:EU-2016-679-rec63 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:ProvideAccessToPersonalData , lgv:AnswerDataSubjectRequestWithinOneMonth ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-rectification a lgo:Obligation ;
    rdfs:label "Rectify inaccurate personal data"@en ;
    rdfs:comment "Correct wrong data without undue delay and complete incomplete data; recipients told about the data must be informed (Article 19)."@en ;
    lgo:establishedBy lg:EU-2016-679-art16 , lg:EU-2016-679-art19 , lg:EU-2016-679-art12-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:RectifyPersonalData , lgv:AnswerDataSubjectRequestWithinOneMonth , lgv:NotifyRecipientsOfDataSubjectAction ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-erasure a lgo:Obligation ;
    rdfs:label "Erase personal data when the right applies"@en ;
    rdfs:comment "Erase without undue delay where a ground in Article 17(1) applies — e.g. consent withdrawn or no longer needed — unless an exception in Article 17(3) applies, such as legal claims; recipients must be informed (Article 19)."@en ;
    lgo:establishedBy lg:EU-2016-679-art17-1 , lg:EU-2016-679-art17-3 , lg:EU-2016-679-art19 , lg:EU-2016-679-art12-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:ErasePersonalData , lgv:AnswerDataSubjectRequestWithinOneMonth , lgv:NotifyRecipientsOfDataSubjectAction ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-restriction a lgo:Obligation ;
    rdfs:label "Restrict processing when the right applies"@en ;
    rdfs:comment "While a ground in Article 18(1) runs — contested accuracy, unlawful processing the person wants kept, data needed for legal claims, a pending objection — processing is limited to storage plus the listed exceptions (Article 18(2)); recipients must be informed (Article 19)."@en ;
    lgo:establishedBy lg:EU-2016-679-art18-1 , lg:EU-2016-679-art18-2 , lg:EU-2016-679-art19 , lg:EU-2016-679-art12-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:RestrictProcessingOfPersonalData , lgv:AnswerDataSubjectRequestWithinOneMonth , lgv:NotifyRecipientsOfDataSubjectAction ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-portability a lgo:Obligation ;
    rdfs:label "Provide the person's data in a portable format"@en ;
    rdfs:comment "The data the person provided, processed on consent or contract by automated means, in a structured, commonly used and machine-readable format; transmitted directly where feasible. Only what the person provided is covered — a business's own notes are not, though they are personal data for access under Article 15."@en ;
    lgo:establishedBy lg:EU-2016-679-art20-1 , lg:EU-2016-679-art12-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:ProvideDataInPortableFormat , lgv:AnswerDataSubjectRequestWithinOneMonth ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-objection a lgo:Obligation ;
    rdfs:label "Stop processing on objection unless compelling grounds"@en ;
    rdfs:comment "Processing on the public-task or legitimate-interests basis stops on objection unless compelling legitimate grounds override or legal claims need it."@en ;
    lgo:establishedBy lg:EU-2016-679-art21-1 , lg:EU-2016-679-art12-3 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:StopProcessingOnObjection , lgv:AnswerDataSubjectRequestWithinOneMonth ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-objection-marketing a lgo:Obligation ;
    rdfs:label "Stop direct marketing on objection"@en ;
    rdfs:comment "Objection to direct marketing always wins — no weighing of interests; the right must be pointed out clearly and separately at the first contact (Article 21(4))."@en ;
    lgo:establishedBy lg:EU-2016-679-art21-2 , lg:EU-2016-679-art21-3 , lg:EU-2016-679-art21-4 ;
    lgo:bearer lgv:Advertiser ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies , lgv:SendsMarketingEmails ;
    lgo:requiresAction lgv:StopDirectMarketingOnObjection ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-data-security a lgo:Obligation ;
    rdfs:label "Secure personal data"@en ;
    rdfs:comment "Technical and organisational measures appropriate to the risk: pseudonymisation, confidentiality, availability, resilience and regular testing."@en ;
    lgo:establishedBy lg:EU-2016-679-art32-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:SecurePersonalData ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-breach-notification a lgo:Obligation ;
    rdfs:label "Notify a personal data breach within 72 hours, tell the people affected"@en ;
    rdfs:comment "The supervisory authority gets a notification within 72 hours where feasible unless the breach is unlikely to risk rights and freedoms (Article 33); the people affected are told without undue delay when the risk is high (Article 34)."@en ;
    lgo:establishedBy lg:EU-2016-679-art33-1 , lg:EU-2016-679-art34-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:NotifyBreachToSupervisoryAuthority , lgv:InformDataSubjectsOfBreach ;
    lgo:reviewStatus lgv:Draft .

# --- Controller duties: GDPR Art. 9, 22, 29, 31, 35, 36, 38 and 39 ---

lg:EU-R-special-categories a lgo:Obligation ;
    rdfs:label "Process special categories of data only under an exception"@en ;
    rdfs:comment "Processing data revealing racial or ethnic origin, political opinions, religious or philosophical beliefs or trade union membership, genetic or biometric data for identification, health data or data on sex life or sexual orientation is prohibited unless one of the exceptions of Art. 9(2) applies, such as explicit consent; Member States may add conditions for genetic, biometric and health data (Art. 9(4))."@en ;
    lgo:establishedBy lg:EU-2016-679-art9-1, lg:EU-2016-679-art9-2 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies, lgv:ProcessesSpecialCategories ;
    lgo:requiresAction lgv:ProcessSpecialCategoriesOnlyUnderAnException ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-automated-decisions a lgo:Obligation ;
    rdfs:label "Safeguard decisions based solely on automated processing"@en ;
    rdfs:comment "A decision with legal or similarly significant effects based solely on automated processing, including profiling, is allowed only for a contract, under law or with explicit consent; for a contract or consent the controller provides human intervention, the chance to express one's view and to contest the decision (Art. 22(1)–(3)), and does not base it on special categories without explicit consent or a substantial public interest (Art. 22(4))."@en ;
    lgo:establishedBy lg:EU-2016-679-art22-1, lg:EU-2016-679-art22-2, lg:EU-2016-679-art22-3, lg:EU-2016-679-art22-4 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies, lgv:UsesAutomatedDecisionMaking ;
    lgo:requiresAction lgv:SafeguardAutomatedDecisions ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-processing-on-instructions a lgo:Obligation ;
    rdfs:label "Staff process personal data only on instructions"@en ;
    rdfs:comment "Anyone acting under the authority of the controller or processor who has access to personal data processes them only on the controller's instructions, unless Union or Member State law requires it (Art. 29)."@en ;
    lgo:establishedBy lg:EU-2016-679-art29 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:InstructPersonsWithAccess ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-supervisory-authority-cooperation a lgo:Obligation ;
    rdfs:label "Cooperate with the supervisory authority"@en ;
    rdfs:comment "The controller and the processor, and their representatives, cooperate on request with the supervisory authority (Art. 31)."@en ;
    lgo:establishedBy lg:EU-2016-679-art31 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies ;
    lgo:requiresAction lgv:CooperateWithSupervisoryAuthority ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-impact-assessment a lgo:Obligation ;
    rdfs:label "Carry out a data protection impact assessment"@en ;
    rdfs:comment "Before processing likely to result in a high risk, in particular systematic and extensive profiling with significant effects, large-scale special categories or large-scale systematic monitoring of public areas, the controller assesses its impact, with the DPO's advice where one is designated, and reviews it when the risk changes (Art. 35(1)–(3), (7), (11))."@en ;
    lgo:establishedBy lg:EU-2016-679-art35-1, lg:EU-2016-679-art35-2, lg:EU-2016-679-art35-3, lg:EU-2016-679-art35-7, lg:EU-2016-679-art35-11 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies, lgv:HighRiskProcessing ;
    lgo:requiresAction lgv:CarryOutImpactAssessment ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-prior-consultation a lgo:Obligation ;
    rdfs:label "Consult the supervisory authority before unmitigated high-risk processing"@en ;
    rdfs:comment "Where the impact assessment shows a high risk the controller cannot mitigate, the controller consults the supervisory authority before processing and gives it the information listed in Art. 36(3)."@en ;
    lgo:establishedBy lg:EU-2016-679-art36-1, lg:EU-2016-679-art36-3 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies, lgv:UnmitigatedHighRisk ;
    lgo:requiresAction lgv:ConsultSupervisoryAuthorityBeforeProcessing ;
    lgo:reviewStatus lgv:Draft .

lg:EU-R-data-protection-officer-support a lgo:Obligation ;
    rdfs:label "Involve and support the data protection officer"@en ;
    rdfs:comment "The DPO is involved properly and in good time, gets the resources for the tasks of Art. 39, takes no instructions on them, is not dismissed or penalised for performing them, reports to the highest management level and has no conflicting tasks (Art. 38(1)–(3), (6), Art. 39(1))."@en ;
    lgo:establishedBy lg:EU-2016-679-art38-1, lg:EU-2016-679-art38-2, lg:EU-2016-679-art38-3, lg:EU-2016-679-art38-6, lg:EU-2016-679-art39-1 ;
    lgo:bearer lgv:Controller ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:EU ;
    lgo:appliesWhen lgv:GdprApplies, lgv:HasDataProtectionOfficer ;
    lgo:requiresAction lgv:SupportDataProtectionOfficer ;
    lgo:reviewStatus lgv:Draft .
