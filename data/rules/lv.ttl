@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:   <https://legalgraph.org/id/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Latvia: provider information under section 4(1) of the Information Society Services Law,
# the transposition of Article 5 of the e-Commerce Directive. Point 1 joins name, legal address and
# registration number (if any) in one item; the registration number is split into its own rule here
# so it refines the EU register rule.

lg:LV-R-impressum a lgo:Obligation ;
    rdfs:label "Provider information: name, legal address and fast electronic contact"@en ;
    rdfs:comment "The firm name or name and surname, the legal address or declared place of residence, and contact details for rapid direct communication, including an e-mail address (section 4(1) points 1 and 2 ISSL)."@en ;
    lgo:refines lg:EU-R-service-provider-information ;
    lgo:establishedBy lg:LV-ISSL-art4-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LV ;
    lgo:appliesWhen lgv:EstablishedInLatvia , lgv:CommercialDigitalService ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProviderName , lgv:GeographicAddress , lgv:EmailAddress , lgv:RapidContact ;
    lgo:reviewStatus lgv:Draft .

lg:LV-R-impressum-register a lgo:Obligation ;
    rdfs:label "Provider information: registration number"@en ;
    lgo:refines lg:EU-R-service-provider-information-register ;
    lgo:establishedBy lg:LV-ISSL-art4-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LV ;
    lgo:appliesWhen lgv:EstablishedInLatvia , lgv:CommercialDigitalService , lgv:RegisteredInPublicRegister ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:RegisterEntry ;
    lgo:reviewStatus lgv:Draft .

lg:LV-R-impressum-authorisation a lgo:Obligation ;
    rdfs:label "Provider information: institution that issued the licence"@en ;
    lgo:refines lg:EU-R-service-provider-information-authorisation ;
    lgo:establishedBy lg:LV-ISSL-art4-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LV ;
    lgo:appliesWhen lgv:EstablishedInLatvia , lgv:CommercialDigitalService , lgv:ActivityRequiresAuthorisation ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:SupervisoryAuthority ;
    lgo:reviewStatus lgv:Draft .

lg:LV-R-impressum-profession a lgo:Obligation ;
    rdfs:label "Provider information: regulated profession details"@en ;
    lgo:refines lg:EU-R-service-provider-information-profession ;
    lgo:establishedBy lg:LV-ISSL-art4-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LV ;
    lgo:appliesWhen lgv:EstablishedInLatvia , lgv:CommercialDigitalService , lgv:RegulatedProfession ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProfessionalBody , lgv:ProfessionalTitle , lgv:ProfessionalRules ;
    lgo:reviewStatus lgv:Draft .

lg:LV-R-impressum-vat a lgo:Obligation ;
    rdfs:label "Provider information: VAT registration number"@en ;
    lgo:refines lg:EU-R-service-provider-information-vat ;
    lgo:establishedBy lg:LV-ISSL-art4-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LV ;
    lgo:appliesWhen lgv:EstablishedInLatvia , lgv:CommercialDigitalService , lgv:HasVatId ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:VatId ;
    lgo:reviewStatus lgv:Draft .

# --- Company details on the website (Directive 2017/1132 Art. 26) ---

lg:LV-R-company-website a lgo:Obligation ;
    rdfs:label "Merchant details on the website"@en ;
    rdfs:comment "Every merchant gives its firm name, commercial-register number and legal address on its website, and liquidation or insolvency where it applies (Komerclikums 17. pants (1)). The firm name of a Latvian company carries its legal form, so there is no separate line for it."@en ;
    lgo:refines lg:EU-R-company-website-disclosure ;
    lgo:establishedBy lg:LV-KL-art17-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LV ;
    lgo:appliesWhen lgv:EstablishedInLatvia , lgv:LimitedLiabilityCompany ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProviderName , lgv:RegisterEntry , lgv:GeographicAddress ;
    lgo:reviewStatus lgv:Draft .

# --- Consumer dispute resolution (Directive 2013/11 Art. 13) ---

lg:LV-R-adr-information a lgo:Obligation ;
    rdfs:label "Name the consumer ADR entity on the website and in the terms"@en ;
    rdfs:comment "Article 19.1(1)-(2) of the Consumer Rights Protection Law: one or more dispute resolvers from the list published by the Consumer Rights Protection Centre, with their website, on the trader's website or in its contract terms."@en ;
    lgo:refines lg:EU-R-adr-information ;
    lgo:establishedBy lg:LV-PTAL-art19-1-1 , lg:LV-PTAL-art19-1-2 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LV ;
    lgo:appliesWhen lgv:EstablishedInLatvia , lgv:SellsToConsumers , lgv:TakesPartInConsumerDisputeResolution ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:Draft .

lg:LV-R-adr-information-every-trader a lgo:Obligation ;
    rdfs:label "Name the competent consumer ADR entity, whether or not the business takes part"@en ;
    rdfs:comment "Article 19.1(1)-(2) of the Consumer Rights Protection Law binds every seller or service provider, not only those committed to ADR: it names at least one listed dispute resolver for its field, with the resolver's website."@en ;
    lgo:establishedBy lg:LV-PTAL-art19-1-1 , lg:LV-PTAL-art19-1-2 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LV ;
    lgo:appliesWhen lgv:EstablishedInLatvia , lgv:SellsToConsumers ;
    lgo:unless lgv:TakesPartInConsumerDisputeResolution ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:Draft .

lg:LV-R-adr-information-after-complaint a lgo:Obligation ;
    rdfs:label "Point the consumer to ADR after an unsettled complaint"@en ;
    rdfs:comment "Article 19.1(3): when the trader refuses the consumer's claim, it gives the dispute-resolver information in writing or on another durable medium. The law asks for no statement on whether it will take part."@en ;
    lgo:refines lg:EU-R-adr-information-after-complaint ;
    lgo:establishedBy lg:LV-PTAL-art19-1-3 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LV ;
    lgo:appliesWhen lgv:EstablishedInLatvia , lgv:SellsToConsumers ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:Draft .

# --- Media imprint ---

lg:LV-R-media-ownership a lgo:Obligation ;
    rdfs:label "Media service: ownership information easily and directly accessible"@en ;
    rdfs:comment "A media service provider makes the information of Article 6(1) of the European Media Freedom Act (its name and contacts, its direct and indirect owners) easily and directly accessible to its users, for example on its website, and keeps it up to date (5.1 pants of the Press and Media Law)."@en ;
    lgo:establishedBy lg:LV-PRESI-art5-1-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LV ;
    lgo:appliesWhen lgv:EstablishedInLatvia , lgv:JournalisticEditorialContent ;
    lgo:partOfDisclosure lgv:MediaOwnerDisclosure ;
    lgo:requiresDisclosureOf lgv:OwnershipStructure ;
    lgo:reviewStatus lgv:Draft .
