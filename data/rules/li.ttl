@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:   <https://legalgraph.org/id/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Liechtenstein: provider information under Art. 5 ECG (LGBl. 2003 Nr. 133), the
# transposition of Article 5 of the e-Commerce Directive for the EEA. The text is a
# close copy of the Austrian § 5 ECG: the same items, the same "where available"
# qualifiers. The national rules refine the EU family one to one.

lg:LI-R-impressum a lgo:Obligation ;
    rdfs:label "Impressum: name, address and fast electronic contact"@en ;
    rdfs:comment "Every service provider established in Liechtenstein makes its name, geographic address and details for rapid, direct contact, including an e-mail address, permanently and easily accessible (Art. 5 Abs. 1 ECG)."@en ;
    lgo:refines lg:EU-R-service-provider-information ;
    lgo:establishedBy lg:LI-ECG-art5-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LI ;
    lgo:appliesWhen lgv:EstablishedInLiechtenstein , lgv:CommercialDigitalService ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProviderName , lgv:GeographicAddress , lgv:EmailAddress , lgv:RapidContact ;
    lgo:reviewStatus lgv:Draft .

lg:LI-R-impressum-register a lgo:Obligation ;
    rdfs:label "Impressum: commercial register number"@en ;
    lgo:refines lg:EU-R-service-provider-information-register ;
    lgo:establishedBy lg:LI-ECG-art5-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LI ;
    lgo:appliesWhen lgv:EstablishedInLiechtenstein , lgv:CommercialDigitalService , lgv:RegisteredInPublicRegister ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:RegisterEntry ;
    lgo:reviewStatus lgv:Draft .

lg:LI-R-impressum-authorisation a lgo:Obligation ;
    rdfs:label "Impressum: competent supervisory authority"@en ;
    lgo:refines lg:EU-R-service-provider-information-authorisation ;
    lgo:establishedBy lg:LI-ECG-art5-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LI ;
    lgo:appliesWhen lgv:EstablishedInLiechtenstein , lgv:CommercialDigitalService , lgv:ActivityRequiresAuthorisation ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:SupervisoryAuthority ;
    lgo:reviewStatus lgv:Draft .

lg:LI-R-impressum-profession a lgo:Obligation ;
    rdfs:label "Impressum: regulated profession details"@en ;
    lgo:refines lg:EU-R-service-provider-information-profession ;
    lgo:establishedBy lg:LI-ECG-art5-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LI ;
    lgo:appliesWhen lgv:EstablishedInLiechtenstein , lgv:CommercialDigitalService , lgv:RegulatedProfession ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProfessionalBody , lgv:ProfessionalTitle , lgv:ProfessionalRules ;
    lgo:reviewStatus lgv:Draft .

lg:LI-R-impressum-vat a lgo:Obligation ;
    rdfs:label "Impressum: VAT number"@en ;
    lgo:refines lg:EU-R-service-provider-information-vat ;
    lgo:establishedBy lg:LI-ECG-art5-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LI ;
    lgo:appliesWhen lgv:EstablishedInLiechtenstein , lgv:CommercialDigitalService , lgv:HasVatId ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:VatId ;
    lgo:reviewStatus lgv:Draft .

# --- Company details on the website (Directive 2017/1132 Art. 26) ---

lg:LI-R-company-website a lgo:Obligation ;
    rdfs:label "Company details on the website"@en ;
    rdfs:comment "AG, KmAG and GmbH give their firm name and legal form, registered seat, liquidation where it applies, and the register and register number on their websites (Art. 120a(1) PGR)."@en ;
    lgo:refines lg:EU-R-company-website-disclosure ;
    lgo:establishedBy lg:LI-PGR-art120a-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LI ;
    lgo:appliesWhen lgv:EstablishedInLiechtenstein , lgv:LimitedLiabilityCompany ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProviderName , lgv:LegalForm , lgv:GeographicAddress , lgv:RegisterEntry ;
    lgo:reviewStatus lgv:Draft .

# --- Media imprint ---

lg:LI-R-media-imprint a lgo:Obligation ;
    rdfs:label "Media imprint: name of the media owner and editorial seat"@en ;
    rdfs:comment "Every medium distributed in Liechtenstein states the name or firm of its media owner and the seat of its editorial office (Art. 11(1) Mediengesetz)."@en ;
    lgo:establishedBy lg:LI-MEDIENG-art11-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LI ;
    lgo:appliesWhen lgv:EstablishedInLiechtenstein , lgv:JournalisticEditorialContent ;
    lgo:partOfDisclosure lgv:MediaOwnerDisclosure ;
    lgo:requiresDisclosureOf lgv:ProviderName , lgv:GeographicAddress ;
    lgo:reviewStatus lgv:Draft .

lg:LI-R-media-owner-disclosure a lgo:Obligation ;
    rdfs:label "Media owner disclosure: purpose, representatives, ownership and editorial line"@en ;
    rdfs:comment "The owner of a periodical medium publishes its name or firm, business purpose, residence or seat and representative bodies, the ownership, shareholding and voting structure behind it, and its editorial line; for electronic media permanently and easily accessible in the medium itself (Art. 12 Mediengesetz, the counterpart of § 25 of the Austrian MedienG)."@en ;
    lgo:establishedBy lg:LI-MEDIENG-art12-1 , lg:LI-MEDIENG-art12-2 , lg:LI-MEDIENG-art12-4 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LI ;
    lgo:appliesWhen lgv:EstablishedInLiechtenstein , lgv:JournalisticEditorialContent ;
    lgo:partOfDisclosure lgv:MediaOwnerDisclosure ;
    lgo:requiresDisclosureOf lgv:ProviderName , lgv:BusinessPurpose , lgv:GeographicAddress , lgv:AuthorisedRepresentative , lgv:OwnershipStructure , lgv:EditorialLine ;
    lgo:reviewStatus lgv:Draft .

# --- Consumer ADR (Directive 2013/11/EU Art. 13) ---

lg:LI-R-adr-information a lgo:Obligation ;
    rdfs:label "Name the consumer ADR entity on the website and in the terms"@en ;
    rdfs:comment "Art. 18 Abs. 1–2 of the Alternative-Streitbeilegungs-Gesetz (ASTG): a trader committed to ADR names the ADR body or bodies, with their website address, on its website, where it has one, and in its general terms."@en ;
    lgo:refines lg:EU-R-adr-information ;
    lgo:establishedBy lg:LI-ASTG-art18-1, lg:LI-ASTG-art18-2 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LI ;
    lgo:appliesWhen lgv:EstablishedInLiechtenstein , lgv:SellsToConsumers , lgv:TakesPartInConsumerDisputeResolution ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:Draft .

lg:LI-R-adr-information-after-complaint a lgo:Obligation ;
    rdfs:label "Point the consumer to ADR after an unsettled complaint"@en ;
    rdfs:comment "Art. 18 Abs. 3 ASTG: when trader and consumer cannot agree, the trader names the competent ADR body on paper or another durable medium and says whether it will take part."@en ;
    lgo:refines lg:EU-R-adr-information-after-complaint ;
    lgo:establishedBy lg:LI-ASTG-art18-3 ;
    lgo:bearer lgv:Trader ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:LI ;
    lgo:appliesWhen lgv:EstablishedInLiechtenstein , lgv:SellsToConsumers ;
    lgo:partOfDisclosure lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody , lgv:DisputeResolutionStatement ;
    lgo:reviewStatus lgv:Draft .
