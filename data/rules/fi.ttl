@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:   <https://legalgraph.org/id/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Finland: provider information under § 176 of the Act on Electronic Communications Services
# (laki sähköisen viestinnän palveluista 917/2014), the transposition of Article 5 of the e-Commerce
# Directive. It follows the Directive's list.

lg:FI-R-impressum a lgo:Obligation ;
    rdfs:label "Provider information: name, address and e-mail"@en ;
    rdfs:comment "Name, geographic address in the state of establishment, e-mail and other details for rapid, direct and effective contact, easily, directly and continuously available to recipients and authorities (917/2014 § 176(1) 1 kohta)."@en ;
    lgo:refines lg:EU-R-service-provider-information ;
    lgo:establishedBy lg:FI-917-2014-s176-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:FI ;
    lgo:appliesWhen lgv:EstablishedInFinland, lgv:CommercialDigitalService ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProviderName, lgv:GeographicAddress, lgv:EmailAddress, lgv:RapidContact ;
    lgo:reviewStatus lgv:Draft .

lg:FI-R-impressum-register a lgo:Obligation ;
    rdfs:label "Provider information: register entry"@en ;
    rdfs:comment "The trade register or similar public register the provider is entered in, with its business ID (yritys- ja yhteisötunnus) or equivalent identifier (917/2014 § 176(1) 2 kohta)."@en ;
    lgo:refines lg:EU-R-service-provider-information-register ;
    lgo:establishedBy lg:FI-917-2014-s176-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:FI ;
    lgo:appliesWhen lgv:EstablishedInFinland, lgv:CommercialDigitalService, lgv:RegisteredInPublicRegister ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:RegisterEntry ;
    lgo:reviewStatus lgv:Draft .

lg:FI-R-impressum-vat a lgo:Obligation ;
    rdfs:label "Provider information: VAT identification number"@en ;
    lgo:refines lg:EU-R-service-provider-information-vat ;
    lgo:establishedBy lg:FI-917-2014-s176-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:FI ;
    lgo:appliesWhen lgv:EstablishedInFinland, lgv:CommercialDigitalService, lgv:HasVatId ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:VatId ;
    lgo:reviewStatus lgv:Draft .

lg:FI-R-impressum-authorisation a lgo:Obligation ;
    rdfs:label "Provider information: competent licensing authority"@en ;
    lgo:refines lg:EU-R-service-provider-information-authorisation ;
    lgo:establishedBy lg:FI-917-2014-s176-1 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:FI ;
    lgo:appliesWhen lgv:EstablishedInFinland, lgv:CommercialDigitalService, lgv:ActivityRequiresAuthorisation ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:SupervisoryAuthority ;
    lgo:reviewStatus lgv:Draft .

lg:FI-R-impressum-profession a lgo:Obligation ;
    rdfs:label "Provider information: regulated profession details"@en ;
    rdfs:comment "Professional body, professional title and the member state that granted it, and the applicable professional rules with where and how to find them (917/2014 § 176(2))."@en ;
    lgo:refines lg:EU-R-service-provider-information-profession ;
    lgo:establishedBy lg:FI-917-2014-s176-2 ;
    lgo:bearer lgv:DigitalServiceProvider ;
    lgo:deonticType lgv:Must ;
    lgo:appliesIn lg:FI ;
    lgo:appliesWhen lgv:EstablishedInFinland, lgv:CommercialDigitalService, lgv:RegulatedProfession ;
    lgo:partOfDisclosure lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProfessionalBody, lgv:ProfessionalTitle, lgv:ProfessionalRules ;
    lgo:reviewStatus lgv:Draft .
