lg:LU-LOI-2000-08-14-art5-1b-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:LU-LOI-2000-08-14-art5-1b ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:LU-LOI-2000-08-14-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://legilux.public.lu/eli/etat/leg/loi/2000/08/14/n8/consolide/20260510"^^xsd:anyURI ;
    lgo:text "En ce qui concerne les professions réglementées, les informations à fournir comprennent aussi le titre professionnel du prestataire et l'Etat membre dans lequel il a été octroyé, les références de l'ordre professionnel auquel il adhère ainsi qu'une référence aux règles professionnelles applicables et aux moyens d'y avoir accès."@fr .

lg:LU-LOI-2000-08-14-art5-2
    a lgo:Provision ;
    eli:is_part_of lg:LU-LOI-2000-08-14 ;
    lgo:citation "art. 5, alinéa 2, loi du 14 août 2000" ;
    lgo:implements lg:EU-2000-31-art5-2 ;
    lgo:regulates lgv:PriceTransparency ;
    lgo:requiresDisclosureOf lgv:DeliveryCosts , lgv:VatStatus ;
    lgo:reviewStatus lgv:SourceChecked ;
