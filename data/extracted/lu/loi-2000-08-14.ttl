    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://legilux.public.lu/eli/etat/leg/loi/2000/08/14/n8/consolide/20260510"^^xsd:anyURI .

lg:LU-LOI-2000-08-14-art5-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:LU-LOI-2000-08-14-art5-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:LU-LOI-2000-08-14-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://legilux.public.lu/eli/etat/leg/loi/2000/08/14/n8/consolide/20260510"^^xsd:anyURI ;
    lgo:text "(2) Lorsque les services de la société de l’information font mention de prix et conditions de vente ou de réalisation de la prestation, ces derniers doivent être indiqués de manière précise et non équivoque. Il doit aussi être indiqué si toutes les taxes et frais additionnels sont compris dans le prix. Ces dispositions s’appliquent sans préjudice de la législation sur la protection des consommateurs."@fr .

