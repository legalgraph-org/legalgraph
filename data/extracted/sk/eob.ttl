lg:SK-EOB-s4-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SK-EOB-s4-3 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:SK-EOB-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.slov-lex.sk/pravne-predpisy/SK/ZZ/2004/22/"^^xsd:anyURI ;
    lgo:text "(3) Informácie podľa odseku 1 a 2 musia byť príjemcovi služby ľahko a trvalo prístupné a rozlíšiteľné od komerčnej komunikácie."@sk .

