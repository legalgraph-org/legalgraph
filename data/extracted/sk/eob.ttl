lg:SK-EOB-s4-1
    a lgo:Provision ;
    eli:is_part_of lg:SK-EOB ;
    lgo:citation "§ 4 ods. 1 zákona č. 22/2004 Z. z." ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:EmailAddress , lgv:GeographicAddress , lgv:PhoneNumber , lgv:ProviderName , lgv:RapidContact , lgv:RegisterEntry , lgv:SupervisoryAuthority , lgv:TaxId ;
