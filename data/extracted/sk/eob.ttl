lg:SK-EOB
    a lgo:LegalAct ;
    eli:date_document "2003-12-03"^^xsd:date ;
    eli:title "Zákon č. 22/2004 Z. z. o elektronickom obchode a o zmene a doplnení zákona č. 128/2002 Z. z. o štátnej kontrole vnútorného trhu vo veciach ochrany spotrebiteľa a o zmene a doplnení niektorých zákonov v znení zákona č. 284/2002 Z. z."@sk ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:SK ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:SK-EOB-source ;
