    lgo:sourceUrl "https://static.slov-lex.sk/static/SK/ZZ/2015/391/20260101.html"^^xsd:anyURI .

lg:SK-ARS-391-s11-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SK-ARS-391-s11-2 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:SK-ARS-391-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://static.slov-lex.sk/static/SK/ZZ/2015/391/20260101.html"^^xsd:anyURI ;
    lgo:text "(2) Obchodník informuje spotrebiteľa na trvanlivom médiu o príslušných subjektoch alternatívneho riešenia sporov, ak obchodník odpovedal zamietavo na žiadosť podľa odseku 1."@sk .

lg:SK-ARS-391-s11-3
    a lgo:Provision ;
    eli:is_part_of lg:SK-ARS-391 ;
    lgo:citation "§ 11 ods. 3 zákona č. 391/2015 Z. z." ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:SK-ARS-391-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://static.slov-lex.sk/static/SK/ZZ/2015/391/20260101.html"^^xsd:anyURI .

lg:SK-ARS-391-s11-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SK-ARS-391-s11-3 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:SK-ARS-391-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://static.slov-lex.sk/static/SK/ZZ/2015/391/20260101.html"^^xsd:anyURI ;
    lgo:text "(3) Spotrebiteľ má právo podať návrh na začatie alternatívneho riešenia sporu (ďalej len „návrh“) subjektu alternatívneho riešenia sporov, ak obchodník na žiadosť podľa odseku 1 odpovedal zamietavo alebo na ňu neodpovedal do 30 dní odo dňa jej odoslania."@sk .

