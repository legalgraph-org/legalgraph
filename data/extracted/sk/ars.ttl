lg:SK-ARS-391-s11-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SK-ARS-391-s11-1 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:SK-ARS-391-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://static.slov-lex.sk/static/SK/ZZ/2015/391/20260101.html"^^xsd:anyURI ;
    lgo:text "(1) Spotrebiteľ má právo podať obchodníkovi žiadosť o nápravu, ak medzi spotrebiteľom a obchodníkom vznikne spor z uplatnenia práv zo zodpovednosti za vady alebo ak sa spotrebiteľ domnieva, že obchodník porušil iné práva spotrebiteľa."@sk .

