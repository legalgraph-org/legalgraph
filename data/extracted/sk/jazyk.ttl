lg:SK-JAZYK-270-s8-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SK-JAZYK-270-s8-5 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:SK-JAZYK-270-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://static.slov-lex.sk/static/SK/ZZ/1995/270/20220801.html"^^xsd:anyURI ;
    lgo:text "(5) V konaní pred orgánmi a právnickými osobami podľa § 3 ods. 1 o zmluvách upravujúcich záväzkové vzťahy sa uznáva popri znení v štátnom jazyku aj znenie zmlúv v inom oficiálnom jazyku Európskej únie. V prípade vzniku nejasností alebo rozporov platí znenie zmluvy v štátnom jazyku."@sk .

lg:SK-JAZYK-270-s8-6
    a lgo:Provision ;
    eli:is_part_of lg:SK-JAZYK-270 ;
    lgo:citation "§ 8 ods. 6 zákona č. 270/1995 Z. z." ;
    lgo:regulates lgv:StateLanguageUse ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:SK-JAZYK-270-source ;
