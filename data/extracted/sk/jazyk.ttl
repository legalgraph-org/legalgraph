lg:SK-JAZYK-270-s8-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SK-JAZYK-270-s8-1 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:SK-JAZYK-270-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://static.slov-lex.sk/static/SK/ZZ/1995/270/20220801.html"^^xsd:anyURI ;
    lgo:text "(1) V záujme ochrany spotrebiteľa je používanie štátneho jazyka povinné pri označovaní obsahu domáceho či dovážaného tovaru, v návodoch na používanie výrobkov, najmä potravín, liečiv, spotrebnej elektroniky a drogériového tovaru, v podmienkach záruky a v iných informáciách pre spotrebiteľa v rozsahu a za podmienok určených osobitnými predpismi. 13 )"@sk .

lg:SK-JAZYK-270-s8-5
    a lgo:Provision ;
    eli:is_part_of lg:SK-JAZYK-270 ;
    lgo:citation "§ 8 ods. 5 zákona č. 270/1995 Z. z." ;
    lgo:regulates lgv:StateLanguageUse ;
