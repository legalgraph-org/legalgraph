lg:SI-ZISRPS-art32-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SI-ZISRPS-art32-4 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:SI-ZISRPS-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://pisrs.si/pregledPredpisa?id=ZAKO6843"^^xsd:anyURI ;
    lgo:text "(4) Ponudniki, ki se ukvarjajo s spletno prodajo ali spletnimi storitvami, na svoji spletni strani objavijo elektronsko povezavo na platformo za SRPS."@sl .

