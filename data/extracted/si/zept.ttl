lg:SI-ZEPT-art5-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SI-ZEPT-art5-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:SI-ZEPT-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://pisrs.si/pregledPredpisa?id=ZAKO4600"^^xsd:anyURI ;
    lgo:text "(3) Ponudnik storitev mora prejemnikom storitve in pristojnim organom poleg drugih zahtev, v zvezi s podatki v skladu z veljavnimi predpisi jasno in nedvoumno označiti ceno storitve ter navesti, ali je v njej vključen davek, stroški dobave in morebitne druge dajatve."@sl .

