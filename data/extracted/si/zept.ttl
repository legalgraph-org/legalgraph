lg:SI-ZEPT-art5-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SI-ZEPT-art5-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:SI-ZEPT-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://pisrs.si/pregledPredpisa?id=ZAKO4600"^^xsd:anyURI ;
    lgo:text "(2) Ponudnik storitev mora dostop do podatkov iz prejšnjega odstavka omogočiti s povezavami, ki jih objavi na svoji glavni spletni strani."@sl .

lg:SI-ZEPT-art5-3
    a lgo:Provision ;
    eli:is_part_of lg:SI-ZEPT ;
