lg:SI-ZEKOM-2-art225-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SI-ZEKOM-2-art225-2 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:SI-ZEKOM-2-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://pisrs.si/pregledPredpisa?id=ZAKO8611"^^xsd:anyURI ;
    lgo:text "(2) Ne glede na določbe prejšnjega odstavka je dovoljeno tehnično shranjevanje podatkov ali dostop do njih izključno zaradi prenosa sporočila po elektronskem komunikacijskem omrežju, ali če je to nujno potrebno za zagotovitev storitve informacijske družbe, ki jo naročnik ali uporabnik izrecno zahtevata."@sl .

lg:SI-ZEKOM-2-art225-3
    a lgo:Provision ;
    eli:is_part_of lg:SI-ZEKOM-2 ;
    lgo:citation "225. člen, 3. odst. ZEKom-2" ;
    lgo:regulates lgv:Consent ;
