lg:DK-BEK1148
    a lgo:LegalAct ;
    eli:date_document "2011-12-09"^^xsd:date ;
    eli:title "Bekendtgørelse om krav til information og samtykke ved lagring af eller adgang til oplysninger i slutbrugeres terminaludstyr"@da ;
    lgo:actType lgv:StatutoryInstrument ;
    lgo:jurisdiction lg:DK ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DK-BEK1148-source ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2011/1148"^^xsd:anyURI .

lg:DK-BEK1148-s3-1
    a lgo:Provision ;
    eli:is_part_of lg:DK-BEK1148 ;
    lgo:citation "BEK nr. 1148 § 3, stk. 1" ;
    lgo:implements lg:EU-2002-58-art5-3 ;
    lgo:regulates lgv:Consent , lgv:TerminalEquipmentAccess ;
    lgo:requiresDisclosureOf lgv:Consent , lgv:CookiePurposes ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DK-BEK1148-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2011/1148"^^xsd:anyURI .

lg:DK-BEK1148-s3-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DK-BEK1148-s3-1 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:DK-BEK1148-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2011/1148"^^xsd:anyURI ;
    lgo:text "Fysiske eller juridiske personer må ikke lagre oplysninger eller opnå adgang til oplysninger, der allerede er lagret, i en slutbrugers terminaludstyr eller lade tredjepart lagre oplysninger eller opnå adgang til oplysninger, hvis slutbrugeren ikke giver samtykke hertil efter at have modtaget fyldestgørende information om lagringen af eller adgangen til oplysningerne."@da .

lg:DK-BEK1148-s3-2
    a lgo:Provision ;
    eli:is_part_of lg:DK-BEK1148 ;
    lgo:citation "BEK nr. 1148 § 3, stk. 2" ;
    lgo:implements lg:EU-2002-58-art5-3 ;
    lgo:regulates lgv:Consent ;
    lgo:requiresDisclosureOf lgv:ConsentWithdrawalMechanism , lgv:ControllerIdentity , lgv:CookiePurposes ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DK-BEK1148-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2011/1148"^^xsd:anyURI .

lg:DK-BEK1148-s3-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DK-BEK1148-s3-2 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:DK-BEK1148-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2011/1148"^^xsd:anyURI ;
    lgo:text """Information, jf. stk. 1, er fyldestgørende, når den som minimum
1) fremstår i et klart, præcist og letforståeligt sprog eller tilsvarende billedskrift,
2) indeholder oplysning om formål med lagringen af eller adgangen til oplysninger i slutbrugerens terminaludstyr,
3) indeholder oplysninger, der identificerer enhver fysisk eller juridisk person, der foranstalter lagringen af eller adgangen til oplysningerne,
4) indeholder en umiddelbart tilgængelig adgang for slutbrugeren til at afslå samtykke eller tilbagekalde samtykke til lagringen af eller adgangen til oplysninger samt en klar, præcis og letforståelig vejledning om, hvordan slutbrugeren anvender en sådan adgang og
5) er umiddelbart tilgængelig for slutbrugeren ved samlet og tydeligt at blive meddelt denne. Desuden skal information, når der sker lagring af eller adgang til oplysninger i slutbrugerens terminaludstyr igennem en informations- og indholdstjeneste, være vedvarende tilgængelig for slutbrugeren ved en direkte og tydeligt markeret adgang på den pågældende informations- og indholdstjeneste."""@da .

lg:DK-BEK1148-s4-1
    a lgo:Provision ;
    eli:is_part_of lg:DK-BEK1148 ;
    lgo:citation "BEK nr. 1148 § 4, stk. 1" ;
    lgo:implements lg:EU-2002-58-art5-3 ;
    lgo:regulates lgv:StrictlyNecessaryAccess , lgv:TransmissionOnlyAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DK-BEK1148-source ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2011/1148"^^xsd:anyURI .

lg:DK-BEK1148-s4-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DK-BEK1148-s4-1 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:DK-BEK1148-source ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2011/1148"^^xsd:anyURI ;
    lgo:text """Uanset § 3 kan fysiske eller juridiske personer lagre oplysninger eller opnå adgang til oplysninger, der allerede er lagret, i en slutbrugers terminaludstyr, hvis
1) lagringen af eller adgangen til oplysninger alene sker med det formål at overføre kommunikation via et elektronisk kommunikationsnet, eller
2) lagringen af eller adgangen til oplysninger er påkrævet for at sætte tjenesteyderen af en informationssamfundstjeneste, som slutbrugeren udtrykkelig har anmodet om, i stand til at levere denne tjeneste."""@da .

lg:DK-BEK1148-s4-2
    a lgo:Provision ;
    eli:is_part_of lg:DK-BEK1148 ;
    lgo:citation "BEK nr. 1148 § 4, stk. 2" ;
    lgo:defines lgv:StrictlyNecessaryAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DK-BEK1148-source ;
    lgo:sourceElement "/law/section[2]/paragraph[2]" ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2011/1148"^^xsd:anyURI .

lg:DK-BEK1148-s4-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DK-BEK1148-s4-2 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:DK-BEK1148-source ;
    lgo:sourceElement "/law/section[2]/paragraph[2]" ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2011/1148"^^xsd:anyURI ;
    lgo:text "Lagring af eller adgang til oplysninger i en slutbrugers terminaludstyr er påkrævet, jf. stk. 1, nr. 2, hvis lagringen af eller adgangen til oplysninger er en teknisk forudsætning for at kunne levere en tjeneste, der fungerer i overensstemmelse med tjenestens formål."@da .

