lg:DK-BEK1148-s5-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DK-BEK1148-s5-2 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:DK-BEK1148-source ;
    lgo:sourceElement "/law/section[3]/paragraph[2]" ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2011/1148"^^xsd:anyURI ;
    lgo:text "Der kan pålægges selskaber m.v. (juridiske personer) strafansvar efter reglerne i straffelovens 5. kapitel."@da .

