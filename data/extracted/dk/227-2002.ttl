lg:DK-227-2002-s8-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DK-227-2002-s8-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:DK-227-2002-source ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://www.retsinformation.dk/eli/lta/2002/227"^^xsd:anyURI ;
    lgo:text "§ 8. Når der gives oplysning om pris for en informationssamfundstjeneste, skal prisen angives klart og tydeligt. Det skal fremgå, hvorvidt prisen er inklusive afgifter og leveringsomkostninger."@da .

