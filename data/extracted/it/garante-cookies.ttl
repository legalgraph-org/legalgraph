lg:IT-GARANTE-231-2021
    a lgo:Guidance ;
    eli:date_document "2021-06-10"^^xsd:date ;
    eli:title "Linee guida cookie e altri strumenti di tracciamento (Provvedimento n. 231 del 10 giugno 2021)"@it ;
    lgo:actType lgv:Guidelines ;
    lgo:jurisdiction lg:IT ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IT-GARANTE-231-2021-source ;
