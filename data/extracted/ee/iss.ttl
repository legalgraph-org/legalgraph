lg:EE-ISSA-s4-1
    a lgo:Provision ;
    eli:is_part_of lg:EE-ISSA ;
    lgo:citation "§ 4 lõige 1 InfoTS" ;
    lgo:implements lg:EU-2000-31-art5-1 , lg:EU-2000-31-art5-2 ;
    lgo:regulates lgv:PriceTransparency , lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:DeliveryCosts , lgv:EmailAddress , lgv:GeographicAddress , lgv:LicenceDetails , lgv:ProviderName , lgv:RapidContact , lgv:RegisterEntry , lgv:VatId , lgv:VatStatus ;
