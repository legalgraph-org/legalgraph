lg:CZ-OZ-s435-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CZ-OZ-s435-1 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:CZ-OZ-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.zakonyprolidi.cz/cs/2012-89"^^xsd:anyURI ;
    lgo:text "(1) Každý podnikatel musí uvádět na obchodních listinách a v rámci informací zpřístupňovaných veřejnosti prostřednictvím dálkového přístupu své jméno a sídlo. Podnikatel zapsaný v obchodním rejstříku uvede na obchodní listině též údaj o tomto zápisu včetně oddílu a vložky; podnikatel zapsaný v jiném veřejném rejstříku uvede údaj o svém zápisu do tohoto rejstříku; podnikatel nezapsaný ve veřejném rejstříku uvede údaj o svém zápisu do jiné evidence. Byl-li podnikateli přidělen identifikující údaj, uvede i ten."@cs .

