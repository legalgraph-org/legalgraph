lg:CZ-ZOK-s7-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CZ-ZOK-s7-3 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:CZ-ZOK-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.zakonyprolidi.cz/cs/2012-90"^^xsd:anyURI ;
    lgo:text "(3) Zřídí-li společnost s ručením omezeným internetové stránky, vztahuje se na ni ustanovení odstavce 2 obdobně."@cs .

lg:CZ-ZOK-s7-4
    a lgo:Provision ;
    eli:is_part_of lg:CZ-ZOK ;
    lgo:citation "§ 7 odst. 4 zákona č. 90/2012 Sb." ;
    lgo:regulates lgv:ProviderIdentification ;
