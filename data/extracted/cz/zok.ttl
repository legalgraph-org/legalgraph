lg:CZ-ZOK-s7-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CZ-ZOK-s7-4 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:CZ-ZOK-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.zakonyprolidi.cz/cs/2012-90"^^xsd:anyURI ;
    lgo:text "(4) Odstavce 1 až 3 se použijí obdobně ve vztahu k závodu zahraniční kapitálové společnosti nebo zahraničního družstva nebo k jeho pobočce. Údaj o zápisu zahraniční osoby do evidence podnikatelů ve státě, jehož právem se zahraniční osoba řídí, se nevyžaduje, ledaže toto právo zápis do takové evidence ukládá nebo umožňuje."@cs .

