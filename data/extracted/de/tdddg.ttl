lg:DE-TDDDG-s1-3
    a lgo:Provision ;
    eli:is_part_of lg:DE-TDDDG ;
    lgo:citation "§ 1 Abs. 3 TDDDG" ;
    lgo:defines lgv:TdddgScope ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DE-TDDDG-source ;
    lgo:sourceElement "/dokumente/norm[4]/textdaten[1]/text[1]/Content[1]/P[3]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/ttdsg/__1.html"^^xsd:anyURI .

lg:DE-TDDDG-s1-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-TDDDG-s1-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:DE-TDDDG-source ;
    lgo:sourceElement "/dokumente/norm[4]/textdaten[1]/text[1]/Content[1]/P[3]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/ttdsg/__1.html"^^xsd:anyURI ;
    lgo:text "(3) Diesem Gesetz unterliegen alle Unternehmen und Personen, die im Geltungsbereich dieses Gesetzes eine Niederlassung haben oder Dienstleistungen erbringen oder daran mitwirken oder Waren auf dem Markt bereitstellen. § 3 des Digitale-Dienste-Gesetzes bleibt unberührt."@de .

lg:DE-TDDDG-s25-1
    a lgo:Provision ;
    eli:is_part_of lg:DE-TDDDG ;
    lgo:citation "§ 25 Abs. 1 TDDDG" ;
    lgo:implements lg:EU-2002-58-art5-3 ;
    lgo:refersTo lg:EU-2016-679-art12-1 , lg:EU-2016-679-art13-1 , lg:EU-2016-679-art4-11 , lg:EU-2016-679-art7-1 ;
    lgo:regulates lgv:TerminalEquipmentAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DE-TDDDG-source ;
    lgo:sourceElement "/dokumente/norm[38]/textdaten[1]/text[1]/Content[1]/P[1]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/ttdsg/__25.html"^^xsd:anyURI ;
    lgo:takesPrecedenceOver lg:EU-2016-679-art6-1 .

lg:DE-TDDDG-s25-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-TDDDG-s25-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:DE-TDDDG-source ;
    lgo:sourceElement "/dokumente/norm[38]/textdaten[1]/text[1]/Content[1]/P[1]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/ttdsg/__25.html"^^xsd:anyURI ;
    lgo:text "(1) Die Speicherung von Informationen in der Endeinrichtung des Endnutzers oder der Zugriff auf Informationen, die bereits in der Endeinrichtung gespeichert sind, sind nur zulässig, wenn der Endnutzer auf der Grundlage von klaren und umfassenden Informationen eingewilligt hat. Die Information des Endnutzers und die Einwilligung haben gemäß der Verordnung (EU) 2016/679 zu erfolgen."@de .

lg:DE-TDDDG-s25-2
    a lgo:Provision ;
    eli:is_part_of lg:DE-TDDDG ;
    lgo:citation "§ 25 Abs. 2 TDDDG" ;
    lgo:defines lgv:StrictlyNecessaryAccess , lgv:TransmissionOnlyAccess ;
    lgo:implements lg:EU-2002-58-art5-3 ;
    lgo:regulates lgv:TerminalEquipmentAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DE-TDDDG-source ;
    lgo:sourceElement "/dokumente/norm[38]/textdaten[1]/text[1]/Content[1]/P[2]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/ttdsg/__25.html"^^xsd:anyURI .

lg:DE-TDDDG-s25-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-TDDDG-s25-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:DE-TDDDG-source ;
    lgo:sourceElement "/dokumente/norm[38]/textdaten[1]/text[1]/Content[1]/P[2]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/ttdsg/__25.html"^^xsd:anyURI ;
    lgo:text """(2) Die Einwilligung nach Absatz 1 ist nicht erforderlich,
1. wenn der alleinige Zweck der Speicherung von Informationen in der Endeinrichtung des Endnutzers oder der alleinige Zweck des Zugriffs auf bereits in der Endeinrichtung des Endnutzers gespeicherte Informationen die Durchführung der Übertragung einer Nachricht über ein öffentliches Telekommunikationsnetz ist oder
2. wenn die Speicherung von Informationen in der Endeinrichtung des Endnutzers oder der Zugriff auf bereits in der Endeinrichtung des Endnutzers gespeicherte Informationen unbedingt erforderlich ist, damit der Anbieter eines digitalen Dienstes einen vom Nutzer ausdrücklich gewünschten digitalen Dienst zur Verfügung stellen kann."""@de .

lg:DE-TDDDG-s26-1
    a lgo:Provision ;
    eli:is_part_of lg:DE-TDDDG ;
    lgo:citation "§ 26 Abs. 1 TDDDG" ;
    lgo:refersTo lg:DE-TDDDG-s25-1 ;
    lgo:regulates lgv:ConsentManagementService ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DE-TDDDG-source ;
    lgo:sourceElement "/dokumente/norm[39]/textdaten[1]/text[1]/Content[1]/P[1]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/ttdsg/__26.html"^^xsd:anyURI .

lg:DE-TDDDG-s26-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-TDDDG-s26-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:DE-TDDDG-source ;
    lgo:sourceElement "/dokumente/norm[39]/textdaten[1]/text[1]/Content[1]/P[1]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/ttdsg/__26.html"^^xsd:anyURI ;
    lgo:text """(1) Dienste zur Verwaltung von nach § 25 Absatz 1 erteilten Einwilligungen, die
1. nutzerfreundliche und wettbewerbskonforme Verfahren und technische Anwendungen zur Einholung und Verwaltung der Einwilligung haben,
2. kein wirtschaftliches Eigeninteresse an der Erteilung der Einwilligung und an den verwalteten Daten haben und unabhängig von Unternehmen sind, die ein solches Interesse haben können,
3. die personenbezogenen Daten und die Informationen über die Einwilligungsentscheidungen für keine anderen Zwecke als die Einwilligungsverwaltung verarbeiten und
4. ein Sicherheitskonzept vorlegen, das eine Bewertung der Qualität und Zuverlässigkeit des Dienstes und der technischen Anwendungen ermöglicht und aus dem sich ergibt, dass der Dienst sowohl technisch als auch organisatorisch die rechtlichen Anforderungen an den Datenschutz und die Datensicherheit, die sich insbesondere aus der Verordnung (EU) 2016/679 ergeben, erfüllt,
können von einer unabhängigen Stelle nach Maßgabe der Rechtsverordnung nach Absatz 2 anerkannt werden."""@de .

lg:DE-TDDDG-s28-1-13
    a lgo:Provision ;
