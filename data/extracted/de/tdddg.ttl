lg:DE-TDDDG-s28-1-13-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-TDDDG-s28-1-13 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:DE-TDDDG-source ;
    lgo:sourceElement "/dokumente/norm[42]/textdaten[1]/text[1]/Content[1]/P[1]/DL[1]/DD[13]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/ttdsg/__28.html"^^xsd:anyURI ;
    lgo:text "entgegen § 25 Absatz 1 Satz 1 eine Information speichert oder auf eine Information zugreift."@de .

lg:DE-TDDDG-s28-2
    a lgo:Provision ;
    eli:is_part_of lg:DE-TDDDG ;
    lgo:citation "§ 28 Abs. 2 TDDDG" ;
    lgo:penalises lg:DE-TDDDG-s25-1 ;
    lgo:refersTo lg:DE-TDDDG-s28-1-13 ;
    lgo:reviewStatus lgv:SourceChecked ;
