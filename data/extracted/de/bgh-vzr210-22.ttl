lg:DE-BGH-2023-0707-p9-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-BGH-2023-0707-p9-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:DE-BGH-2023-0707-source ;
    lgo:sourceElement "/law/section[3]/paragraph[2]" ;
    lgo:sourceUrl "https://www.bundesgerichtshof.de/SharedDocs/Entscheidungen/DE/Zivilsenate/V_ZS/2023/V_ZR_210-22.pdf?__blob=publicationFile&v=1"^^xsd:anyURI ;
    lgo:text "(1) Die ladungsfähige Anschrift ist nicht jede Anschrift, unter der eine Zustellung an den Zustelladressaten möglich ist, sondern eine solche, unter der der Zustelladressat tatsächlich zu erreichen ist und die ernsthafte Möglichkeit der Übergabe eines zuzustellenden Schriftstückes an ihn selbst besteht."@de .

