lg:DE-BGH-2023-0707-p5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-BGH-2023-0707-p5 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:DE-BGH-2023-0707-source ;
    lgo:sourceElement "/law/section[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.bundesgerichtshof.de/SharedDocs/Entscheidungen/DE/Zivilsenate/V_ZS/2023/V_ZR_210-22.pdf?__blob=publicationFile&v=1"^^xsd:anyURI ;
    lgo:text "Eine ordnungsgemäße Klageerhebung setzt grundsätzlich die Angabe der ladungsfähigen Anschrift des Klägers voraus; die Adresse eines Postdienstleisters, der lediglich mit der Weiterleitung der an den Kläger gerichteten Post beauftragt ist, reicht hierfür nicht aus."@de .

lg:DE-BGH-2023-0707-p9-1
    a lgo:Provision ;
    eli:is_part_of lg:DE-BGH-2023-0707 ;
    lgo:citation "BGH V ZR 210/22, Rn. 9" ;
