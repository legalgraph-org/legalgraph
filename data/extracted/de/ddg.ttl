lg:DE-DDG-s33-6-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-DDG-s33-6-3 ;
    lgo:retrievedOn "2026-10-31"^^xsd:date ;
    lgo:sourceDocument lg:DE-DDG-source ;
    lgo:sourceElement "/dokumente/norm[48]/textdaten[1]/text[1]/Content[1]/P[8]/DL[1]/DD[3]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/ddg/__33.html"^^xsd:anyURI ;
    lgo:text "in den übrigen Fällen des Absatzes 2 mit einer Geldbuße bis zu fünfzigtausend Euro."@de .

lg:DE-DDG-s5-1
    a lgo:Provision ;
    eli:is_part_of lg:DE-DDG ;
    lgo:citation "§ 5 Abs. 1 DDG" ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:AudiovisualRegulator , lgv:AuthorisedRepresentative , lgv:EconomicIdNumber , lgv:EmailAddress , lgv:GeographicAddress , lgv:LegalForm , lgv:LiquidationStatus , lgv:ProfessionalBody , lgv:ProfessionalRules , lgv:ProfessionalTitle , lgv:ProviderName , lgv:RapidContact , lgv:RegisterEntry , lgv:ShareCapital , lgv:SupervisoryAuthority , lgv:VatId ;
    lgo:reviewStatus lgv:SourceChecked ;
