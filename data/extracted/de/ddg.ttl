lg:DE-DDG-s3-1
    a lgo:Provision ;
    eli:is_part_of lg:DE-DDG ;
    lgo:citation "§ 3 Abs. 1 DDG" ;
    lgo:implements lg:EU-2000-31-art3-1 ;
