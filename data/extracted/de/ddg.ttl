    lgo:sourceUrl "https://www.gesetze-im-internet.de/ddg/__33.html"^^xsd:anyURI ;
    lgo:text "entgegen § 5 Absatz 1 eine Information nicht, nicht richtig oder nicht vollständig verfügbar hält,"@de .

