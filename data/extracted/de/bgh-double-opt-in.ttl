lg:DE-BGH-2011-0210
    a lgo:CourtDecision ;
    eli:date_document "2011-02-10"^^xsd:date ;
    eli:title "Bundesgerichtshof, Urteil vom 10. Februar 2011 – I ZR 164/09 (Double-opt-in-Verfahren)"@de ;
    lgo:actType lgv:Judgment ;
    lgo:jurisdiction lg:DE ;
