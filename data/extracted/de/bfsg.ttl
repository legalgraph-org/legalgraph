lg:DE-BFSG
    a lgo:LegalAct ;
    eli:date_document "2021-07-16"^^xsd:date ;
    eli:title "Gesetz zur Umsetzung der Richtlinie (EU) 2019/882 des Europäischen Parlaments und des Rates über die Barrierefreiheitsanforderungen für Produkte und Dienstleistungen"@de ;
    eli:transposes lg:EU-2019-882 ;
