lg:DE-VSBG
    a lgo:LegalAct ;
    eli:date_document "2016-02-19"^^xsd:date ;
    eli:title "Gesetz über die alternative Streitbeilegung in Verbrauchersachen"@de ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:DE ;
