lg:DE-LGM-2023-0330-tenor-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-LGM-2023-0330-tenor-2 ;
    lgo:retrievedOn "2026-11-04"^^xsd:date ;
    lgo:sourceDocument lg:DE-LGM-2023-0330-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.gesetze-bayern.de/Content/Document/Y-300-Z-GRURRS-B-2023-N-6354"^^xsd:anyURI ;
    lgo:text "2. Es wird festgestellt, dass der Beklagte keinen Anspruch gegen den Kläger auf Zahlung eines Schmerzensgeldes aufgrund des Einbindens von Google-Schriftarten auf der Website… hat, wie behauptet mit Schreiben des Beklagten an den Kläger vom 20.10.2022."@de .
