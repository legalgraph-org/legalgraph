lg:DE-OLGK-2026-0303
    a lgo:CourtDecision ;
    eli:date_document "2026-03-03"^^xsd:date ;
    eli:title "Oberlandesgericht Karlsruhe, Urteil vom 03.03.2026 – 14 UKl 2/24"@de ;
