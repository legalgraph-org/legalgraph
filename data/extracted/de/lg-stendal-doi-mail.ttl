lg:DE-LGST-2021-0512-tenor-1
    a lgo:Provision ;
    eli:is_part_of lg:DE-LGST-2021-0512 ;
    lgo:applies lg:DE-UWG-s7-2 ;
    lgo:citation "LG Stendal 22 S 87/20, Tenor 1" ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DE-LGST-2021-0512-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.landesrecht.sachsen-anhalt.de/bsst/document/NJRE001485771"^^xsd:anyURI .

lg:DE-LGST-2021-0512-tenor-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-LGST-2021-0512-tenor-1 ;
    lgo:retrievedOn "2026-11-06"^^xsd:date ;
    lgo:sourceDocument lg:DE-LGST-2021-0512-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.landesrecht.sachsen-anhalt.de/bsst/document/NJRE001485771"^^xsd:anyURI ;
    lgo:text "Die Beklagte hat es bei Vermeidung eines vom Gericht für jeden Fall der Zuwiderhandlung festzusetzenden Ordnungsgeldes, und für den Fall, dass dieses nicht beigetrieben werden kann, einer Ordnungshaft oder einer Ordnungshaft bis zu sechs Monaten, zu vollziehen an der Geschäftsführung, (Ordnungsgeld im Einzelfall höchstens 250.000,00 Euro, Ordnungshaft insgesamt höchstens 2 Jahre), zu unterlassen, an den Kläger, insbesondere zur Aufnahme eines geschäftlichen Kontakts, Werbeschreiben per E-Mail zu senden und/oder senden zu lassen, ohne dass der Kläger zuvor ausdrücklich in die Versendung eingewilligt hat."@de .

lg:DE-LGST-2021-0512-tenor-2
    a lgo:Provision ;
    eli:is_part_of lg:DE-LGST-2021-0512 ;
