lg:DE-LGST-2021-0512
    a lgo:CourtDecision ;
    eli:date_document "2021-05-12"^^xsd:date ;
    eli:title "Landgericht Stendal, Urteil vom 12. Mai 2021 – 22 S 87/20 (Werbung in der Bestätigungsmail)"@de ;
    lgo:actType lgv:Judgment ;
