lg:DE-EGBGB-a246a-s1-1
    a lgo:Provision ;
    eli:is_part_of lg:DE-EGBGB ;
    lgo:citation "Art. 246a § 1 Abs. 1 EGBGB" ;
    lgo:regulates lgv:PreContractInformation ;
    lgo:requiresDisclosureOf lgv:CodesOfConduct , lgv:CommercialGuarantee , lgv:CommunicationCosts , lgv:ComplaintAddress , lgv:ContractDuration , lgv:DeliveryCosts , lgv:Deposit , lgv:DigitalProductInformation , lgv:DisputeResolutionStatement , lgv:EmailAddress , lgv:GeographicAddress , lgv:LegalGuarantee , lgv:MainCharacteristics , lgv:PaymentAndDeliveryTerms , lgv:PersonalisedPricing , lgv:PhoneNumber , lgv:ProviderName , lgv:RepairInformation , lgv:SoftwareUpdatePeriod , lgv:SubscriptionCosts , lgv:TotalPrice ;
