lg:DE-PAngV-s11-1
    a lgo:Provision ;
    eli:is_part_of lg:DE-PAngV ;
    lgo:citation "§ 11 Abs. 1 PAngV" ;
    lgo:implements lg:EU-1998-6-art6a-1 , lg:EU-1998-6-art6a-2 ;
    lgo:regulates lgv:PriceTransparency ;
    lgo:requiresDisclosureOf lgv:PriorPrice ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:DE-PAngV-source ;
    lgo:sourceElement "/dokumente/norm[16]/textdaten[1]/text[1]/Content[1]/P[1]" ;
