lg:DE-EinwV
    a lgo:LegalAct ;
    eli:date_document "2025-02-06"^^xsd:date ;
    eli:title "Verordnung über Dienste zur Einwilligungsverwaltung nach dem Telekommunikation-Digitale-Dienste-Datenschutz-Gesetz"@de ;
    lgo:actType lgv:Ordinance ;
    lgo:jurisdiction lg:DE ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:shortName "EinwV" ;
    lgo:sourceDocument lg:DE-EinwV-source ;
