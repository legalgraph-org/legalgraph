    lgo:sourceElement "/dokumente/norm[10]/textdaten[1]/text[1]/Content[1]/P[3]" ;
    lgo:sourceUrl "https://www.gesetze-im-internet.de/elektrog_2015/__6.html"^^xsd:anyURI ;
    lgo:text "(3) Jeder Hersteller ist verpflichtet, beim Anbieten und auf Rechnungen seine Registrierungsnummer anzugeben."@de .

