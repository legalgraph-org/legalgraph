lg:DE-LGM-2022-0120
    a lgo:CourtDecision ;
    eli:date_document "2022-01-20"^^xsd:date ;
    eli:title "Landgericht München I, Endurteil vom 20. Januar 2022 – 3 O 17493/20"@de ;
