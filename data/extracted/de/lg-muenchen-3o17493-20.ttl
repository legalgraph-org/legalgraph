lg:DE-LGM-2022-0120-tenor-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:DE-LGM-2022-0120-tenor-3 ;
    lgo:retrievedOn "2026-11-04"^^xsd:date ;
    lgo:sourceDocument lg:DE-LGM-2022-0120-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.gesetze-bayern.de/Content/Document/Y-300-Z-GRURRS-B-2022-N-612"^^xsd:anyURI ;
    lgo:text "3. Die Beklagte wird verurteilt, an den Kläger 100,00 € zuzüglich Zinsen hieraus in Höhe von 5 Prozentpunkten über dem Basiszinssatz seit dem 28.01.2021 zu bezahlen."@de .
