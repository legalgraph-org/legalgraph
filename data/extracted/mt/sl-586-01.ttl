lg:MT-SL-586-01-r5-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:MT-SL-586-01-r5-1 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:MT-SL-586-01-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://legislation.mt/eli/sl/586.1/eng"^^xsd:anyURI ;
    lgo:text "(1) The storing of information or the gaining of access to information stored in the terminal equipment of a subscriber or user shall only be allowed on condition that the subscriber or user concerned has given his consent, having been provided by the controller with clear and comprehensive information in terms of article 19 of the Act."@en .

lg:MT-SL-586-01-r5-2
    a lgo:Provision ;
    eli:is_part_of lg:MT-SL-586-01 ;
    lgo:citation "Reg. 5(2) S.L. 586.01 (MT)" ;
    lgo:regulates lgv:StrictlyNecessaryAccess , lgv:TransmissionOnlyAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:MT-SL-586-01-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://legislation.mt/eli/sl/586.1/eng"^^xsd:anyURI .

lg:MT-SL-586-01-r5-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:MT-SL-586-01-r5-2 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:MT-SL-586-01-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://legislation.mt/eli/sl/586.1/eng"^^xsd:anyURI ;
    lgo:text "(2) The requirements contained in this regulation shall not prevent the technical storage or access for the sole purpose of carrying out or facilitating the transmission of a communication over an electronic communications network or as may be strictly necessary in order for the service provider to provide an information society service explicitly requested by the subscriber or user to provide the service."@en .

