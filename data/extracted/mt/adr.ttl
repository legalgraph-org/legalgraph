lg:MT-SL-378-18-r14-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:MT-SL-378-18-r14-2 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:MT-SL-378-18-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://legislation.mt/eli/sl/378.18/eng"^^xsd:anyURI ;
    lgo:text """(2) Where a dispute between a consumer and a trader cannot be settled further to a complaint submitted directly by the consumer to the trader, the trader shall provide the consumer with the information referred to in sub-regulation (1) specifying whether he makes use of the relevant ADR entity to settle the dispute:
Provided that such information shall be provided on paper or on another durable medium."""@en .

