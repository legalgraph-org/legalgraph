lg:MT-CAP426-art8C-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:MT-CAP426-art8C-2 ;
    lgo:retrievedOn "2026-11-03"^^xsd:date ;
    lgo:sourceDocument lg:MT-CAP426-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://legislation.mt/eli/cap/426/eng"^^xsd:anyURI ;
    lgo:text "(2) Where the service provider refers to prices, such prices shall be indicated clearly and unambiguously and, in particular, shall indicate whether they are inclusive of any tax, however so described, and delivery costs."@en .

