lg:MT-CAP386-art6-9-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:MT-CAP386-art6-9 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:MT-CAP386-source ;
    lgo:sourceElement "/law/section[1]/paragraph[9]" ;
    lgo:sourceUrl "https://legislation.mt/eli/cap/386/eng"^^xsd:anyURI ;
    lgo:text "(9) If default is made in complying with the provisions of sub-articles (1) to (6) and of sub-article (8) every officer of the commercial partnership who is in default shall be liable to a penalty."@en .

