lg:FI-917-2014-s176-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:FI-917-2014-s176-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:FI-917-2014-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.finlex.fi/fi/laki/ajantasa/2014/20140917"^^xsd:anyURI ;
    lgo:text "Jos tietoyhteiskunnan palvelua tarjottaessa annetaan tietoja tavaroiden tai palvelujen hinnoista, ne on annettava selkeästi ja yksiselitteisesti. Tiedoista on käytävä ilmi, sisältyvätkö vero ja toimituskulut hintaan."@fi .

