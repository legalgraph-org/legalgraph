    a lgo:Provision ;
    eli:is_part_of lg:SE-ARL ;
    lgo:citation "11 § andra stycket lagen om alternativ tvistlösning" ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:SE-ARL-source ;
