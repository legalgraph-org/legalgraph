lg:SE-LEK-2022-482-k9s28-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SE-LEK-2022-482-k9s28-2 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:SE-LEK-2022-482-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/svensk-forfattningssamling/lag-2022482-om-elektronisk-kommunikation_sfs-2022-482/"^^xsd:anyURI ;
    lgo:text """Trots att samtycke inte har lämnats är sådan lagring eller åtkomst tillåten som
1. behövs för överföring av ett elektroniskt meddelande via ett elektroniskt kommunikationsnät, eller
2. är nödvändig för tillhandahållande av en tjänst på uttrycklig begäran av användaren eller abonnenten."""@sv .

