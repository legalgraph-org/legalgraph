lg:SE-ABL-k28-s5-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SE-ABL-k28-s5-1 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:SE-ABL-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/svensk-forfattningssamling/aktiebolagslag-2005551_sfs-2005-551/"^^xsd:anyURI ;
    lgo:text "Ett aktiebolags brev, fakturor, orderblanketter och webbplatser ska ange bolagets företagsnamn, den ort där styrelsen har sitt säte samt bolagets organisationsnummer enligt lagen (1974:174) om identitetsbeteckning för juridiska personer m.fl. Om bolaget har gått i likvidation, ska också detta anges."@sv .

lg:SE-ABL-k28-s5-2
    a lgo:Provision ;
    eli:is_part_of lg:SE-ABL ;
    lgo:citation "28 kap. 5 § andra stycket aktiebolagslagen" ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:SE-ABL-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/svensk-forfattningssamling/aktiebolagslag-2005551_sfs-2005-551/"^^xsd:anyURI .

lg:SE-ABL-k28-s5-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SE-ABL-k28-s5-2 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:SE-ABL-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/svensk-forfattningssamling/aktiebolagslag-2005551_sfs-2005-551/"^^xsd:anyURI ;
    lgo:text "Om det finns särskilda skäl, får Bolagsverket tillåta att ett aktiebolag inte lämnar uppgift om bolagets företagsnamn på sina webbplatser. I så fall ska uppgifter i stället lämnas om att bolaget är ett aktiebolag och om bolagskategori. Ett sådant tillstånd ska begränsas till viss tid och får förenas med villkor."@sv .

