lg:SE-SFS-2002-562-s8-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:SE-SFS-2002-562-s8-1 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:SE-SFS-2002-562-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/svensk-forfattningssamling/lag-2002562-om-elektronisk-handel-och-andra_sfs-2002-562/"^^xsd:anyURI ;
    lgo:text """När en tjänsteleverantör tillhandahåller informationssamhällets tjänster ska leverantören ge information om sitt namn, sin adress i etableringsstaten och sin e-postadress samt i förekommande fall
1. organisationsnummer,
2. registreringsnummer för mervärdesskatt, och
3. behörig tillståndsmyndighet."""@sv .

