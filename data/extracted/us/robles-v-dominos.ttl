lg:US-CA9-2019-0115-ada-applies-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:US-CA9-2019-0115-ada-applies ;
    lgo:retrievedOn "2026-11-04"^^xsd:date ;
    lgo:sourceDocument lg:US-CA9-2019-0115-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://cdn.ca9.uscourts.gov/datastore/opinions/2019/01/15/17-55504.pdf"^^xsd:anyURI ;
    lgo:text "We agree with the district court that the ADA applies to Domino’s website and app. The ADA expressly provides that a place of public accommodation, like Domino’s, engages in unlawful discrimination if it fails to “take such steps as may be necessary to ensure that no individual with a disability is excluded, denied services, segregated or otherwise treated differently than other individuals because of the absence of auxiliary aids and services.”"@en .

lg:US-CA9-2019-0115-nexus
    a lgo:Provision ;
    eli:is_part_of lg:US-CA9-2019-0115 ;
    lgo:citation "Robles v. Domino's Pizza, 913 F.3d 898, part III.A (nexus)" ;
    lgo:interprets lg:US-ADA-12182-a ;
    lgo:regulates lgv:Accessibility ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:US-CA9-2019-0115-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
