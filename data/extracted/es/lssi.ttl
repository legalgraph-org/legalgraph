lg:ES-LSSI-art10-1-d-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:ES-LSSI-art10-1-d-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
