lg:ES-LSSI-art10-1
    a lgo:Provision ;
    eli:is_part_of lg:ES-LSSI ;
    lgo:citation "Artículo 10.1 LSSI" ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:EmailAddress , lgv:GeographicAddress , lgv:ProfessionalBody , lgv:ProfessionalRules , lgv:ProfessionalTitle , lgv:ProviderName , lgv:RapidContact , lgv:RegisterEntry , lgv:SupervisoryAuthority , lgv:TaxId ;
    lgo:reviewStatus lgv:SourceChecked ;
