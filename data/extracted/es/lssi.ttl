lg:ES-LSSI-art10-1-d-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:ES-LSSI-art10-1-d-4 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:ES-LSSI-source ;
    lgo:sourceElement "/response/data[1]/texto[1]/bloque[19]/version[4]/p[10]" ;
    lgo:sourceUrl "https://www.boe.es/eli/es/l/2002/07/11/34/con#a10"^^xsd:anyURI ;
    lgo:text "4.º Las normas profesionales aplicables al ejercicio de su profesión y los medios a través de los cuales se puedan conocer, incluidos los electrónicos."@es .

lg:ES-LSSI-art10-1-d-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:ES-LSSI-art10-1-d ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:ES-LSSI-source ;
    lgo:sourceElement "/response/data[1]/texto[1]/bloque[19]/version[4]/p[6]" ;
    lgo:sourceUrl "https://www.boe.es/eli/es/l/2002/07/11/34/con#a10"^^xsd:anyURI ;
    lgo:text "d) Si ejerce una profesión regulada deberá indicar:"@es .

lg:ES-LSSI-art10-1-e
    a lgo:Provision ;
    eli:is_part_of lg:ES-LSSI ;
    lgo:citation "Artículo 10.1.e) LSSI" ;
    lgo:regulates lgv:ProviderIdentification ;
