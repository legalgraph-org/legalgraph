lg:ES-LEY7-2017
    a lgo:LegalAct ;
    eli:date_document "2017-11-05"^^xsd:date ;
    eli:title "Ley 7/2017, de 2 de noviembre, relativa a la resolución alternativa de litigios en materia de consumo"@es ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:ES ;
