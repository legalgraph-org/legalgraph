lg:AT-MEDIENG-s25-1
    a lgo:Provision ;
    eli:is_part_of lg:AT-MEDIENG ;
    lgo:citation "§ 25 Abs. 1 MedienG" ;
    lgo:regulates lgv:MediaOwnerDisclosure ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:AT-MEDIENG-source ;
