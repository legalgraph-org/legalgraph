lg:AT-DSG
    a lgo:LegalAct ;
    eli:date_document "1999-07-08"^^xsd:date ;
    eli:title "Bundesgesetz zum Schutz natürlicher Personen bei der Verarbeitung personenbezogener Daten (Datenschutzgesetz – DSG)"@de ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:AT ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:shortName "DSG" ;
    lgo:sourceDocument lg:AT-DSG-source-1 , lg:AT-DSG-source-2 , lg:AT-DSG-source-3 ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI .

lg:AT-DSG-s43-1
    a lgo:Provision ;
    eli:is_part_of lg:AT-DSG ;
    lgo:citation "§ 43 Abs. 1 DSG" ;
    lgo:implements lg:EU-2016-679-art13-1 ;
    lgo:regulates lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:ComplaintRight , lgv:ControllerIdentity , lgv:DataProtectionOfficerContact , lgv:DataSubjectRights , lgv:ProcessingPurposes ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:AT-DSG-source-1 ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI .

lg:AT-DSG-s43-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:AT-DSG-s43-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:AT-DSG-source-1 ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI ;
    lgo:text """(1) Der Verantwortliche hat der betroffenen Person zumindest die folgenden Informationen zur Verfügung zu stellen:
1. den Namen und die Kontaktdaten des Verantwortlichen,
2. gegebenenfalls die Kontaktdaten des Datenschutzbeauftragten,
3. die Zwecke, für die die personenbezogenen Daten verarbeitet werden,
4. das Bestehen eines Beschwerderechts bei der Aufsichtsbehörde sowie deren Kontaktdaten,
5. das Bestehen eines Rechts auf Auskunft und Berichtigung oder Löschung personenbezogener Daten und Einschränkung der Verarbeitung der personenbezogenen Daten der betroffenen Person durch den Verantwortlichen."""@de .

lg:AT-DSG-s43-2
    a lgo:Provision ;
    eli:is_part_of lg:AT-DSG ;
    lgo:citation "§ 43 Abs. 2 DSG" ;
    lgo:regulates lgv:PrivacyInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:AT-DSG-source-1 ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI .

lg:AT-DSG-s43-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:AT-DSG-s43-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:AT-DSG-source-1 ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI ;
    lgo:text """(2) Zusätzlich zu den in Abs. 1 genannten Informationen hat der Verantwortliche der betroffenen Person in besonderen Fällen die folgenden zusätzlichen Informationen zu erteilen, um die Ausübung der Rechte der betroffenen Person zu ermöglichen:
1. die Rechtsgrundlage der Verarbeitung,
2. die Dauer, für die die personenbezogenen Daten gespeichert werden oder, falls dies nicht möglich ist, die Kriterien für die Festlegung dieser Dauer,
3. gegebenenfalls die Kategorien von Empfängern der personenbezogenen Daten, auch der Empfänger in Drittländern oder in internationalen Organisationen,
4. erforderlichenfalls weitere Informationen, insbesondere wenn die personenbezogenen Daten ohne Wissen der betroffenen Person erhoben werden."""@de .

lg:AT-DSG-s43-3
    a lgo:Provision ;
    eli:is_part_of lg:AT-DSG ;
    lgo:citation "§ 43 Abs. 3 DSG" ;
    lgo:interprets lg:EU-2016-679-art13-1 , lg:EU-2016-679-art14-1 , lg:EU-2016-679-art14-2 ;
    lgo:regulates lgv:PrivacyInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:AT-DSG-source-1 ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI .

lg:AT-DSG-s43-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:AT-DSG-s43-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:AT-DSG-source-1 ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI ;
    lgo:text "(3) Im Fall der Erhebung der personenbezogenen Daten bei der betroffenen Person müssen der betroffenen Person die Informationen nach den Vorgaben des Abs. 1 und 2 zum Zeitpunkt der Erhebung vorliegen. In allen übrigen Fällen findet Art. 14 Abs. 3 DSGVO Anwendung. Die Information gemäß Abs. 1 und 2 kann entfallen, wenn die Daten nicht durch Befragung des Betroffenen, sondern durch Übermittlung von Daten aus anderen Aufgabengebieten desselben Verantwortlichen oder aus Anwendungen anderer Verantwortlicher ermittelt und die Datenverarbeitung durch Gesetz vorgesehen ist."@de .

lg:AT-DSG-s49-1
    a lgo:Provision ;
    eli:is_part_of lg:AT-DSG ;
    lgo:citation "§ 49 Abs. 1 DSG" ;
    lgo:implements lg:EU-2016-679-art30-1 ;
    lgo:regulates lgv:ProcessingRecord ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:AT-DSG-source-2 ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI .

lg:AT-DSG-s49-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:AT-DSG-s49-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:AT-DSG-source-2 ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI ;
    lgo:text "(1) Jeder Verantwortliche hat sinngemäß nach Maßgabe des Art. 30 Abs. 1 bis 4 DSGVO ein Verzeichnis von Verarbeitungstätigkeiten zu führen, wobei sich die Verweise in Art. 30 Abs. 1 lit. g und Abs. 2 lit. d DSGVO auf § 54 beziehen und die Bezugnahme auf einen Vertreter des Verantwortlichen oder des Auftragsverarbeiters gegenstandslos ist."@de .

lg:AT-DSG-s49-2
    a lgo:Provision ;
    eli:is_part_of lg:AT-DSG ;
    lgo:citation "§ 49 Abs. 2 DSG" ;
    lgo:regulates lgv:ProcessingRecord ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:AT-DSG-source-2 ;
    lgo:sourceElement "/law/section[2]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI .

lg:AT-DSG-s49-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:AT-DSG-s49-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:AT-DSG-source-2 ;
    lgo:sourceElement "/law/section[2]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI ;
    lgo:text """(2) Das Verzeichnis gemäß Abs. 1 hat auch Angaben zu enthalten über
1. die Verwendung von Profiling, wenn eine solche Verwendung vorgenommen wird, und
2. die Rechtsgrundlage der Verarbeitung, einschließlich der Übermittlungen, für die die personenbezogenen Daten bestimmt sind."""@de .

lg:AT-DSG-s57-1
    a lgo:Provision ;
    eli:is_part_of lg:AT-DSG ;
    lgo:citation "§ 57 Abs. 1 DSG" ;
    lgo:implements lg:EU-2016-679-art37-7 ;
    lgo:regulates lgv:DataProtectionOfficer ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:AT-DSG-source-3 ;
    lgo:sourceElement "/law/section[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI .

lg:AT-DSG-s57-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:AT-DSG-s57-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:AT-DSG-source-3 ;
    lgo:sourceElement "/law/section[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI ;
    lgo:text "(1) Jeder Verantwortliche hat nach Maßgabe des Art. 37 Abs. 5 und 7 DSGVO einen Datenschutzbeauftragten zu benennen. Gerichte sind im Rahmen ihrer justiziellen Tätigkeit von der Verpflichtung zur Benennung eines Datenschutzbeauftragten ausgenommen. § 5 gilt im Hinblick auf die Bestimmungen dieses Hauptstücks sinngemäß."@de .

lg:AT-DSG-s57-4
    a lgo:Provision ;
    eli:is_part_of lg:AT-DSG ;
    lgo:citation "§ 57 Abs. 4 DSG" ;
    lgo:implements lg:EU-2016-679-art37-4 ;
    lgo:regulates lgv:DataProtectionOfficer ;
    lgo:requiresDisclosureOf lgv:DataProtectionOfficerContact ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:AT-DSG-source-3 ;
    lgo:sourceElement "/law/section[3]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI .

lg:AT-DSG-s57-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:AT-DSG-s57-4 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:AT-DSG-source-3 ;
    lgo:sourceElement "/law/section[3]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001597"^^xsd:anyURI ;
    lgo:text "(4) Der Verantwortliche hat die Kontaktdaten des Datenschutzbeauftragten zu veröffentlichen und der Datenschutzbehörde mitzuteilen."@de .

