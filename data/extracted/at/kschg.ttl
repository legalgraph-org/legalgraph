lg:AT-KSCHG-s6-1
    a lgo:Provision ;
    eli:is_part_of lg:AT-KSCHG ;
    lgo:citation "§ 6 Abs. 1 KSchG" ;
    lgo:implements lg:EU-1993-13-annex , lg:EU-1993-13-art3-1 ;
    lgo:regulates lgv:UnfairTerms ;
    lgo:reviewStatus lgv:SourceChecked ;
