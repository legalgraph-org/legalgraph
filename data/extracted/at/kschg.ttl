lg:AT-KSCHG-s6-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:AT-KSCHG-s6-3 ;
    lgo:retrievedOn "2026-11-08"^^xsd:date ;
    lgo:sourceDocument lg:AT-KSCHG-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/eli/bgbl/1979/140/P6"^^xsd:anyURI ;
    lgo:text "(3) Eine in Allgemeinen Geschäftsbedingungen oder Vertragsformblättern enthaltene Vertragsbestimmung ist unwirksam, wenn sie unklar oder unverständlich abgefaßt ist."@de .

