lg:AT-OGH-2003-1118
    a lgo:CourtDecision ;
    eli:date_document "2003-11-18"^^xsd:date ;
    eli:title "Oberster Gerichtshof, Urteil vom 18. November 2003 – 4 Ob 219/03i"@de ;
