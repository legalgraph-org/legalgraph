    lgo:citation "§ 14 Abs. 1 UGB" ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:GeographicAddress , lgv:LegalForm , lgv:LiquidationStatus , lgv:ProviderName , lgv:RegisterEntry ;
