lg:AT-FAGG-s4-1
    a lgo:Provision ;
    eli:is_part_of lg:AT-FAGG ;
    lgo:citation "§ 4 Abs. 1 FAGG" ;
    lgo:implements lg:EU-2011-83-art6-1 ;
