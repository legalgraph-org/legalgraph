    lgo:requiresDisclosureOf lgv:EmailAddress , lgv:GeographicAddress , lgv:ProfessionalBody , lgv:ProfessionalRules , lgv:ProfessionalTitle , lgv:ProviderName , lgv:RapidContact , lgv:RegisterEntry , lgv:SupervisoryAuthority , lgv:TotalPrice , lgv:UnsubscribeMechanism , lgv:VatId ;
