lg:IE-SI-336-2011-r5-3
    a lgo:Provision ;
    eli:is_part_of lg:IE-SI-336-2011 ;
    lgo:citation "Reg. 5(3) S.I. 336/2011" ;
    lgo:implements lg:EU-2002-58-art5-3 ;
    lgo:regulates lgv:Consent , lgv:TerminalEquipmentAccess ;
    lgo:requiresDisclosureOf lgv:ProcessingPurposes ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IE-SI-336-2011-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2011/si/336/made/en"^^xsd:anyURI .

lg:IE-SI-336-2011-r5-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-SI-336-2011-r5-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:IE-SI-336-2011-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2011/si/336/made/en"^^xsd:anyURI ;
    lgo:text """(3) A person shall not use an electronic communications network to store information, or to gain access to information already stored in the terminal equipment of a subscriber or user, unless
( a ) the subscriber or user has given his or her consent to that use, and
( b ) the subscriber or user has been provided with clear and comprehensive information in accordance with the Data Protection Acts which—
(i) is both prominently displayed and easily accessible, and
(ii) includes, without limitation, the purposes of the processing of the information."""@en .

lg:IE-SI-336-2011-r5-4
    a lgo:Provision ;
    eli:is_part_of lg:IE-SI-336-2011 ;
    lgo:citation "Reg. 5(4) S.I. 336/2011" ;
    lgo:regulates lgv:Consent ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IE-SI-336-2011-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2011/si/336/made/en"^^xsd:anyURI .

lg:IE-SI-336-2011-r5-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-SI-336-2011-r5-4 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:IE-SI-336-2011-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2011/si/336/made/en"^^xsd:anyURI ;
    lgo:text "(4) For the purpose of paragraph (3), the methods of providing information and giving consent should be as user-friendly as possible. Where it is technically possible and effective, having regard to the relevant provisions of the Data Protection Acts, the user’s consent to the storing of information or to gaining access to information already stored may be given by the use of appropriate browser settings or other technological application by means of which the user can be considered to have given his or her consent."@en .

lg:IE-SI-336-2011-r5-5
    a lgo:Provision ;
    eli:is_part_of lg:IE-SI-336-2011 ;
    lgo:citation "Reg. 5(5) S.I. 336/2011" ;
    lgo:defines lgv:StrictlyNecessaryAccess , lgv:TransmissionOnlyAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IE-SI-336-2011-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2011/si/336/made/en"^^xsd:anyURI .

lg:IE-SI-336-2011-r5-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-SI-336-2011-r5-5 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:IE-SI-336-2011-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2011/si/336/made/en"^^xsd:anyURI ;
    lgo:text "(5) Paragraph (3) does not prevent any technical storage of, or access to, information for the sole purpose of carrying out the transmission of a communication over an electronic communications network or which is strictly necessary in order to provide an information society service explicitly requested by the subscriber or user."@en .

