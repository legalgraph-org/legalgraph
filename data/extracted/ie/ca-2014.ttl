lg:IE-CA-2014-s151-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-CA-2014-s151-5 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:IE-CA-2014-source ;
    lgo:sourceElement "/law/section[1]/paragraph[5]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2014/act/38/section/151/enacted/en/html"^^xsd:anyURI ;
    lgo:text "(5) If special circumstances exist which render it, in the opinion of the Minister, expedient that such an exemption should be granted, the Minister may, subject to such conditions as he or she may think fit to impose and specifies in the exemption, grant, in writing, an exemption from the obligations imposed by subsection (1) ."@en .

lg:IE-CA-2014-s151-6
    a lgo:Provision ;
    eli:is_part_of lg:IE-CA-2014 ;
    lgo:citation "section 151(6) Companies Act 2014" ;
    lgo:penalises lg:IE-CA-2014-s151-2 , lg:IE-CA-2014-s151-4 ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IE-CA-2014-source ;
