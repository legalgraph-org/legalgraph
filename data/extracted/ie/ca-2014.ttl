lg:IE-CA-2014-s151-7-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-CA-2014-s151-7 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:IE-CA-2014-source ;
    lgo:sourceElement "/law/section[1]/paragraph[7]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2014/act/38/section/151/enacted/en/html"^^xsd:anyURI ;
    lgo:text """(7) For the purposes of this section—
(a) “director” includes any person in accordance with whose directions or instructions the directors of the company are accustomed to act, and “officer” shall be read accordingly;
(b) “initials” includes a recognised abbreviation of a forename; and
(c) section 149 (12) shall apply as it applies for the purposes of section 149 ."""@en .

