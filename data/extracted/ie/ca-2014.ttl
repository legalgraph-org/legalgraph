lg:IE-CA-2014-s151-6-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-CA-2014-s151-6 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:IE-CA-2014-source ;
    lgo:sourceElement "/law/section[1]/paragraph[6]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2014/act/38/section/151/enacted/en/html"^^xsd:anyURI ;
    lgo:text "(6) If a company makes default in complying with this section, the company and any officer of it who is in default shall be guilty of a category 4 offence."@en .

lg:IE-CA-2014-s151-7
    a lgo:Provision ;
    eli:is_part_of lg:IE-CA-2014 ;
    lgo:citation "section 151(7) Companies Act 2014" ;
    lgo:regulates lgv:ProviderIdentification ;
