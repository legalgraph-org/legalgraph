lg:IE-CA-2014-s151-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-CA-2014-s151-1 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:IE-CA-2014-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2014/act/38/section/151/enacted/en/html"^^xsd:anyURI ;
    lgo:text """(1) Subject to subsection (5) , a company shall, in all business letters on or in which the company's name appears and which are sent by the company to any person, state in legible characters in relation to every director of the company the following particulars:
(a) his or her present forename, or the initials thereof, and present surname;
(b) any former forename and surnames of him or her; and
(c) his or her nationality, if not Irish."""@en .

lg:IE-CA-2014-s151-2
    a lgo:Provision ;
    eli:is_part_of lg:IE-CA-2014 ;
    lgo:citation "section 151(2) Companies Act 2014" ;
    lgo:implements lg:EU-2017-1132-art26-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:GeographicAddress , lgv:LegalForm , lgv:ProviderName , lgv:RegisterEntry ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IE-CA-2014-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2014/act/38/section/151/enacted/en/html"^^xsd:anyURI .

lg:IE-CA-2014-s151-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-CA-2014-s151-2 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:IE-CA-2014-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2014/act/38/section/151/enacted/en/html"^^xsd:anyURI ;
    lgo:text """(2) A company shall further have the following particulars on all its business letters and order forms:
(a) the name and legal form of the company;
(b) the place of registration of the company and the number under which it is registered; and
(c) the address of its registered office."""@en .

lg:IE-CA-2014-s151-3
    a lgo:Provision ;
    eli:is_part_of lg:IE-CA-2014 ;
    lgo:citation "section 151(3) Companies Act 2014" ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ShareCapital ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IE-CA-2014-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2014/act/38/section/151/enacted/en/html"^^xsd:anyURI .

lg:IE-CA-2014-s151-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-CA-2014-s151-3 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:IE-CA-2014-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2014/act/38/section/151/enacted/en/html"^^xsd:anyURI ;
    lgo:text "(3) If on any business letters or order forms of a company there is reference to the share capital of the company, the company shall ensure that the reference is not stated otherwise than as a reference to the issued share capital of the company that is paid up."@en .

lg:IE-CA-2014-s151-4
    a lgo:Provision ;
    eli:is_part_of lg:IE-CA-2014 ;
    lgo:citation "section 151(4) Companies Act 2014" ;
    lgo:implements lg:EU-2017-1132-art26-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:GeographicAddress , lgv:LegalForm , lgv:ProviderName , lgv:RegisterEntry , lgv:ShareCapital ;
