    a lgo:Provision ;
    eli:is_part_of lg:IE-SI-343-2015 ;
    lgo:citation "reg. 18(4) S.I. 343/2015" ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IE-SI-343-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print"^^xsd:anyURI .

lg:IE-SI-343-2015-r18-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-SI-343-2015-r18-4 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:IE-SI-343-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print"^^xsd:anyURI ;
    lgo:text "(4) The trader shall provide the information referred to in paragraph (3) in writing or on another durable medium."@en .

lg:IE-SI-343-2015-r18-5
    a lgo:Provision ;
    eli:is_part_of lg:IE-SI-343-2015 ;
    lgo:citation "reg. 18(5) S.I. 343/2015" ;
    lgo:penalises lg:IE-SI-343-2015-r18-1 , lg:IE-SI-343-2015-r18-2 , lg:IE-SI-343-2015-r18-3 , lg:IE-SI-343-2015-r18-4 ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IE-SI-343-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[5]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print"^^xsd:anyURI .

lg:IE-SI-343-2015-r18-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-SI-343-2015-r18-5 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:IE-SI-343-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[5]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print"^^xsd:anyURI ;
    lgo:text "(5) A trader who contravenes a provision of this Regulation shall be liable on summary conviction to a class A fine or to imprisonment for a term not exceeding 12 months, or to both."@en .

