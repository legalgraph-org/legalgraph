lg:IE-SI-343-2015-r18-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-SI-343-2015-r18-1 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:IE-SI-343-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print"^^xsd:anyURI ;
    lgo:text "(1) A trader established in the State that has committed or is obliged to use an ADR entity to resolve disputes with consumers shall inform a consumer of the ADR entity or entities which cover that trader’s sector including the website address of the relevant ADR entities."@en .

lg:IE-SI-343-2015-r18-2
    a lgo:Provision ;
    eli:is_part_of lg:IE-SI-343-2015 ;
    lgo:citation "reg. 18(2) S.I. 343/2015" ;
    lgo:implements lg:EU-2013-11-art13-2 ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IE-SI-343-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print"^^xsd:anyURI .

lg:IE-SI-343-2015-r18-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-SI-343-2015-r18-2 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:IE-SI-343-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print"^^xsd:anyURI ;
    lgo:text """(2) A trader shall provide the information referred to in paragraph (1) in a clear, comprehensible and easily accessible way—
( a ) on the trader’s website, where one exists, and,
( b ) if applicable, in the general terms and conditions of sales or service contracts between the trader and a consumer."""@en .

lg:IE-SI-343-2015-r18-3
    a lgo:Provision ;
    eli:is_part_of lg:IE-SI-343-2015 ;
    lgo:citation "reg. 18(3) S.I. 343/2015" ;
    lgo:implements lg:EU-2013-11-art13-3 ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody , lgv:DisputeResolutionStatement ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:IE-SI-343-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print"^^xsd:anyURI .

lg:IE-SI-343-2015-r18-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-SI-343-2015-r18-3 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:IE-SI-343-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print"^^xsd:anyURI ;
    lgo:text "(3) If a dispute between a consumer and a trader could not be settled further to a complaint submitted directly by the consumer to the trader, the trader shall provide the consumer with the information referred to in paragraph (1) and shall specify whether he or she will make use of the relevant ADR entity to settle the dispute."@en .

