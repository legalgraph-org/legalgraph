lg:IE-SI-343-2015-r18-6-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:IE-SI-343-2015-r18-6 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:IE-SI-343-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[6]" ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print"^^xsd:anyURI ;
    lgo:text "(6) Sections 77, 78, 80 and 84 of the Act of 2007 shall apply to an offence under these Regulations as they apply to an offence under that Act and, accordingly, references in those sections to an offence under that Act shall be construed as including references to an offence under these Regulations."@en .

