    lgo:sourceUrl "https://narodne-novine.nn.hr/clanci/sluzbeni/2016_12_121_2622.html"^^xsd:anyURI .

lg:HR-ARPS-art22-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:HR-ARPS-art22-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:HR-ARPS-source ;
