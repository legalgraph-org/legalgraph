    lgo:sourceUrl "https://narodne-novine.nn.hr/clanci/sluzbeni/2016_12_121_2622.html"^^xsd:anyURI ;
    lgo:text "(2) Obavijest o nadležnom tijelu ili tijelima za ARPS iz stavka 1. ovoga članka sadržava poštansku adresu i adresu mrežne stranice."@hr .

lg:HR-ARPS-art22-3
    a lgo:Provision ;
    eli:is_part_of lg:HR-ARPS ;
    lgo:citation "članak 22 stavak 3 Zakona o ARPS" ;
    lgo:implements lg:EU-2013-11-art13-2 ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:HR-ARPS-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://narodne-novine.nn.hr/clanci/sluzbeni/2016_12_121_2622.html"^^xsd:anyURI .

lg:HR-ARPS-art22-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:HR-ARPS-art22-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:HR-ARPS-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://narodne-novine.nn.hr/clanci/sluzbeni/2016_12_121_2622.html"^^xsd:anyURI ;
    lgo:text "(3) Obavijesti iz stavaka 1. i 2. ovoga članka moraju biti istaknute na način koji je za potrošača jasan, razumljiv i lako dostupan, na mrežnim stranicama i u poslovnim prostorijama trgovca, kao i na druge načine predviđene posebnim propisima o zaštiti potrošača."@hr .

