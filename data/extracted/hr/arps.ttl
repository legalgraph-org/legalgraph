lg:HR-ARPS-art22-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:HR-ARPS-art22-4 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:HR-ARPS-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://narodne-novine.nn.hr/clanci/sluzbeni/2016_12_121_2622.html"^^xsd:anyURI ;
    lgo:text "(4) Kada se određeni spor ne može riješiti putem pisanog prigovora koji potrošač upućuje trgovcu, trgovac je u odgovoru na pisani prigovor dužan dati potrošaču obavijesti iz stavaka 1. i 2. ovoga članka uz pisanu izjavu o mogućnostima pokretanja postupka pred navedenim tijelima za ARPS te o tome hoće li se upustiti u postupak pred nekima od njih."@hr .

