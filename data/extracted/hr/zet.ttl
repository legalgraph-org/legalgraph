lg:HR-ZET-art6-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:HR-ZET-art6-2 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:HR-ZET-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://narodne-novine.nn.hr/clanci/sluzbeni/2003_10_173_2504.html"^^xsd:anyURI ;
    lgo:text "(2) Ako davatelj usluga prikazuje cijene, one moraju biti jasno i nedvosmisleno naznačene, a posebno se mora naznačiti jesu li u prikazane cijene uključeni troškovi dostave, ostali manipulativni troškovi, porez i drugi troškovi koji na bilo koji način utječu na prikazanu cijenu."@hr .

