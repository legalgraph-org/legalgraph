lg:CA-ON-CPA-s38-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CA-ON-CPA-s38-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK47"^^xsd:anyURI ;
    lgo:text "(1) Before a consumer enters into an internet agreement, the supplier shall disclose the prescribed information to the consumer. 2002, c. 30, Sched. A, s. 38 (1)."@en .

lg:CA-ON-CPA-s38-2
    a lgo:Provision ;
    eli:is_part_of lg:CA-ON-CPA ;
    lgo:citation "CPA 2002 (Ont.) s. 38(2)" ;
    lgo:regulates lgv:PreContractInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK47"^^xsd:anyURI .

lg:CA-ON-CPA-s38-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CA-ON-CPA-s38-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK47"^^xsd:anyURI ;
    lgo:text "(2) The supplier shall provide the consumer with an express opportunity to accept or decline the agreement and to correct errors immediately before entering into it. 2002, c. 30, Sched. A, s. 38 (2)."@en .

lg:CA-ON-CPA-s38-3
    a lgo:Provision ;
    eli:is_part_of lg:CA-ON-CPA ;
    lgo:citation "CPA 2002 (Ont.) s. 38(3)" ;
    lgo:regulates lgv:PreContractInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK47"^^xsd:anyURI .

lg:CA-ON-CPA-s38-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CA-ON-CPA-s38-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK47"^^xsd:anyURI ;
    lgo:text """(3) In addition to the requirements set out in section 5, disclosure under this section shall be accessible and shall be available in a manner that ensures that,
(a) the consumer has accessed the information; and
(b) the consumer is able to retain and print the information. 2002, c. 30, Sched. A, s. 38 (3)."""@en .

