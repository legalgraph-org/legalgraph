lg:CA-ON-CPA-s40-1
    a lgo:Provision ;
    eli:is_part_of lg:CA-ON-CPA ;
    lgo:citation "CPA 2002 (Ont.) s. 40(1)" ;
    lgo:enforces lgv:PreContractInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK49"^^xsd:anyURI .

lg:CA-ON-CPA-s40-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CA-ON-CPA-s40-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK49"^^xsd:anyURI ;
    lgo:text """(1) A consumer may cancel an internet agreement at any time from the date the agreement is entered into until seven days after the consumer receives a copy of the agreement if,
(a) the supplier did not disclose to the consumer the information required under subsection 38 (1); or
(b) the supplier did not provide to the consumer an express opportunity to accept or decline the agreement or to correct errors immediately before entering into it. 2002, c. 30, Sched. A, s. 40 (1)."""@en .

lg:CA-ON-CPA-s40-2
    a lgo:Provision ;
    eli:is_part_of lg:CA-ON-CPA ;
    lgo:citation "CPA 2002 (Ont.) s. 40(2)" ;
    lgo:enforces lgv:PreContractInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[3]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK49"^^xsd:anyURI .

lg:CA-ON-CPA-s40-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CA-ON-CPA-s40-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[3]/paragraph[2]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK49"^^xsd:anyURI ;
    lgo:text "(2) A consumer may cancel an internet agreement within 30 days after the date the agreement is entered into, if the supplier does not comply with a requirement under section 39. 2004, c. 19, s. 7 (7)."@en .

