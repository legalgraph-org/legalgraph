    a lgo:Provision ;
    eli:is_part_of lg:CA-ON-CPA ;
    lgo:citation "CPA 2002 (Ont.) s. 39(1)" ;
    lgo:regulates lgv:ContractConfirmation ;
    lgo:requiresDisclosureOf lgv:ContractCopy ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK48"^^xsd:anyURI .

lg:CA-ON-CPA-s39-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CA-ON-CPA-s39-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CA-ON-CPA-source ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://www.ontario.ca/laws/statute/02c30#BK48"^^xsd:anyURI ;
    lgo:text "(1) A supplier shall deliver to a consumer who enters into an internet agreement a copy of the agreement in writing within the prescribed period after the consumer enters into the agreement. 2002, c. 30, Sched. A, s. 39 (1)."@en .

