lg:RO-OG-38-2015-art25-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:RO-OG-38-2015-art25-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:RO-OG-38-2015-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://legislatie.just.ro/Public/DetaliiDocumentAfis/193569"^^xsd:anyURI ;
    lgo:text "(1) Comercianții informează consumatorii cu privire la entitatea sau entitățile SAL de care aceștia aparțin atunci când comercianții se angajează să utilizeze respectivele proceduri. Informațiile respective includ adresa site-ului internet al entității sau entităților SAL relevante."@ro .

lg:RO-OG-38-2015-art25-2
    a lgo:Provision ;
    eli:is_part_of lg:RO-OG-38-2015 ;
