lg:RO-LCE-art5-1
    a lgo:Provision ;
    eli:is_part_of lg:RO-LCE ;
    lgo:citation "art. 5 alin. (1) Legea 365/2002" ;
    lgo:implements lg:EU-2000-31-art5-1 ;
