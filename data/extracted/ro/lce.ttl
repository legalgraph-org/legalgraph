lg:RO-LCE-art5-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:RO-LCE-art5-2 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:RO-LCE-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://legislatie.just.ro/Public/DetaliiDocumentAfis/37075"^^xsd:anyURI ;
    lgo:text "(2) Obligaţia prevăzută la alin. (1) se considera îndeplinită în cazul în care furnizorul unui serviciu afişează aceste informaţii într-o formă clara, vizibil şi permanent, în interiorul paginii de web prin intermediul căreia este oferit serviciul respectiv, în condiţiile menţionate la alin. (1)."@ro .

