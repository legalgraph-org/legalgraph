lg:RO-LEGA-31-1990-art74-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:RO-LEGA-31-1990-art74-4 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:RO-LEGA-31-1990-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://legislatie.just.ro/Public/DetaliiDocument/56732"^^xsd:anyURI ;
    lgo:text "(4) În situația în care documentele prevăzute la alin. (1) sunt emise de o sucursală, acestea trebuie să menționeze și oficiul registrului comerțului la care a fost înregistrată sucursala și numărul ei de înregistrare."@ro .

