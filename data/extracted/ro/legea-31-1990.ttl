lg:RO-LEGA-31-1990-art74-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:RO-LEGA-31-1990-art74-5 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:RO-LEGA-31-1990-source ;
    lgo:sourceElement "/law/section[1]/paragraph[5]" ;
    lgo:sourceUrl "https://legislatie.just.ro/Public/DetaliiDocument/56732"^^xsd:anyURI ;
    lgo:text "(5) Dacă societatea deține o pagină de internet proprie, informațiile prevăzute la alin. (1) și (3) vor fi publicate și pe pagina de internet a societății."@ro .

