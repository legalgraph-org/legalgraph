lg:FR-CNIL-2020-091
    a lgo:Guidance ;
    eli:date_document "2020-09-17"^^xsd:date ;
    eli:title "Lignes directrices cookies et autres traceurs"@fr ;
    lgo:actType lgv:Guidelines ;
    lgo:jurisdiction lg:FR ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:shortName "CNIL lignes directrices cookies" ;
    lgo:sourceDocument lg:FR-CNIL-2020-091-source ;
