lg:FR-CNIL-SAN-2025-005-d1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:FR-CNIL-SAN-2025-005-d1 ;
    lgo:retrievedOn "2026-11-04"^^xsd:date ;
    lgo:sourceDocument lg:FR-CNIL-SAN-2025-005-source ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://www.legifrance.gouv.fr/cnil/id/CNILTEXT000052182271/"^^xsd:anyURI ;
    lgo:text "de prononcer à l’encontre de la société INFINITE STYLES SERVICES CO. LIMITED, une amende administrative d’un montant de cent cinquante millions d’euros (150 000 000 €) au regard du manquement constitué à l’article 82 de la loi n° 78-17 du 6 janvier 1978 relative à l’informatique ;"@fr .

lg:FR-CNIL-SAN-2025-005-d1-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:FR-CNIL-SAN-2025-005-d1-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:FR-CNIL-SAN-2025-005-d1 ;
    lgo:retrievedOn "2026-11-03"^^xsd:date ;
    lgo:sourceDocument lg:FR-CNIL-SAN-2025-005-source-en ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://www.cnil.fr/sites/default/files/2025-09/cnil_sanction_shein_en.pdf"^^xsd:anyURI ;
    lgo:text "order INFINITE STYLES SERVICES CO. LIMITED to pay an administrative fine of EUR 150 million (EUR 150 000 000) for failure to comply with Article 82 of Law No 78-17 of 6 January 1978 on information technology;"@en .

lg:FR-CNIL-SAN-2025-005-p112
    a lgo:Provision ;
    eli:is_part_of lg:FR-CNIL-SAN-2025-005 ;
    lgo:citation "CNIL SAN-2025-005, para. 112" ;
    lgo:interprets lg:FR-LIL-art82-2 ;
    lgo:regulates lgv:Consent ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:FR-CNIL-SAN-2025-005-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
