lg:FR-LCEN-art19-1
    a lgo:Provision ;
    eli:is_part_of lg:FR-LCEN ;
    lgo:citation "Article 19, alinéa 1, LCEN" ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:EmailAddress , lgv:GeographicAddress , lgv:PhoneNumber , lgv:ProfessionalBody , lgv:ProfessionalRules , lgv:ProfessionalTitle , lgv:ProviderName , lgv:RegisterEntry , lgv:ShareCapital , lgv:SupervisoryAuthority , lgv:VatId ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:FR-LCEN-source-3 ;
