    lgo:citation "CNIL recommandation cookies, para. 12" ;
    lgo:interprets lg:EU-2002-58-art5-3 ;
    lgo:regulates lgv:Consent ;
    lgo:requiresDisclosureOf lgv:ProcessingPurposes ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:FR-CNIL-2020-092-source ;
