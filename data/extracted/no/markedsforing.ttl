lg:NO-MFL-s10a-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:NO-MFL-s10a-1 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:NO-MFL-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://lovdata.no/dokument/NL/lov/2009-01-09-2"^^xsd:anyURI ;
    lgo:text "Næringsdrivende skal på en klar og forståelig måte gi informasjon til forbrukere om klageorgan som kan behandle en sak mellom partene, og som er innmeldt i henhold til godkjenningsloven § 25 . Informasjonen skal vise til klageorganenes hjemmesider på Internett. Informasjonen skal som et minimum gis i de generelle avtalevilkårene, hvor slike foreligger, og på den næringsdrivendes hjemmeside på Internett, hvor slik finnes. Informasjonen skal være lett tilgjengelig på hjemmesiden."@no .

lg:NO-MFL-s10a-2
    a lgo:Provision ;
    eli:is_part_of lg:NO-MFL ;
    lgo:citation "markedsføringsloven § 10 a annet ledd" ;
    lgo:implements lg:EU-2013-11-art13-3 ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:NO-MFL-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://lovdata.no/dokument/NL/lov/2009-01-09-2"^^xsd:anyURI .

lg:NO-MFL-s10a-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:NO-MFL-s10a-2 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:NO-MFL-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://lovdata.no/dokument/NL/lov/2009-01-09-2"^^xsd:anyURI ;
    lgo:text "Næringsdrivende skal informere forbrukeren i henhold til første ledd når det oppstår sak mellom partene, og det er klart at partene selv ikke kommer til en minnelig løsning. Informasjonen skal gis skriftlig eller på annet varig medium."@no .

lg:NO-MFL-s10a-3
    a lgo:Provision ;
    eli:is_part_of lg:NO-MFL ;
    lgo:citation "markedsføringsloven § 10 a tredje ledd" ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:NO-MFL-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://lovdata.no/dokument/NL/lov/2009-01-09-2"^^xsd:anyURI .

lg:NO-MFL-s10a-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:NO-MFL-s10a-3 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:NO-MFL-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://lovdata.no/dokument/NL/lov/2009-01-09-2"^^xsd:anyURI ;
    lgo:text "Med varig medium forstås enhver innretning som gjør forbrukerne i stand til å lagre opplysninger på en slik måte at opplysningene i fremtiden er tilgjengelig i uendret form."@no .

