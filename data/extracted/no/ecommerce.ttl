lg:NO-EHL
    a lgo:LegalAct ;
    eli:date_document "2003-05-23"^^xsd:date ;
    eli:title "Lov om visse sider av elektronisk handel mv. (ehandelsloven)"@no ;
    eli:transposes lg:EU-2000-31 ;
