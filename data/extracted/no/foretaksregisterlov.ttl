    a lgo:Provision ;
    eli:is_part_of lg:NO-FREG ;
    lgo:citation "§ 7-2 første ledd foretaksregisterloven" ;
    lgo:implements lg:EU-2017-1132-art26-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProviderName , lgv:RegisterEntry , lgv:VatStatus ;
