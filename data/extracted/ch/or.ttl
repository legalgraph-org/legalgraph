lg:CH-OR-art40a-1
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40a Abs. 1 OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[1]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_a"^^xsd:anyURI .

lg:CH-OR-art40a-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40a-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[1]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_a"^^xsd:anyURI ;
    lgo:text """1 Die nachfolgenden Bestimmungen sind auf Verträge über bewegliche Sachen und Dienstleistungen, die für den persönlichen oder familiären Gebrauch des Kunden bestimmt sind, anwendbar, wenn:
a. der Anbieter der Güter oder Dienstleistungen im Rahmen einer beruflichen oder gewerblichen Tätigkeit gehandelt hat und
b. die Leistung des Kunden 100 Franken übersteigt."""@de .

lg:CH-OR-art40a-1-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40a-1-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40a-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[1]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_a"^^xsd:anyURI ;
    lgo:text """1 The following provisions apply to contracts relating to goods and services intended for the customer’s personal or family use where:
a. the supplier of the goods or services acted in a professional or commercial capacity; and
b. the consideration from the buyer exceeds 100 francs."""@en .

lg:CH-OR-art40a-2
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40a Abs. 2 OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[1]/article[1]/paragraph[2]" ;
