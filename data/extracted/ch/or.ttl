    a lgo:LegalAct ;
    eli:date_document "1911-03-30"^^xsd:date ;
    eli:title "Bundesgesetz vom 30. März 1911 betreffend die Ergänzung des Schweizerischen Zivilgesetzbuches (Fünfter Teil: Obligationenrecht)"@de ;
