lg:CH-OR-art40a-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40a-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[1]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_a"^^xsd:anyURI ;
    lgo:text "3 Bei wesentlicher Veränderung der Kaufkraft des Geldes passt der Bundesrat den in Absatz 1 Buchstabe b genannten Betrag entsprechend an."@de .

lg:CH-OR-art40a-3-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40a-3-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40a-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[1]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_a"^^xsd:anyURI ;
    lgo:text "3 In the event of significant change to the purchasing power of the national currency, the Federal Council shall adjust the sum indicated in para. 1 let. b accordingly."@en .

lg:CH-OR-art40b
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40b OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[2]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_b"^^xsd:anyURI .

lg:CH-OR-art40b-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40b ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[2]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_b"^^xsd:anyURI ;
    lgo:text """Der Kunde kann seinen Antrag zum Vertragsabschluss oder seine Annahmeerklärung widerrufen, wenn ihm das Angebot gemacht wurde:
a. Fassung gemäss Ziff. I des BG vom 18. Juni 1993, in Kraft seit 1. Jan. 1994 (AS 1993 3120; BBl 1993 I 805). an seinem Arbeitsplatz, in Wohnräumen oder in deren unmittelbaren Umgebung;
b. in öffentlichen Verkehrsmitteln oder auf öffentlichen Strassen und Plätzen;
c. an einer Werbeveranstaltung, die mit einer Ausflugsfahrt oder einem ähnlichen Anlass verbunden war;
d. Eingefügt durch Ziff. I des BG vom 19. Juni 2015 (Revision des Widerrufsrechts), in Kraft seit 1. Jan. 2016 (AS 2015 4107; BBl 2014 921 2993). am Telefon oder über vergleichbare Mittel der gleichzeitigen mündlichen Telekommunikation."""@de .

lg:CH-OR-art40b-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40b-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40b ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[2]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_b"^^xsd:anyURI ;
    lgo:text """A customer may revoke his offer to enter into a contract or his acceptance of such an offer if the transaction was proposed:
a. Amended by No I of the FA of 18 June 1993, in force since 1 Jan. 1994 (AS 1993 3120; BBl 1993 I 757). at his place of work, on residential premises or in their immediate vicinity;
b. on public transport or on a public thoroughfare;
c. during a promotional event held in connection with an excursion or similar event;
d. Inserted by No I of the FA of 19 June 2015 (Revision of the right of revocation), in force since 1 Jan. 2016 (AS 2015 4107; BBl 2014 921 2993). by telephone or by a comparable means of simultaneous verbal communication."""@en .

lg:CH-OR-art40c
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40c OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[3]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_c"^^xsd:anyURI .

lg:CH-OR-art40c-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40c ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[3]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_c"^^xsd:anyURI ;
    lgo:text """Der Kunde hat kein Widerrufsrecht, wenn er:
a. die Vertragsverhandlungen ausdrücklich gewünscht hat;
b. seine Erklärung an einem Markt- oder Messestand abgegeben hat."""@de .

lg:CH-OR-art40c-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40c-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40c ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[3]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_c"^^xsd:anyURI ;
    lgo:text """The customer has no right of revocation:
if he expressly requested the contractual negotiations;
b. if he declared his offer or acceptance at a stand at a market or trade fair."""@en .

lg:CH-OR-art40d-1
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40d Abs. 1 OR" ;
    lgo:regulates lgv:PreContractInformation ;
    lgo:requiresDisclosureOf lgv:WithdrawalInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[4]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_d"^^xsd:anyURI .

lg:CH-OR-art40d-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40d-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[4]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_d"^^xsd:anyURI ;
    lgo:text "1 Der Anbieter muss den Kunden schriftlich oder in einer anderen Form, die den Nachweis durch Text ermöglicht, über das Widerrufsrecht sowie über Form und Frist des Widerrufs unterrichten und ihm seine Adresse bekannt geben."@de .

lg:CH-OR-art40d-1-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40d-1-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40d-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[4]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_d"^^xsd:anyURI ;
    lgo:text "1 The supplier must inform the customer in writing or in another form that may be evidenced by text of the latter’s right of revocation and of the form and time limit to be observed when exercising such right, and must provide his address."@en .

lg:CH-OR-art40d-2
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40d Abs. 2 OR" ;
    lgo:regulates lgv:PreContractInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[4]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_d"^^xsd:anyURI .

lg:CH-OR-art40d-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40d-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[4]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_d"^^xsd:anyURI ;
    lgo:text "2 Diese Angaben müssen datiert sein und die Identifizierung des Vertrags ermöglichen."@de .

lg:CH-OR-art40d-2-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40d-2-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40d-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[4]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_d"^^xsd:anyURI ;
    lgo:text "2 Such information must be dated and permit identification of the contract in question."@en .

lg:CH-OR-art40d-3
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40d Abs. 3 OR" ;
    lgo:regulates lgv:PreContractInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[4]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_d"^^xsd:anyURI .

lg:CH-OR-art40d-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40d-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[4]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_d"^^xsd:anyURI ;
    lgo:text "3 Sie sind dem Kunden so zu übermitteln, dass er sie kennt, wenn er den Vertrag beantragt oder annimmt."@de .

lg:CH-OR-art40d-3-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40d-3-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40d-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[4]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_d"^^xsd:anyURI ;
    lgo:text "3 The information must be transmitted in such a manner that the customer is aware of it when he proposes or accepts the contract."@en .

lg:CH-OR-art40e-1
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40e Abs. 1 OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI .

lg:CH-OR-art40e-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40e-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI ;
    lgo:text "1 Der Widerruf ist an keine Form gebunden. Der Nachweis des fristgemässen Widerrufs obliegt dem Kunden."@de .

lg:CH-OR-art40e-1-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40e-1-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40e-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI ;
    lgo:text "1 Revocation need not be in any particular form. The onus is on the customer to prove that he has revoked the contract within the time limit."@en .

lg:CH-OR-art40e-2
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40e Abs. 2 OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI .

lg:CH-OR-art40e-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40e-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI ;
    lgo:text """2 Die Widerrufsfrist beträgt 14 Tage und beginnt, sobald der Kunde:
a. den Vertrag beantragt oder angenommen hat; und
b. von den Angaben nach Artikel 40d Kenntnis erhalten hat."""@de .

lg:CH-OR-art40e-2-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40e-2-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40e-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI ;
    lgo:text """2 The prescriptive period for revocation is 14 days and commences as soon as the customer:
a. has proposed or accepted the contract; and
b. has become aware of the information stipulated in Art. 40d."""@en .

lg:CH-OR-art40e-3
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40e Abs. 3 OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI .

lg:CH-OR-art40e-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40e-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI ;
    lgo:text "3 Der Beweis des Zeitpunkts, in dem der Kunde von den Angaben nach Artikel 40d Kenntnis erhalten hat, obliegt dem Anbieter."@de .

lg:CH-OR-art40e-3-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40e-3-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40e-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI ;
    lgo:text "3 The onus is on the supplier to prove when the customer received the information stipulated in Art. 40d."@en .

lg:CH-OR-art40e-4
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40e Abs. 4 OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI .

lg:CH-OR-art40e-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40e-4 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI ;
    lgo:text "4 Die Frist ist eingehalten, wenn der Kunde am letzten Tag der Widerrufsfrist dem Anbieter seinen Widerruf mitteilt oder seine Widerrufserklärung der Post übergibt."@de .

lg:CH-OR-art40e-4-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40e-4-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40e-4 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[1]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_e"^^xsd:anyURI ;
    lgo:text "4 The time limit is observed if, on the last day of the prescriptive period, the customer informs the supplier of revocation or posts his written notice of revocation."@en .

lg:CH-OR-art40f-1
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40f Abs. 1 OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI .

lg:CH-OR-art40f-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40f-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI ;
    lgo:text "1 Hat der Kunde widerrufen, so müssen die Parteien bereits empfangene Leistungen zurückerstatten."@de .

lg:CH-OR-art40f-1-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40f-1-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40f-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI ;
    lgo:text "1 Where the customer has revoked the contract, the parties must provide restitution for any performance already made."@en .

lg:CH-OR-art40f-2
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40f Abs. 2 OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI .

lg:CH-OR-art40f-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40f-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI ;
    lgo:text "2 Hat der Kunde eine Sache bereits gebraucht, so schuldet er dem Anbieter einen angemessenen Mietzins."@de .

lg:CH-OR-art40f-2-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40f-2-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40f-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI ;
    lgo:text "2 Where the customer has made use of the goods, he owes an appropriate rental payment to the supplier."@en .

lg:CH-OR-art40f-3
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40f Abs. 3 OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI .

lg:CH-OR-art40f-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40f-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI ;
    lgo:text "3 Hat der Anbieter eine Dienstleistung erbracht, so muss ihm der Kunde Auslagen und Verwendungen nach den Bestimmungen über den Auftrag (Art. 402) ersetzen."@de .

lg:CH-OR-art40f-3-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40f-3-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40f-3 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI ;
    lgo:text "3 Where the supplier has rendered services to him, the customer must reimburse the supplier for outlays and expenses incurred in accordance with the provisions governing mandates (Art. 402)."@en .

lg:CH-OR-art40f-4
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40f Abs. 4 OR" ;
    lgo:regulates lgv:RightOfWithdrawal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI .

lg:CH-OR-art40f-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40f-4 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI ;
    lgo:text "4 Der Kunde schuldet dem Anbieter keine weitere Entschädigung."@de .

lg:CH-OR-art40f-4-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40f-4-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40f-4 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[5]/level[2]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_f"^^xsd:anyURI ;
    lgo:text "4 The customer does not owe the supplier any further compensation."@en .

