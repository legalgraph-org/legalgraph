lg:CH-OR-art40a-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-OR-art40a-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[1]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_a"^^xsd:anyURI ;
    lgo:text "2 Die Bestimmungen gelten nicht für Rechtsgeschäfte, die im Rahmen von bestehenden Finanzdienstleistungsverträgen gemäss Finanzdienstleistungsgesetz vom 15. Juni 2018 durch Finanzinstitute und Banken abgeschlossen werden."@de .

lg:CH-OR-art40a-2-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40a-2-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40a-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[1]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_a"^^xsd:anyURI ;
    lgo:text "2 These provisions do not apply to legal transactions that are entered into by financial institutions and banks within the framework of existing financial services contracts in accordance with the Financial Services Act of 15 June 2018."@en .

