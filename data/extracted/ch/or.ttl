    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_a"^^xsd:anyURI ;
    lgo:text "2bis Für Versicherungsverträge gelten die Bestimmungen des Versicherungsvertragsgesetzes vom 2. April 1908."@de .

lg:CH-OR-art40a-2bis-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-OR-art40a-2bis-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-OR-art40a-2bis ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-OR-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/part[1]/title[1]/chapter[1]/level[8]/level[1]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/27/317_321_377/de#art_40_a"^^xsd:anyURI ;
    lgo:text "2bis For insurance policies, the provisions of the Insurance Policies Act of 2 April 1908 apply."@en .

lg:CH-OR-art40a-3
    a lgo:Provision ;
    eli:is_part_of lg:CH-OR ;
    lgo:citation "Art. 40a Abs. 3 OR" ;
