lg:CH-FMG-art45c-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-FMG-art45c-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-FMG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[7]/article[6]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/1997/2187_2187_2187/de#art_45_c"^^xsd:anyURI ;
    lgo:text """Das Bearbeiten von Daten auf fremden Geräten durch fernmeldetechnische Übertragung ist nur erlaubt:
a. für die Fernmeldedienste und ihre Abrechnung; oder
b. wenn die Benutzerinnen und Benutzer über die Bearbeitung und ihren Zweck informiert und darauf hingewiesen werden, dass sie die Bearbeitung ablehnen können."""@de .

lg:CH-FMG-art45c-1-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-FMG-art45c-1-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-FMG-art45c-1 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:CH-FMG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[7]/article[6]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/1997/2187_2187_2187/de#art_45_c"^^xsd:anyURI ;
    lgo:text """Processing of data on external equipment by means of transmission using telecommunications techniques is permitted only:
a. for telecommunications services and charging purposes; or
b. if users are informed about the processing and its purpose and are informed that they may refuse to allow processing."""@en .

