lg:CH-DSG-art14-1
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 14 Abs. 1 DSG" ;
    lgo:regulates lgv:RepresentativeInSwitzerland ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[2]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_14"^^xsd:anyURI .

lg:CH-DSG-art14-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art14-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[2]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_14"^^xsd:anyURI ;
    lgo:text """1 Private Verantwortliche mit Sitz oder Wohnsitz im Ausland bezeichnen eine Vertretung in der Schweiz, wenn sie Personendaten von Personen in der Schweiz bearbeiten und die Datenbearbeitung die folgenden Voraussetzungen erfüllt:
a. Die Bearbeitung steht im Zusammenhang mit dem Angebot von Waren und Dienstleistungen oder der Beobachtung des Verhaltens von Personen in der Schweiz.
b. Es handelt sich um eine umfangreiche Bearbeitung.
c. Es handelt sich um eine regelmässige Bearbeitung.
d. Die Bearbeitung bringt ein hohes Risiko für die Persönlichkeit der betroffenen Personen mit sich."""@de .

lg:CH-DSG-art14-1-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art14-1-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art14-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[2]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_14"^^xsd:anyURI ;
    lgo:text """1 Private controllers with registered office or domicile abroad shall appoint a representative in Switzerland if they process the personal data of persons in Switzerland and the data processing meets the following requirements:
a. The processing is connected with the offer of goods or services or the monitoring of the behaviour of persons in Switzerland.
b. The processing is on a large scale.
c. The processing is carried out regularly.
d. The processing poses a high risk to the personality of the data subjects."""@en .

lg:CH-DSG-art14-3
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 14 Abs. 3 DSG" ;
    lgo:regulates lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:ControllerRepresentative ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[2]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_14"^^xsd:anyURI .

lg:CH-DSG-art14-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art14-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[2]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_14"^^xsd:anyURI ;
    lgo:text "3 Der Verantwortliche veröffentlicht den Namen und die Adresse der Vertretung."@de .

lg:CH-DSG-art14-3-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art14-3-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art14-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[2]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_14"^^xsd:anyURI ;
    lgo:text "3 The controller shall publish the name and the address of the representative."@en .

lg:CH-DSG-art19-1
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 19 Abs. 1 DSG" ;
    lgo:regulates lgv:PrivacyInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI .

lg:CH-DSG-art19-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art19-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI ;
    lgo:text "1 Der Verantwortliche informiert die betroffene Person angemessen über die Beschaffung von Personendaten; diese Informationspflicht gilt auch, wenn die Daten nicht bei der betroffenen Person beschafft werden."@de .

lg:CH-DSG-art19-1-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art19-1-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art19-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI ;
    lgo:text "1 The controller shall inform the data subject in an appropriate manner when collecting personal data; this duty to provide information also applies if the data is not collected from the data subject."@en .

lg:CH-DSG-art19-2
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 19 Abs. 2 DSG" ;
    lgo:regulates lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:ControllerIdentity , lgv:ProcessingPurposes , lgv:Recipients ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI .

lg:CH-DSG-art19-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art19-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI ;
    lgo:text """2 Er teilt der betroffenen Person bei der Beschaffung diejenigen Informationen mit, die erforderlich sind, damit sie ihre Rechte nach diesem Gesetz geltend machen kann und eine transparente Datenbearbeitung gewährleistet ist; er teilt ihr mindestens mit:
a. die Identität und die Kontaktdaten des Verantwortlichen;
b. den Bearbeitungszweck;
c. gegebenenfalls die Empfängerinnen und Empfänger oder die Kategorien von Empfängerinnen und Empfängern, denen Personendaten bekanntgegeben werden."""@de .

lg:CH-DSG-art19-2-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art19-2-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art19-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI ;
    lgo:text """2 It shall provide the data subject on collecting the data with the information required for the data subject to exercise their rights under this Act and to guarantee transparent data processing; it shall provide the following information as a minimum:
a. the controller's identity and contact details;
b. the purpose of processing;
c. if applicable, the recipients or the categories of recipients to which personal data is disclosed."""@en .

lg:CH-DSG-art19-3
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 19 Abs. 3 DSG" ;
    lgo:regulates lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:CategoriesOfPersonalData ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI .

lg:CH-DSG-art19-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art19-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI ;
    lgo:text "3 Werden die Daten nicht bei der betroffenen Person beschafft, so teilt er ihr zudem die Kategorien der bearbeiteten Personendaten mit."@de .

lg:CH-DSG-art19-3-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art19-3-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art19-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI ;
    lgo:text "3 If the data is not collected from the data subject, the controller shall also inform the data subject of the categories of processed personal data."@en .

lg:CH-DSG-art19-4
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 19 Abs. 4 DSG" ;
    lgo:regulates lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:ThirdCountryTransfer ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI .

lg:CH-DSG-art19-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art19-4 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI ;
    lgo:text "4 Werden die Personendaten ins Ausland bekanntgegeben, so teilt er der betroffenen Person auch den Staat oder das internationale Organ und gegebenenfalls die Garantien nach Artikel 16 Absatz 2 oder die Anwendung einer Ausnahme nach Artikel 17 mit."@de .

lg:CH-DSG-art19-4-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art19-4-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art19-4 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_19"^^xsd:anyURI ;
    lgo:text "4 If the personal data are disclosed abroad, the controller shall also inform the data subject of the State or the international body to which such data are disclosed and if applicable of the guarantees under Article 16 paragraph 2 or the application of an exception under Article 17."@en .

lg:CH-DSG-art21-1
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 21 Abs. 1 DSG" ;
    lgo:regulates lgv:PrivacyInformation ;
    lgo:requiresDisclosureOf lgv:AutomatedDecisionMaking ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_21"^^xsd:anyURI .

lg:CH-DSG-art21-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art21-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_21"^^xsd:anyURI ;
    lgo:text "1 Der Verantwortliche informiert die betroffene Person über eine Entscheidung, die ausschliesslich auf einer automatisierten Bearbeitung beruht und die für sie mit einer Rechtsfolge verbunden ist oder sie erheblich beeinträchtigt (automatisierte Einzelentscheidung)."@de .

lg:CH-DSG-art21-1-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art21-1-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art21-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[3]/article[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_21"^^xsd:anyURI ;
    lgo:text "1 The controller shall inform the data subject about any decision that is based exclusively on automated processing and that has a legal consequence for or a considerable adverse effect on the data subject (automated individual decision)."@en .

lg:CH-DSG-art3-1
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 3 Abs. 1 DSG" ;
    lgo:defines lgv:EffectsInSwitzerland ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[1]/article[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_3"^^xsd:anyURI .

lg:CH-DSG-art3-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art3-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[1]/article[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_3"^^xsd:anyURI ;
    lgo:text "1 Dieses Gesetz gilt für Sachverhalte, die sich in der Schweiz auswirken, auch wenn sie im Ausland veranlasst werden."@de .

lg:CH-DSG-art3-1-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art3-1-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art3-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[1]/article[3]/paragraph[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_3"^^xsd:anyURI ;
    lgo:text "1 This Act applies to circumstances that have an effect in Switzerland, even if they were initiated abroad."@en .

lg:CH-DSG-art5-a
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 5 Bst. a DSG" ;
    lgo:defines lgv:PersonalData ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[1]/paragraph[1]/content[1]/blockList[1]/item[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_5"^^xsd:anyURI .

lg:CH-DSG-art5-a-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art5-a ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[1]/paragraph[1]/content[1]/blockList[1]/item[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_5"^^xsd:anyURI ;
    lgo:text "a. Personendaten: alle Angaben, die sich auf eine bestimmte oder bestimmbare natürliche Person beziehen;"@de .

lg:CH-DSG-art5-a-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art5-a-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art5-a ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[1]/paragraph[1]/content[1]/blockList[1]/item[1]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_5"^^xsd:anyURI ;
    lgo:text "a. personal data means any information relating to an identified or identifiable natural person;"@en .

lg:CH-DSG-art5-j
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 5 Bst. j DSG" ;
    lgo:defines lgv:Controller ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[1]/paragraph[1]/content[1]/blockList[1]/item[10]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_5"^^xsd:anyURI .

lg:CH-DSG-art5-j-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art5-j ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[1]/paragraph[1]/content[1]/blockList[1]/item[10]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_5"^^xsd:anyURI ;
    lgo:text "j. Verantwortlicher: private Person oder Bundesorgan, die oder das allein oder zusammen mit anderen über den Zweck und die Mittel der Bearbeitung entscheidet;"@de .

lg:CH-DSG-art5-j-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art5-j-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art5-j ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[1]/paragraph[1]/content[1]/blockList[1]/item[10]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_5"^^xsd:anyURI ;
    lgo:text "j. controller means a private person who or federal body which, alone or jointly with others, determines the purpose and the means of processing personal data;"@en .

lg:CH-DSG-art5-k
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 5 Bst. k DSG" ;
    lgo:defines lgv:Processor ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[1]/paragraph[1]/content[1]/blockList[1]/item[11]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_5"^^xsd:anyURI .

lg:CH-DSG-art5-k-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art5-k ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[1]/paragraph[1]/content[1]/blockList[1]/item[11]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_5"^^xsd:anyURI ;
    lgo:text "k. Auftragsbearbeiter: private Person oder Bundesorgan, die oder das im Auftrag des Verantwortlichen Personendaten bearbeitet."@de .

lg:CH-DSG-art5-k-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art5-k-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art5-k ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[1]/paragraph[1]/content[1]/blockList[1]/item[11]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_5"^^xsd:anyURI ;
    lgo:text "k. processor means a private person or federal body that processes personal data on behalf of the controller."@en .

lg:CH-DSG-art6-6
    a lgo:Provision ;
    eli:is_part_of lg:CH-DSG ;
    lgo:citation "Art. 6 Abs. 6 DSG" ;
    lgo:regulates lgv:Consent ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[2]/paragraph[6]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_6"^^xsd:anyURI .

lg:CH-DSG-art6-6-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CH-DSG-art6-6 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[2]/paragraph[6]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_6"^^xsd:anyURI ;
    lgo:text "6 Ist die Einwilligung der betroffenen Person erforderlich, so ist diese Einwilligung nur gültig, wenn sie für eine oder mehrere bestimmte Bearbeitungen nach angemessener Information freiwillig erteilt wird."@de .

lg:CH-DSG-art6-6-q1-en
    a lgo:Quote ;
    lgo:languageVersionOf lg:CH-DSG-art6-6-q1 ;
    lgo:officialLanguageVersion false ;
    lgo:quoteOf lg:CH-DSG-art6-6 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:CH-DSG-source-en ;
    lgo:sourceElement "/akomaNtoso/act[1]/body[1]/chapter[2]/section[1]/article[2]/paragraph[6]" ;
    lgo:sourceUrl "https://www.fedlex.admin.ch/eli/cc/2022/491/de#art_6"^^xsd:anyURI ;
    lgo:text "6 If the consent of the data subject is required, such consent is only valid if given voluntarily for one or more specific instances of processing based on appropriate information."@en .

