    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody , lgv:DisputeResolutionStatement ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CY-NOMOS-85-2017-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.cylaw.org/nomoi/enop/ind/2017_1_85/section-scce3ee223-3c55-42d0-92bf-504ecc7c2375.html"^^xsd:anyURI .

lg:CY-NOMOS-85-2017-art14-3-a-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CY-NOMOS-85-2017-art14-3-a ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:CY-NOMOS-85-2017-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://www.cylaw.org/nomoi/enop/ind/2017_1_85/section-scce3ee223-3c55-42d0-92bf-504ecc7c2375.html"^^xsd:anyURI ;
    lgo:text "(3)(α) Όταν η διαφορά μεταξύ καταναλωτή και εμπόρου εγκατεστημένου στη Δημοκρατία δεν μπορεί να διευθετηθεί με την άμεση υποβολή παραπόνου από τον καταναλωτή προς τον έμπορο, ο έμπορος παρέχει στον καταναλωτή τις πληροφορίες που αναφέρονται στις διατάξεις του εδαφίου (1), διευκρινίζοντας εάν θα κάνει χρήση των σχετικών φορέων εναλλακτικών επίλυσης διαφορών για να επιλύσει τη διαφορά."@el .

