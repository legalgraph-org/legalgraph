    a lgo:LegalAct ;
    eli:date_document "2017-06-30"^^xsd:date ;
    eli:title "Ο περί της Εναλλακτικής Επίλυσης Καταναλωτικών Διαφορών Νόμος του 2017"@el ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:CY ;
