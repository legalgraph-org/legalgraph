    a lgo:Provision ;
    eli:is_part_of lg:CY-NOMOS-85-2017 ;
    lgo:citation "άρθρο 14(2) Ν. 85(I)/2017" ;
    lgo:implements lg:EU-2013-11-art13-2 ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CY-NOMOS-85-2017-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.cylaw.org/nomoi/enop/ind/2017_1_85/section-scce3ee223-3c55-42d0-92bf-504ecc7c2375.html"^^xsd:anyURI .

lg:CY-NOMOS-85-2017-art14-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CY-NOMOS-85-2017-art14-2 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:CY-NOMOS-85-2017-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.cylaw.org/nomoi/enop/ind/2017_1_85/section-scce3ee223-3c55-42d0-92bf-504ecc7c2375.html"^^xsd:anyURI ;
    lgo:text "(2) Οι πληροφορίες που αναφέρονται στις διατάξεις του εδαφίου (1) αναγράφονται με σαφή, ευνόητο και εύκολα προσβάσιμο τρόπο στον ιστότοπο του εμπόρου, αν υπάρχει, και, αν συντρέχει περίπτωση, στους γενικούς όρους και προϋποθέσεις των συμβάσεων πώλησης ή παροχής υπηρεσιών μεταξύ του εμπόρου και του καταναλωτή."@el .

lg:CY-NOMOS-85-2017-art14-3-a
    a lgo:Provision ;
    eli:is_part_of lg:CY-NOMOS-85-2017 ;
    lgo:citation "άρθρο 14(3)(α) Ν. 85(I)/2017" ;
