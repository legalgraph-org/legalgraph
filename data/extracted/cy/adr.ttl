lg:CY-NOMOS-85-2017-art14-3-b-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CY-NOMOS-85-2017-art14-3-b ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
