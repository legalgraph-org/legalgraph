lg:CY-CAP113-art103-1a-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CY-CAP113-art103-1a ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:CY-CAP113-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.cylaw.org/nomoi/enop/ind/0_113/section-sc8fb0032d-10c6-40ae-b047-57a9d29088d1.html"^^xsd:anyURI ;
    lgo:text "(1Α) Στην περίπτωση που εταιρεία διαθέτει διαδικτυακό τόπο, ο εν λόγω διαδικτυακός τόπος περιλαμβάνει τα στοιχεία (i) μέχρι (vi) της παραγράφου (γ) του εδαφίου (1)."@el .

