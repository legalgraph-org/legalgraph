lg:CY-156-I-2004-art8-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:CY-156-I-2004-art8-2 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
