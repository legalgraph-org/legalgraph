lg:EU-2008-593-art6-1
    a lgo:Provision ;
    eli:is_part_of lg:EU-2008-593 ;
    lgo:citation "Art. 6(1) Rome I" ;
    lgo:regulates lgv:OffersGoodsOrServicesInTheUnion ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2008-593-source ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/DIVISION[2]/ARTICLE[4]/PARAG[1]" ;
