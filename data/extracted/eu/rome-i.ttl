lg:EU-2008-593
    a lgo:LegalAct ;
    eli:date_document "2008-06-17"^^xsd:date ;
    eli:title "Regulation (EC) No 593/2008 of the European Parliament and of the Council of 17 June 2008 on the law applicable to contractual obligations (Rome I)"@en ;
