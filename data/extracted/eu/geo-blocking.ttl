    lgo:regulates lgv:GeoBlocking ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2018-302-source ;
    lgo:sourceElement "/ACT/ENACTING.TERMS[1]/ARTICLE[1]/PARAG[2]" ;
