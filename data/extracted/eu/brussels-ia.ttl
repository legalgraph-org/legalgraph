    eli:date_document "2012-12-12"^^xsd:date ;
    eli:title "Regulation (EU) No 1215/2012 of the European Parliament and of the Council of 12 December 2012 on jurisdiction and the recognition and enforcement of judgments in civil and commercial matters"@en ;
