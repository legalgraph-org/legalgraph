lg:EU-2012-1215-art17-1
    a lgo:Provision ;
    eli:is_part_of lg:EU-2012-1215 ;
    lgo:citation "Art. 17(1) Brussels Ia" ;
    lgo:regulates lgv:OffersGoodsOrServicesInTheUnion ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2012-1215-source ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/DIVISION[2]/DIVISION[4]/ARTICLE[1]/PARAG[1]" ;
