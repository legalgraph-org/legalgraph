lg:EU-2023-1795
    a lgo:LegalAct ;
    eli:date_document "2023-07-10"^^xsd:date ;
    eli:title "Commission Implementing Decision EU 2023/1795 of 10 July 2023 pursuant to Regulation (EU) 2016/679 of the European Parliament and of the Council on the adequate level of protection of personal data under the EU-US Data Privacy Framework (notified under document C(2023)4745)"@en ;
