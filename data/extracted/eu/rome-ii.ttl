lg:EU-2007-864-art6-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-2007-864-art6-2 ;
    lgo:retrievedOn "2026-11-08"^^xsd:date ;
    lgo:sourceDocument lg:EU-2007-864-source ;
    lgo:sourceElement "/ACT/ENACTING.TERMS[1]/DIVISION[2]/ARTICLE[3]/PARAG[2]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32007R0864"^^xsd:anyURI ;
    lgo:text "2. Where an act of unfair competition affects exclusively the interests of a specific competitor, Article 4 shall apply."@en .

lg:EU-2007-864-art6-2-q1-de
    a lgo:Quote ;
    lgo:languageVersionOf lg:EU-2007-864-art6-2-q1 ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-2007-864-art6-2 ;
    lgo:retrievedOn "2026-11-08"^^xsd:date ;
    lgo:sourceDocument lg:EU-2007-864-source-de ;
    lgo:sourceElement "/ACT/ENACTING.TERMS[1]/DIVISION[2]/ARTICLE[3]/PARAG[2]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32007R0864"^^xsd:anyURI ;
    lgo:text "(2) Beeinträchtigt ein unlauteres Wettbewerbsverhalten ausschließlich die Interessen eines bestimmten Wettbewerbers, ist Artikel 4 anwendbar."@de .

