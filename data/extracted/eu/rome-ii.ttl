lg:EU-2007-864-art6-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-2007-864-art6-1 ;
    lgo:retrievedOn "2026-11-08"^^xsd:date ;
    lgo:sourceDocument lg:EU-2007-864-source ;
    lgo:sourceElement "/ACT/ENACTING.TERMS[1]/DIVISION[2]/ARTICLE[3]/PARAG[1]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32007R0864"^^xsd:anyURI ;
    lgo:text "1. The law applicable to a non-contractual obligation arising out of an act of unfair competition shall be the law of the country where competitive relations or the collective interests of consumers are, or are likely to be, affected."@en .

lg:EU-2007-864-art6-1-q1-de
    a lgo:Quote ;
    lgo:languageVersionOf lg:EU-2007-864-art6-1-q1 ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-2007-864-art6-1 ;
    lgo:retrievedOn "2026-11-08"^^xsd:date ;
    lgo:sourceDocument lg:EU-2007-864-source-de ;
    lgo:sourceElement "/ACT/ENACTING.TERMS[1]/DIVISION[2]/ARTICLE[3]/PARAG[1]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32007R0864"^^xsd:anyURI ;
    lgo:text "(1) Auf außervertragliche Schuldverhältnisse aus unlauterem Wettbewerbsverhalten ist das Recht des Staates anzuwenden, in dessen Gebiet die Wettbewerbsbeziehungen oder die kollektiven Interessen der Verbraucher beeinträchtigt worden sind oder wahrscheinlich beeinträchtigt werden."@de .

lg:EU-2007-864-art6-2
    a lgo:Provision ;
    eli:is_part_of lg:EU-2007-864 ;
    lgo:citation "Art. 6(2) Rome II" ;
    lgo:regulates lgv:UnfairCommercialPractices ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2007-864-source ;
    lgo:sourceElement "/ACT/ENACTING.TERMS[1]/DIVISION[2]/ARTICLE[3]/PARAG[2]" ;
