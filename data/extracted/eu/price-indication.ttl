lg:EU-1998-6-art6a-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-1998-6-art6a-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-1998-6-source ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/ARTICLE[7]/PARAG[1]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:01998L0006-20220528"^^xsd:anyURI ;
    lgo:text "1. Any announcement of a price reduction shall indicate the prior price applied by the trader for a determined period of time prior to the application of the price reduction."@en .

lg:EU-1998-6-art6a-1-q1-de
    a lgo:Quote ;
    lgo:languageVersionOf lg:EU-1998-6-art6a-1-q1 ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-1998-6-art6a-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-1998-6-source-de ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/ARTICLE[7]/PARAG[1]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:01998L0006-20220528"^^xsd:anyURI ;
    lgo:text "(1) Bei jeder Bekanntgabe einer Preisermäßigung ist der vorherige Preis anzugeben, den der Händler vor der Preisermäßigung über einen bestimmten Zeitraum angewandt hat."@de .

lg:EU-1998-6-art6a-2
    a lgo:Provision ;
    eli:is_part_of lg:EU-1998-6 ;
    lgo:citation "Art. 6a(2) Directive 98/6/EC" ;
    lgo:defines lgv:PriorPrice ;
    lgo:regulates lgv:PriceTransparency ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-1998-6-source ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/ARTICLE[7]/PARAG[2]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:01998L0006-20220528"^^xsd:anyURI .

lg:EU-1998-6-art6a-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-1998-6-art6a-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-1998-6-source ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/ARTICLE[7]/PARAG[2]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:01998L0006-20220528"^^xsd:anyURI ;
    lgo:text "2. The prior price means the lowest price applied by the trader during a period of time not shorter than 30 days prior to the application of the price reduction."@en .

lg:EU-1998-6-art6a-2-q1-de
    a lgo:Quote ;
    lgo:languageVersionOf lg:EU-1998-6-art6a-2-q1 ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-1998-6-art6a-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-1998-6-source-de ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/ARTICLE[7]/PARAG[2]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:01998L0006-20220528"^^xsd:anyURI ;
    lgo:text "(2) Der vorherige Preis ist der niedrigste Preis, den der Händler innerhalb eines Zeitraums von mindestens 30 Tage vor der Anwendung der Preisermäßigung angewandt hat."@de .

