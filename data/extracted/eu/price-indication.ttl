    a lgo:Provision ;
    eli:is_part_of lg:EU-1998-6 ;
    lgo:citation "Art. 6a(1) Directive 98/6/EC" ;
    lgo:regulates lgv:PriceTransparency ;
    lgo:requiresDisclosureOf lgv:PriorPrice ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-1998-6-source ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/ARTICLE[7]/PARAG[1]" ;
