lg:EU-2009-136-rec66
    a lgo:Provision ;
    eli:is_part_of lg:EU-2009-136 ;
    lgo:citation "Recital 66 Directive 2009/136/EC" ;
    lgo:explains lgv:StrictlyNecessaryAccess , lgv:TerminalEquipmentAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2009-136-oj ;
    lgo:sourceElement "/ACT/PREAMBLE[1]/GR.CONSID[1]/CONSID[66]" ;
