    a lgo:CourtDecision ;
    eli:date_document "2016-07-28"^^xsd:date ;
    eli:title "Judgment of the Court (Third Chamber) of 28 July 2016, VEREIN FÜR KONSUMENTENINFORMATION, C‑191/15"@en ;
