lg:CJEU-C-300-21
    a lgo:CourtDecision ;
    eli:date_document "2023-05-04"^^xsd:date ;
    eli:title "Judgment of the Court (Third Chamber) of 4 May 2023, Österreichische Post (Non-material damage in connection with the processing of personal data), C-300/21"@en ;
    lgo:actType lgv:Judgment ;
    lgo:ecli "ECLI:EU:C:2023:370" ;
    lgo:jurisdiction lg:EU ;
