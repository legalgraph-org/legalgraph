lg:EU-COM-2025-837-gdpr88a-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-COM-2025-837-gdpr88a-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-COM-2025-837-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0837"^^xsd:anyURI ;
    lgo:text "(1) Storing of personal data, or gaining of access to personal data already stored, in the terminal equipment of a natural person is only allowed when that person has given his or her consent, in accordance with this Regulation."@en .

lg:EU-COM-2025-837-gdpr88a-3
    a lgo:Provision ;
