    lgo:defines lgv:StrictlyNecessaryAccess , lgv:TransmissionOnlyAccess ;
    lgo:proposesToAmend lg:EU-2002-58-art5-3 ;
    lgo:regulates lgv:TerminalEquipmentAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-COM-2025-837-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0837"^^xsd:anyURI .

lg:EU-COM-2025-837-gdpr88a-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-COM-2025-837-gdpr88a-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-COM-2025-837-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0837"^^xsd:anyURI ;
    lgo:text """(3) Storing of personal data, or gaining of access to personal data already stored, in the terminal equipment of a natural person without consent, and subsequent processing, shall be lawful to the extent it is necessary for any of the following:
(a) carrying out the transmission of an electronic communication over an electronic communications network;
(b) providing a service explicitly requested by the data subject;
(c) creating aggregated information about the usage of an online service to measure the audience of such a service, where it is carried out by the controller of that online service solely for its own use;
(d) maintaining or restoring the security of a service provided by the controller and requested by the data subject or the terminal equipment used for the provision of such service."""@en .

lg:EU-COM-2025-837-gdpr88a-4
    a lgo:Provision ;
    eli:is_part_of lg:EU-COM-2025-837 ;
    lgo:citation "Proposed Art. 88a(4) GDPR, COM(2025) 837" ;
    lgo:proposesToAmend lg:EU-2016-679-art7-3 ;
    lgo:regulates lgv:Consent ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-COM-2025-837-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0837"^^xsd:anyURI .

lg:EU-COM-2025-837-gdpr88a-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-COM-2025-837-gdpr88a-4 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-COM-2025-837-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0837"^^xsd:anyURI ;
    lgo:text """(4) Where storing of personal data, or gaining of access to personal data already stored, in the terminal equipment of a natural person is based on consent, the following shall apply:
(a) the data subject shall be able to refuse requests for consent in an easy and intelligible manner with a single-click button or equivalent means;
(b) if the data subject gives consent, the controller shall not make a new request for consent for the same purpose for the period during which the controller can lawfully rely on the consent of the data subject;
(c) if the data subject declines a request for consent, the controller shall not make a new request for consent for the same purpose for a period of at least six months.
This paragraph also applies to the subsequent processing of personal data based on consent."""@en .

lg:EU-COM-2025-837-gdpr88b-1
    a lgo:Provision ;
    eli:is_part_of lg:EU-COM-2025-837 ;
