    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-COM-2025-837-source ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0837"^^xsd:anyURI .

lg:EU-COM-2025-837-gdpr88b-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-COM-2025-837-gdpr88b-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-COM-2025-837-source ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0837"^^xsd:anyURI ;
    lgo:text """(1) Controllers shall ensure that their online interfaces allow data subjects to:
(a) Give consent through automated and machine-readable means, provided that the conditions for consent laid down in this Regulation are fulfilled;
(b) decline a request for consent and exercise the right to object pursuant to Article 21(2) through automated and machine-readable means."""@en .

