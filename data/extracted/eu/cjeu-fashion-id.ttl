lg:CJEU-C-40-17
    a lgo:CourtDecision ;
    eli:date_document "2019-07-29"^^xsd:date ;
    eli:title "Judgment of the Court (Second Chamber) of 29 July 2019, Fashion ID, C-40/17"@en ;
