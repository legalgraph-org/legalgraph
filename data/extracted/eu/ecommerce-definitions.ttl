lg:EU-2000-31-rec18
    a lgo:Provision ;
    eli:is_part_of lg:EU-2000-31 ;
    lgo:citation "Recital 18 Directive 2000/31/EC" ;
    lgo:explains lgv:InformationSocietyService ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2000-31-oj ;
