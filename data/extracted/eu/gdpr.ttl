lg:EU-2016-679
    a lgo:LegalAct ;
    eli:date_document "2016-04-27"^^xsd:date ;
    eli:title "Regulation (EU) 2016/679 of the European Parliament and of the Council of 27 April 2016 on the protection of natural persons with regard to the processing of personal data and on the free movement of such data, and repealing Directive 95/46/EC (General Data Protection Regulation)"@en ;
