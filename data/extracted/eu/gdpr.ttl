    lgo:refersTo lg:EU-2016-679-art12-1 , lg:EU-2016-679-art12-3 , lg:EU-2016-679-art13-1 , lg:EU-2016-679-art13-2 , lg:EU-2016-679-art14-1 , lg:EU-2016-679-art14-2 , lg:EU-2016-679-art15-1 , lg:EU-2016-679-art15-3 , lg:EU-2016-679-art15-4 , lg:EU-2016-679-art16 , lg:EU-2016-679-art17-1 , lg:EU-2016-679-art17-3 , lg:EU-2016-679-art18-1 , lg:EU-2016-679-art18-2 , lg:EU-2016-679-art19 , lg:EU-2016-679-art20-1 , lg:EU-2016-679-art21-1 , lg:EU-2016-679-art21-2 , lg:EU-2016-679-art21-3 , lg:EU-2016-679-art21-4 , lg:EU-2016-679-art21-5 , lg:EU-2016-679-art44 , lg:EU-2016-679-art45-1 , lg:EU-2016-679-art46-1 , lg:EU-2016-679-art5-2 , lg:EU-2016-679-art6-1 , lg:EU-2016-679-art7-1 , lg:EU-2016-679-art7-2 , lg:EU-2016-679-art7-3 , lg:EU-2016-679-art7-4 ;
    lgo:reviewStatus lgv:SourceChecked ;
