    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/DIVISION[4]/DIVISION[1]/ARTICLE[5]/PARAG[3]/ALINEA[1]/LIST[1]/ITEM[7]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/eli/reg/2016/679/oj/eng"^^xsd:anyURI ;
    lgo:text "(g) at the choice of the controller, deletes or returns all the personal data to the controller after the end of the provision of services relating to processing, and deletes existing copies unless Union or Member State law requires storage of the personal data;"@en .

lg:EU-2016-679-art28-3-g-q1-de
    a lgo:Quote ;
    lgo:languageVersionOf lg:EU-2016-679-art28-3-g-q1 ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-2016-679-art28-3-g ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-2016-679-source-de ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/DIVISION[4]/DIVISION[1]/ARTICLE[5]/PARAG[3]/ALINEA[1]/LIST[1]/ITEM[7]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/eli/reg/2016/679/oj/deu"^^xsd:anyURI ;
    lgo:text "g) nach Abschluss der Erbringung der Verarbeitungsleistungen alle personenbezogenen Daten nach Wahl des Verantwortlichen entweder löscht oder zurückgibt und die vorhandenen Kopien löscht, sofern nicht nach dem Unionsrecht oder dem Recht der Mitgliedstaaten eine Verpflichtung zur Speicherung der personenbezogenen Daten besteht;"@de .

lg:EU-2016-679-art28-3-h
    a lgo:Provision ;
