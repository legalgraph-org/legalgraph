lg:EDPB-GL-2020-05
    a lgo:Guidance ;
    eli:date_document "2020-05-04"^^xsd:date ;
    eli:title "Guidelines 05/2020 on consent under Regulation 2016/679"@en ;
    lgo:actType lgv:Guidelines ;
    lgo:jurisdiction lg:EU ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:shortName "EDPB Guidelines 05/2020" ;
