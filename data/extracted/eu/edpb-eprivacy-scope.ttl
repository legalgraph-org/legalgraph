lg:EDPB-GL-2023-02
    a lgo:Guidance ;
    eli:date_document "2024-10-07"^^xsd:date ;
    eli:title "Guidelines 2/2023 on Technical Scope of Art. 5(3) of ePrivacy Directive"@en ;
    lgo:actType lgv:Guidelines ;
