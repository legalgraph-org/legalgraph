lg:EU-2023-988-art19
    a lgo:Provision ;
    eli:is_part_of lg:EU-2023-988 ;
    lgo:citation "Art. 19 Regulation (EU) 2023/988 (GPSR)" ;
    lgo:regulates lgv:ProductSafetyInformation ;
    lgo:requiresDisclosureOf lgv:ManufacturerIdentity , lgv:ProductIdentification , lgv:ResponsiblePersonInTheUnion , lgv:SafetyWarnings ;
