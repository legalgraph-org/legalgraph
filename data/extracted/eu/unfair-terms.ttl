lg:EU-1993-13
    a lgo:LegalAct ;
    eli:date_document "1993-04-05"^^xsd:date ;
    eli:title "Council Directive 93/13/EEC of 5 April 1993 on unfair terms in consumer contracts"@en ;
    lgo:actType lgv:Directive ;
    lgo:jurisdiction lg:EU ;
