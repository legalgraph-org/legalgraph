lg:EU-1993-13-annex
    a lgo:Provision ;
    eli:is_part_of lg:EU-1993-13 ;
    lgo:citation "Annex Directive 93/13/EEC" ;
    lgo:regulates lgv:TermsAndConditions ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-1993-13-source ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/CONS.ANNEX[1]" ;
