lg:EU-2023-2854-art23
    a lgo:Provision ;
    eli:is_part_of lg:EU-2023-2854 ;
    lgo:citation "Art. 23 Data Act" ;
    lgo:refersTo lg:EU-2023-2854-art25-1 , lg:EU-2023-2854-art29-1 ;
    lgo:regulates lgv:ServiceSwitching ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2023-2854-source ;
    lgo:sourceElement "/ACT/ENACTING.TERMS[1]/DIVISION[6]/ARTICLE[1]/ALINEA[1]" ;
