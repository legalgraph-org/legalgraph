lg:EU-2023-2854
    a lgo:LegalAct ;
    eli:date_document "2023-12-13"^^xsd:date ;
    eli:title "Regulation (EU) 2023/2854 of the European Parliament and of the Council of 13 December 2023 on harmonised rules on fair access to and use of data and amending Regulation (EU) 2017/2394 and Directive (EU) 2020/1828 (Data Act)"@en ;
