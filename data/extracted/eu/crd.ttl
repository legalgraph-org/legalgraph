lg:EU-2011-83-art11a-1
    a lgo:Provision ;
    eli:is_part_of lg:EU-2011-83 ;
    lgo:citation "Art. 11a(1) Directive 2011/83/EU" ;
    lgo:regulates lgv:WithdrawalFunction ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2011-83-source ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/DIVISION[3]/ARTICLE[8]/PARAG[1]" ;
