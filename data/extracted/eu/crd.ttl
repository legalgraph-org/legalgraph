lg:EU-2011-83-art6-1-a-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-2011-83-art6-1-a ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-2011-83-source ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/DIVISION[3]/ARTICLE[1]/PARAG[1]/ALINEA[1]/LIST[1]/ITEM[1]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02011L0083-20260927"^^xsd:anyURI ;
    lgo:text "(a) the main characteristics of the goods or services, to the extent appropriate to the medium and to the goods or services;"@en .

lg:EU-2011-83-art6-1-a-q1-de
    a lgo:Quote ;
    lgo:languageVersionOf lg:EU-2011-83-art6-1-a-q1 ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-2011-83-art6-1-a ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:EU-2011-83-source-de ;
    lgo:sourceElement "/CONS.ACT/CONS.DOC[1]/ENACTING.TERMS[1]/DIVISION[3]/ARTICLE[1]/PARAG[1]/ALINEA[1]/LIST[1]/ITEM[1]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02011L0083-20260927"^^xsd:anyURI ;
    lgo:text "a) die wesentlichen Eigenschaften der Waren oder Dienstleistungen, in dem für das Kommunikationsmittel und die Waren oder Dienstleistungen angemessenen Umfang;"@de .

