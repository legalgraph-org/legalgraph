    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:02011L0083-20260927"^^xsd:anyURI ;
    lgo:text "l) das Bestehen eines gesetzlichen Gewährleistungsrechts für Waren und seine wichtigsten Elemente, einschließlich seiner Mindestdauer von zwei Jahren gemäß der Richtlinie (EU) 2019/771, in hervorgehobener Weise unter Verwendung der in Artikel 22a dieser Richtlinie genannten harmonisierten Mitteilung;"@de .

lg:EU-2011-83-art6-1-la
    a lgo:Provision ;
    eli:is_part_of lg:EU-2011-83 ;
    lgo:citation "Art. 6(1)(la) Directive 2011/83/EU" ;
    lgo:regulates lgv:PreContractInformation ;
    lgo:requiresDisclosureOf lgv:CommercialGuarantee ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2011-83-source ;
