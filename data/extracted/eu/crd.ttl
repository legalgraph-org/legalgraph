lg:EU-2011-83
    a lgo:LegalAct ;
    eli:date_document "2011-10-25"^^xsd:date ;
    eli:title "Directive 2011/83/EU of the European Parliament and of the Council of 25 October 2011 on consumer rights, amending Council Directive 93/13/EEC and Directive 1999/44/EC of the European Parliament and of the Council and repealing Council Directive 85/577/EEC and Directive 97/7/EC of the European Parliament and of the Council"@en ;
    lgo:actType lgv:Directive ;
    lgo:jurisdiction lg:EU ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2011-83-source , lg:EU-2011-83-source-de ;
