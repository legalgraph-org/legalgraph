    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02011L0083-20260927"^^xsd:anyURI ;
    lgo:text "(j) that, if the consumer exercises the right of withdrawal after having made a request in accordance with Article 7(3) or Article 8(8), the consumer shall be liable to pay the trader reasonable costs in accordance with Article 14(3);"@en .

lg:EU-2011-83-art6-1-j-q1-de
    a lgo:Quote ;
