    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:02011L0083-20260927"^^xsd:anyURI ;
    lgo:text "(la) where the producer offers the consumer a commercial guarantee of durability at no additional cost, covering the entire good and with a duration of more than two years, and makes that information available to the trader, the information that that good benefits from such a guarantee, its duration and a reminder of the existence of the legal guarantee of conformity, in a prominent manner, using the harmonised label referred to in Article 22a;"@en .

lg:EU-2011-83-art6-1-la-q1-de
    a lgo:Quote ;
    lgo:languageVersionOf lg:EU-2011-83-art6-1-la-q1 ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-2011-83-art6-1-la ;
