    lgo:quoteOf lg:EU-2015-1535-art10-2 ;
    lgo:retrievedOn "2026-11-11"^^xsd:date ;
    lgo:sourceDocument lg:EU-2015-1535-source-de ;
    lgo:sourceElement "/ACT/ENACTING.TERMS[1]/ARTICLE[10]/ALINEA[2]" ;
    lgo:sourceUrl "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32015L1535"^^xsd:anyURI ;
    lgo:text "Verweisungen auf die aufgehobene Richtlinie gelten als Verweisungen auf die vorliegende Richtlinie und sind nach Maßgabe der Entsprechungstabelle in Anhang IV zu lesen."@de .

