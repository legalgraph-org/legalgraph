    lgo:text "References to the repealed Directive shall be construed as references to this Directive and shall be read in accordance with the correlation table in Annex IV."@en .

lg:EU-2015-1535-art10-2-q1-de
    a lgo:Quote ;
    lgo:languageVersionOf lg:EU-2015-1535-art10-2-q1 ;
