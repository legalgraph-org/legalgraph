lg:EU-2015-1535-art10-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:EU-2015-1535-art10-2 ;
    lgo:retrievedOn "2026-11-11"^^xsd:date ;
