lg:EU-2002-58
    a lgo:LegalAct ;
    eli:date_document "2002-07-12"^^xsd:date ;
    eli:title "Directive 2002/58/EC of the European Parliament and of the Council of 12 July 2002 concerning the processing of personal data and the protection of privacy in the electronic communications sector (Directive on privacy and electronic communications)"@en ;
    lgo:actType lgv:Directive ;
    lgo:jurisdiction lg:EU ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2002-58-source , lg:EU-2002-58-source-de ;
