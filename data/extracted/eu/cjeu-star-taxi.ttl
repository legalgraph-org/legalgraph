lg:CJEU-C-62-19-ruling-1
    a lgo:Provision ;
    eli:is_part_of lg:CJEU-C-62-19 ;
    lgo:citation "C-62/19 Star Taxi App, ruling 1" ;
    lgo:defines lgv:InformationSocietyService ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:CJEU-C-62-19-source ;
    lgo:sourceElement "/JUDGMENT/CONTENTS.JUDGMENT[1]/JURISDICTION[1]/LIST[1]/ITEM[1]" ;
