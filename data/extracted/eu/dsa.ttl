lg:EU-2022-2065
    a lgo:LegalAct ;
    eli:date_document "2022-10-19"^^xsd:date ;
    eli:title "Regulation (EU) 2022/2065 of the European Parliament and of the Council of 19 October 2022 on a Single Market For Digital Services and amending Directive 2000/31/EC (Digital Services Act)"@en ;
    lgo:actType lgv:Regulation ;
