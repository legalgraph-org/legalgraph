lg:EU-2013-11
    a lgo:LegalAct ;
    eli:date_document "2013-05-21"^^xsd:date ;
    eli:title "Directive 2013/11/EU of the European Parliament and of the Council of 21 May 2013 on alternative dispute resolution for consumer disputes and amending Regulation (EC) No 2006/2004 and Directive 2009/22/EC"@en ;
    lgo:actType lgv:Directive ;
    lgo:jurisdiction lg:EU ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2013-11-source , lg:EU-2013-11-source-de ;
