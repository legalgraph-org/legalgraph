lg:EU-2002-58-rec24
    a lgo:Provision ;
    eli:is_part_of lg:EU-2002-58 ;
    lgo:citation "Recital 24 Directive 2002/58/EC" ;
    lgo:explains lgv:TerminalEquipmentAccess ;
