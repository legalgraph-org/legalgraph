    lgo:citation "Annex to Directive 2000/31/EC" ;
    lgo:refersTo lg:EU-2000-31-art3-1 , lg:EU-2000-31-art3-3 ;
    lgo:regulates lgv:CountryOfOrigin ;
    lgo:reviewStatus lgv:SourceChecked ;
