lg:EU-2000-31
    a lgo:LegalAct ;
    eli:date_document "2000-06-08"^^xsd:date ;
    eli:title "Directive 2000/31/EC of the European Parliament and of the Council of 8 June 2000 on certain legal aspects of information society services, in particular electronic commerce, in the Internal Market (Directive on electronic commerce)"@en ;
    lgo:actType lgv:Directive ;
    lgo:jurisdiction lg:EU ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:EU-2000-31-source , lg:EU-2000-31-source-de ;
