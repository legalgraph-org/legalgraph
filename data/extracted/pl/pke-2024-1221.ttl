lg:PL-PKE-2024-1221-art399-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-PKE-2024-1221-art399-2 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:PL-PKE-2024-1221-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2024/1221/text.html"^^xsd:anyURI ;
    lgo:text "2. Abonent lub użytkownik końcowy może wyrazić zgodę, o której mowa w ust. 1 pkt 2, za pomocą ustawień oprogramowania zainstalowanego w wykorzystywanym przez niego telekomunikacyjnym urządzeniu końcowym lub konfiguracji usługi."@pl .

lg:PL-PKE-2024-1221-art399-3
    a lgo:Provision ;
    eli:is_part_of lg:PL-PKE-2024-1221 ;
    lgo:citation "art. 399 ust. 3 PKE" ;
    lgo:implements lg:EU-2002-58-art5-3 ;
    lgo:regulates lgv:StrictlyNecessaryAccess , lgv:TransmissionOnlyAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:PL-PKE-2024-1221-source ;
