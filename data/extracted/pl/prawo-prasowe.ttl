    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/1984/24/text.html"^^xsd:anyURI ;
    lgo:text "2. Przepis ust. 1 stosuje się odpowiednio do nagrań radiowych i telewizyjnych oraz kronik filmowych."@pl .

lg:PL-PP-art7-2
    a lgo:Provision ;
    eli:is_part_of lg:PL-PP ;
    lgo:citation "art. 7 ust. 2 Prawa prasowego" ;
    lgo:regulates lgv:EditorialResponsibility , lgv:MediaOwnerDisclosure ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:PL-PP-source ;
