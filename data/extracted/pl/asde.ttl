lg:PL-ASDE-art5-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-ASDE-art5-1 ;
    lgo:retrievedOn "2026-11-11"^^xsd:date ;
    lgo:sourceDocument lg:PL-ASDE-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2002/1204"^^xsd:anyURI ;
    lgo:text "1. Usługodawca podaje, w sposób wyraźny, jednoznaczny i bezpośrednio dostępny poprzez system teleinformatyczny, którym posługuje się usługobiorca, informacje podstawowe określone w ust. 2-5."@pl .

lg:PL-ASDE-art5-2
    a lgo:Provision ;
    eli:is_part_of lg:PL-ASDE ;
    lgo:citation "art. 5 ust. 2 u.s.d.e." ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:EmailAddress , lgv:GeographicAddress , lgv:ProviderName , lgv:RapidContact ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:PL-ASDE-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2002/1204"^^xsd:anyURI .

lg:PL-ASDE-art5-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-ASDE-art5-2 ;
    lgo:retrievedOn "2026-11-11"^^xsd:date ;
    lgo:sourceDocument lg:PL-ASDE-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2002/1204"^^xsd:anyURI ;
    lgo:text """2. Usługodawca podaje:
1) adresy elektroniczne,
2) imię, nazwisko, miejsce zamieszkania i adres albo nazwę lub firmę oraz siedzibę i adres."""@pl .

lg:PL-ASDE-art5-3
    a lgo:Provision ;
    eli:is_part_of lg:PL-ASDE ;
    lgo:citation "art. 5 ust. 3 u.s.d.e." ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:SupervisoryAuthority ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:PL-ASDE-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2002/1204"^^xsd:anyURI .

lg:PL-ASDE-art5-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-ASDE-art5-3 ;
    lgo:retrievedOn "2026-11-11"^^xsd:date ;
    lgo:sourceDocument lg:PL-ASDE-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2002/1204"^^xsd:anyURI ;
    lgo:text "3. Jeżeli usługodawcą jest przedsiębiorca, podaje on również informacje dotyczące właściwego zezwolenia i organu zezwalającego, w razie gdy świadczenie usługi wymaga, na podstawie odrębnych przepisów, takiego zezwolenia."@pl .

lg:PL-ASDE-art5-5
    a lgo:Provision ;
    eli:is_part_of lg:PL-ASDE ;
    lgo:citation "art. 5 ust. 5 u.s.d.e." ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:ProfessionalBody , lgv:ProfessionalRules , lgv:ProfessionalTitle , lgv:RegisterEntry ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:PL-ASDE-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2002/1204"^^xsd:anyURI .

lg:PL-ASDE-art5-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-ASDE-art5-5 ;
    lgo:retrievedOn "2026-11-11"^^xsd:date ;
    lgo:sourceDocument lg:PL-ASDE-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2002/1204"^^xsd:anyURI ;
    lgo:text """5. Jeżeli usługodawcą jest osoba fizyczna, której prawo do wykonywania zawodu jest uzależnione od spełnienia określonych w odrębnych ustawach wymagań, podaje również:
1) w przypadku ustanowienia pełnomocnika, jego imię, nazwisko, miejsce zamieszkania i adres albo jego nazwę lub firmę oraz siedzibę i adres,
2) samorząd zawodowy, do którego należy,
3) tytuł zawodowy, którego używa, oraz państwo, w którym został on przyznany,
4) numer w rejestrze publicznym, do którego jest wpisany wraz ze wskazaniem nazwy rejestru i organu prowadzącego rejestr,
5) informację o istnieniu właściwych dla danego zawodu zasad etyki zawodowej oraz o sposobie dostępu do tych zasad."""@pl .

