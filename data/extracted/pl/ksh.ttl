lg:PL-KSH-art300-61-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-KSH-art300-61-1 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:PL-KSH-source-3 ;
    lgo:sourceElement "/law/section[3]/paragraph[1]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2024/18/text.html"^^xsd:anyURI ;
    lgo:text """§ 1. Pisma i zamówienia handlowe składane przez spółkę w formie papierowej i elektronicznej, a także informacje na stronach internetowych spółki powinny zawierać:
1) firmę spółki, jej siedzibę i adres;
2) oznaczenie sądu rejestrowego, w którym przechowywana jest dokumentacja spółki, oraz numer, pod którym spółka jest wpisana do rejestru;
3) numer identyfikacji podatkowej (NIP);
4) wysokość kapitału akcyjnego;
5) oznaczenie grupy spółek, jeżeli spółka do niej należy."""@pl .

lg:PL-KSH-art300-61-2
    a lgo:Provision ;
    eli:is_part_of lg:PL-KSH ;
    lgo:citation "art. 300(61) § 2 KSH" ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:PL-KSH-source-3 ;
    lgo:sourceElement "/law/section[3]/paragraph[2]" ;
