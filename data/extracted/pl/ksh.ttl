lg:PL-KSH-art300-61-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-KSH-art300-61-2 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:PL-KSH-source-3 ;
    lgo:sourceElement "/law/section[3]/paragraph[2]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2024/18/text.html"^^xsd:anyURI ;
    lgo:text "§ 2. W pismach i zamówieniach handlowych składanych przez spółkę w formie papierowej zamiast wysokości kapitału akcyjnego z dnia sporządzenia pisma albo zamówienia handlowego spółka może wykazać kapitał akcyjny według stanu na ostatni dzień poprzedniego roku obrotowego ze wskazaniem tego dnia. Jeżeli spółka nie była zobowiązana do sporządzenia sprawozdania finansowego na ostatni dzień poprzedniego roku obrotowego, wykazuje wysokość kapitału akcyjnego na dzień wpisu spółki do rejestru."@pl .

