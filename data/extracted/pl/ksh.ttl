    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2024/18/text.html"^^xsd:anyURI .

lg:PL-KSH-art127-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-KSH-art127-5 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:PL-KSH-source-1 ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2024/18/text.html"^^xsd:anyURI ;
    lgo:text """§ 5. Pisma i zamówienia handlowe składane przez spółkę komandytowo-akcyjną w formie papierowej i elektronicznej, a także informacje na stronach internetowych spółki powinny zawierać:
1) firmę spółki, jej siedzibę i adres;
2) oznaczenie sądu rejestrowego, w którym przechowywana jest dokumentacja spółki oraz numer pod którym spółka jest wpisana do rejestru;
3) numer identyfikacji podatkowej (NIP);
4) wysokość kapitału zakładowego i kapitału wpłaconego."""@pl .

lg:PL-KSH-art206-1
    a lgo:Provision ;
    eli:is_part_of lg:PL-KSH ;
