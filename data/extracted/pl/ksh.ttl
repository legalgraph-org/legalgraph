lg:PL-KSH-art206-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-KSH-art206-3 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:PL-KSH-source-2 ;
    lgo:sourceElement "/law/section[2]/paragraph[2]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2024/18/text.html"^^xsd:anyURI ;
    lgo:text "§ 3. Przepis § 1 stosuje się odpowiednio do oddziału spółki z ograniczoną odpowiedzialnością mającej siedzibę za granicą."@pl .

