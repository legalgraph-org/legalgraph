lg:PL-KSH-art127-5
    a lgo:Provision ;
    eli:is_part_of lg:PL-KSH ;
    lgo:citation "art. 127 § 5 KSH" ;
    lgo:implements lg:EU-2017-1132-art26-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:GeographicAddress , lgv:ProviderName , lgv:RegisterEntry , lgv:ShareCapital , lgv:TaxId ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:PL-KSH-source-1 ;
