lg:PL-ADR-art32-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-ADR-art32-2 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:PL-ADR-source-2 ;
    lgo:sourceElement "/law/section[2]/paragraph[2]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2016/1823/text.html"^^xsd:anyURI ;
    lgo:text "2. W przypadku, o którym mowa w ust. 1 pkt 1, przedsiębiorca wraz z oświadczeniem przekazuje informację o podmiocie uprawnionym właściwym dla danego przedsiębiorcy."@pl .

lg:PL-ADR-art32-3
    a lgo:Provision ;
    eli:is_part_of lg:PL-ADR ;
    lgo:citation "art. 32 ust. 3 ustawy o pozasądowym rozwiązywaniu sporów konsumenckich" ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:PL-ADR-source-2 ;
