    lgo:citation "art. 31 ust. 1 ustawy o pozasądowym rozwiązywaniu sporów konsumenckich" ;
    lgo:implements lg:EU-2013-11-art13-1 ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
