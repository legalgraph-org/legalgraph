lg:PL-ADR-art31-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-ADR-art31-1 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:PL-ADR-source-1 ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2016/1823/text.html"^^xsd:anyURI ;
    lgo:text "1. Przedsiębiorca, który zobowiązał się albo jest obowiązany na podstawie odrębnych przepisów do korzystania z pozasądowego rozwiązywania sporów z konsumentami, informuje konsumentów o podmiocie uprawnionym, który jest właściwy dla tego przedsiębiorcy."@pl .

lg:PL-ADR-art31-2
    a lgo:Provision ;
    eli:is_part_of lg:PL-ADR ;
    lgo:citation "art. 31 ust. 2 ustawy o pozasądowym rozwiązywaniu sporów konsumenckich" ;
    lgo:implements lg:EU-2013-11-art13-2 ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionBody ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:PL-ADR-source-1 ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2016/1823/text.html"^^xsd:anyURI .

lg:PL-ADR-art31-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-ADR-art31-2 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:PL-ADR-source-1 ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2016/1823/text.html"^^xsd:anyURI ;
    lgo:text """2. Informacja, o której mowa w ust. 1, obejmująca co najmniej adres strony internetowej podmiotu uprawnionego, jest udostępniana w sposób zrozumiały i łatwo dostępny dla konsumenta, w tym:
1) na stronie internetowej przedsiębiorcy, jeżeli przedsiębiorca taką prowadzi;
2) we wzorcach umów zawieranych z konsumentami, o ile przedsiębiorca takie stosuje."""@pl .

lg:PL-ADR-art32-1
    a lgo:Provision ;
    eli:is_part_of lg:PL-ADR ;
    lgo:citation "art. 32 ust. 1 ustawy o pozasądowym rozwiązywaniu sporów konsumenckich" ;
    lgo:implements lg:EU-2013-11-art13-3 ;
    lgo:regulates lgv:ConsumerDisputeResolution ;
    lgo:requiresDisclosureOf lgv:DisputeResolutionStatement ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:PL-ADR-source-2 ;
