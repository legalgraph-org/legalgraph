    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2016/1823/text.html"^^xsd:anyURI .

lg:PL-ADR-art32-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-ADR-art32-1 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:PL-ADR-source-2 ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2016/1823/text.html"^^xsd:anyURI ;
    lgo:text """1. W przypadku gdy w następstwie złożonej przez konsumenta reklamacji spór nie został rozwiązany, przedsiębiorca przekazuje konsumentowi na papierze lub innym trwałym nośniku oświadczenie o:
1) zamiarze wystąpienia z wnioskiem o wszczęcie postępowania w sprawie pozasądowego rozwiązywania sporów konsumenckich albo zgodzie na udział w takim postępowaniu albo
2) odmowie wzięcia udziału w postępowaniu w sprawie pozasądowego rozwiązywania sporów konsumenckich."""@pl .

lg:PL-ADR-art32-2
    a lgo:Provision ;
    eli:is_part_of lg:PL-ADR ;
