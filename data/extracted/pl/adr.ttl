lg:PL-ADR-art32-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-ADR-art32-3 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:PL-ADR-source-2 ;
    lgo:sourceElement "/law/section[2]/paragraph[3]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/2016/1823/text.html"^^xsd:anyURI ;
    lgo:text "3. Jeżeli przedsiębiorca nie złożył żadnego oświadczenia, uznaje się, że wyraża zgodę na udział w postępowaniu w sprawie pozasądowego rozwiązywania sporów konsumenckich."@pl .

