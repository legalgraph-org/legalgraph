lg:PL-UJP-art7-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PL-UJP-art7-5 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:PL-UJP-source ;
    lgo:sourceElement "/law/section[1]/paragraph[5]" ;
    lgo:sourceUrl "https://api.sejm.gov.pl/eli/acts/DU/1999/999/text.html"^^xsd:anyURI ;
    lgo:text "5. Kontrolę wykonywania obowiązków, o których mowa w ust. 1, 3 i 4, sprawuje Inspekcja Handlowa oraz Urząd Ochrony Konkurencji i Konsumentów."@pl .

