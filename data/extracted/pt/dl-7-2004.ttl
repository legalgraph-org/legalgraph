lg:PT-DL-7-2004-art10-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PT-DL-7-2004-art10-4 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:PT-DL-7-2004-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://www.pgdlisboa.pt/leis/lei_mostra_articulado.php?artigo_id=1399A0010&nid=1399&tabela=leis"^^xsd:anyURI ;
    lgo:text "4 - Se os serviços prestados implicarem custos para os destinatários além dos custos dos serviços de telecomunicações, incluindo ónus fiscais ou despesas de entrega, estes devem ser objecto de informação clara anterior à utilização dos serviços."@pt .

