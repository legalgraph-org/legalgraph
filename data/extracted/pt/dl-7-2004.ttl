lg:PT-DL-7-2004-art10-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:PT-DL-7-2004-art10-2 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:PT-DL-7-2004-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://www.pgdlisboa.pt/leis/lei_mostra_articulado.php?artigo_id=1399A0010&nid=1399&tabela=leis"^^xsd:anyURI ;
    lgo:text "2 - Se o prestador exercer uma actividade sujeita a um regime de autorização prévia, deve disponibilizar a informação relativa à entidade que a concedeu."@pt .

lg:PT-DL-7-2004-art10-3
    a lgo:Provision ;
