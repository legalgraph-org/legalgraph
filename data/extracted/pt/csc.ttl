    lgo:implements lg:EU-2017-1132-art26-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:GeographicAddress , lgv:LegalForm , lgv:LiquidationStatus , lgv:ProviderName , lgv:RegisterEntry , lgv:TaxId ;
