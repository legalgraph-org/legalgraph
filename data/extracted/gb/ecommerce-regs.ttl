lg:GB-SI-2002-2013-r11-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-SI-2002-2013 ;
    lgo:citation "reg. 11(1) Electronic Commerce Regulations 2002" ;
    lgo:implements lg:EU-2000-31-art11-1 , lg:EU-2000-31-art11-2 ;
    lgo:regulates lgv:OrderPlacement ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-SI-2002-2013-source ;
    lgo:sourceElement "/Legislation/Secondary[1]/Body[1]/P1group[11]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/uksi/2002/2013/regulation/11"^^xsd:anyURI .

lg:GB-SI-2002-2013-r11-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-SI-2002-2013-r11-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-SI-2002-2013-source ;
    lgo:sourceElement "/Legislation/Secondary[1]/Body[1]/P1group[11]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/uksi/2002/2013/regulation/11"^^xsd:anyURI ;
    lgo:text """(1) Unless parties who are not consumers have agreed otherwise, where the recipient of the service places his order through technological means, a service provider shall–
(a) acknowledge receipt of the order to the recipient of the service without undue delay and by electronic means; and
(b) make available to the recipient of the service appropriate, effective and accessible technical means allowing him to identify and correct input errors prior to the placing of the order."""@en .

lg:GB-SI-2002-2013-r6-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-SI-2002-2013 ;
    lgo:citation "reg. 6(1) Electronic Commerce Regulations 2002" ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:EmailAddress , lgv:GeographicAddress , lgv:ProfessionalBody , lgv:ProfessionalRules , lgv:ProfessionalTitle , lgv:ProviderName , lgv:RapidContact , lgv:RegisterEntry , lgv:SupervisoryAuthority , lgv:VatId ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-SI-2002-2013-source ;
    lgo:sourceElement "/Legislation/Secondary[1]/Body[1]/P1group[6]/P1[1]/P1para[1]/P2[1]" ;
