lg:GB-OSA-2023-s9-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-OSA-2023-s9-2 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[3]/Chapter[2]/Pblock[2]/P1group[1]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/9"^^xsd:anyURI ;
    lgo:text "(2) A duty to carry out a suitable and sufficient illegal content risk assessment at a time set out in, or as provided by, Schedule 3."@en .

