lg:GB-OSA-2023-s10-2
    a lgo:Provision ;
    eli:is_part_of lg:GB-OSA-2023 ;
    lgo:citation "s. 10(2) Online Safety Act 2023" ;
    lgo:regulates lgv:OnlineSafety ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[3]/Chapter[2]/Pblock[2]/P1group[2]/P1[1]/P1para[1]/P2group[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/10"^^xsd:anyURI .

lg:GB-OSA-2023-s10-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-OSA-2023-s10-2 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[3]/Chapter[2]/Pblock[2]/P1group[2]/P1[1]/P1para[1]/P2group[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/10"^^xsd:anyURI ;
    lgo:text """(2) A duty, in relation to a service, to take or use proportionate measures relating to the design or operation of the service to—
(a) prevent individuals from encountering priority illegal content by means of the service,
(b) effectively mitigate and manage the risk of the service being used for the commission or facilitation of a priority offence, as identified in the most recent illegal content risk assessment of the service, and
(c) effectively mitigate and manage the risks of harm to individuals, as identified in the most recent illegal content risk assessment of the service (see section 9(5)(g))."""@en .

lg:GB-OSA-2023-s10-3
    a lgo:Provision ;
    eli:is_part_of lg:GB-OSA-2023 ;
    lgo:citation "s. 10(3) Online Safety Act 2023" ;
    lgo:regulates lgv:OnlineSafety ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[3]/Chapter[2]/Pblock[2]/P1group[2]/P1[1]/P1para[1]/P2group[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/10"^^xsd:anyURI .

lg:GB-OSA-2023-s10-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-OSA-2023-s10-3 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[3]/Chapter[2]/Pblock[2]/P1group[2]/P1[1]/P1para[1]/P2group[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/10"^^xsd:anyURI ;
    lgo:text """(3) A duty to operate a service using proportionate systems and processes designed to—
(a) minimise the length of time for which any priority illegal content is present;
(b) where the provider is alerted by a person to the presence of any illegal content, or becomes aware of it in any other way, swiftly take down such content."""@en .

lg:GB-OSA-2023-s12-3
    a lgo:Provision ;
    eli:is_part_of lg:GB-OSA-2023 ;
    lgo:citation "s. 12(3) Online Safety Act 2023" ;
    lgo:regulates lgv:OnlineSafety ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[3]/Chapter[2]/Pblock[3]/P1group[2]/P1[1]/P1para[1]/P2group[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/12"^^xsd:anyURI .

lg:GB-OSA-2023-s12-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-OSA-2023-s12-3 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[3]/Chapter[2]/Pblock[3]/P1group[2]/P1[1]/P1para[1]/P2group[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/12"^^xsd:anyURI ;
    lgo:text """(3) A duty to operate a service using proportionate systems and processes designed to—
(a) prevent children of any age from encountering, by means of the service, primary priority content that is harmful to children;
(b) protect children in age groups judged to be at risk of harm from other content that is harmful to children (or from a particular kind of such content) from encountering it by means of the service."""@en .

lg:GB-OSA-2023-s12-4
    a lgo:Provision ;
    eli:is_part_of lg:GB-OSA-2023 ;
    lgo:citation "s. 12(4) Online Safety Act 2023" ;
    lgo:regulates lgv:OnlineSafety ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[3]/Chapter[2]/Pblock[3]/P1group[2]/P1[1]/P1para[1]/P2group[1]/P2[3]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/12"^^xsd:anyURI .

lg:GB-OSA-2023-s12-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-OSA-2023-s12-4 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[3]/Chapter[2]/Pblock[3]/P1group[2]/P1[1]/P1para[1]/P2group[1]/P2[3]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/12"^^xsd:anyURI ;
    lgo:text "(4) The duty set out in subsection (3)(a) requires a provider to use age verification or age estimation (or both) to prevent children of any age from encountering primary priority content that is harmful to children which the provider identifies on the service."@en .

lg:GB-OSA-2023-s4-2
    a lgo:Provision ;
    eli:is_part_of lg:GB-OSA-2023 ;
    lgo:citation "s. 4(2) Online Safety Act 2023" ;
    lgo:defines lgv:RegulatedUserToUserService ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[2]/P1group[2]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/4"^^xsd:anyURI .

lg:GB-OSA-2023-s4-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-OSA-2023-s4-2 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[2]/P1group[2]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/4"^^xsd:anyURI ;
    lgo:text """(2) A user-to-user service is a “regulated user-to-user service”, and a search service is a “regulated search service”, if the service—
(a) has links with the United Kingdom (see subsections (5) and (6)), and
(b) is not—
(i) a service of a description that is exempt as provided for by Schedule 1, or
(ii) a service of a kind described in Schedule 2 (services combining user-generated content or search content not regulated by this Act with pornographic content that is regulated)."""@en .

lg:GB-OSA-2023-s4-5
    a lgo:Provision ;
    eli:is_part_of lg:GB-OSA-2023 ;
    lgo:citation "s. 4(5) Online Safety Act 2023" ;
    lgo:defines lgv:RegulatedUserToUserService ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[2]/P1group[2]/P1[1]/P1para[1]/P2[5]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/4"^^xsd:anyURI .

lg:GB-OSA-2023-s4-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-OSA-2023-s4-5 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-OSA-2023-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[2]/P1group[2]/P1[1]/P1para[1]/P2[5]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2023/50/section/4"^^xsd:anyURI ;
    lgo:text """(5) For the purposes of subsection (2), a user-to-user service or a search service “has links with the United Kingdom” if—
(a) the service has a significant number of United Kingdom users, or
(b) United Kingdom users form one of the target markets for the service (or the only target market)."""@en .

