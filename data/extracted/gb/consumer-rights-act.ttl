    lgo:sourceDocument lg:GB-CRA-2015-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[2]/Pblock[2]/P1group[7]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2015/15/section/68/1"^^xsd:anyURI .

lg:GB-CRA-2015-s68-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-CRA-2015-s68-1 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-CRA-2015-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[2]/Pblock[2]/P1group[7]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2015/15/section/68/1"^^xsd:anyURI ;
    lgo:text "(1) A trader must ensure that a written term of a consumer contract, or a consumer notice in writing, is transparent."@en .

lg:GB-CRA-2015-s68-2
    a lgo:Provision ;
    eli:is_part_of lg:GB-CRA-2015 ;
    lgo:citation "s. 68(2) Consumer Rights Act 2015" ;
