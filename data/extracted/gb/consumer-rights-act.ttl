lg:GB-CRA-2015-s62-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-CRA-2015-s62-1 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-CRA-2015-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[2]/Pblock[2]/P1group[1]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2015/15/section/62/1"^^xsd:anyURI ;
    lgo:text "(1) An unfair term of a consumer contract is not binding on the consumer."@en .

lg:GB-CRA-2015-s62-4
    a lgo:Provision ;
    eli:is_part_of lg:GB-CRA-2015 ;
    lgo:citation "s. 62(4) Consumer Rights Act 2015" ;
    lgo:regulates lgv:TermsAndConditions ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-CRA-2015-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[2]/Pblock[2]/P1group[1]/P1[1]/P1para[1]/P2[4]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2015/15/section/62/4"^^xsd:anyURI .

lg:GB-CRA-2015-s62-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-CRA-2015-s62-4 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-CRA-2015-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[2]/Pblock[2]/P1group[1]/P1[1]/P1para[1]/P2[4]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2015/15/section/62/4"^^xsd:anyURI ;
    lgo:text "(4) A term is unfair if, contrary to the requirement of good faith, it causes a significant imbalance in the parties' rights and obligations under the contract to the detriment of the consumer."@en .

