lg:GB-CRA-2015-s68-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-CRA-2015-s68-2 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-CRA-2015-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[2]/Pblock[2]/P1group[7]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2015/15/section/68/2"^^xsd:anyURI ;
    lgo:text "(2) A consumer notice is transparent for the purposes of subsection (1) if it is expressed in plain and intelligible language and it is legible."@en .

