lg:GB-SI-2003-2426-schA1-p4-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-SI-2003-2426-schA1-p4-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-SI-2003-2426-schedule-A1-source ;
    lgo:sourceElement "/Legislation/Secondary[1]/Schedules[1]/Schedule[1]/ScheduleBody[1]/P1group[4]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/uksi/2003/2426/schedule/A1"^^xsd:anyURI ;
    lgo:text """(1) Regulation 6(1) does not apply to—
(a) technical storage of information in the terminal equipment of a subscriber or user, or
(b) technical access to information stored in such equipment,
where the storage or access is strictly necessary for the provision of an information society service requested by the subscriber or user."""@en .

lg:GB-SI-2003-2426-schA1-p4-2
    a lgo:Provision ;
    eli:is_part_of lg:GB-SI-2003-2426 ;
    lgo:citation "Sch. A1 para. 4(2) PECR" ;
    lgo:defines lgv:StrictlyNecessaryAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-SI-2003-2426-schedule-A1-source ;
    lgo:sourceElement "/Legislation/Secondary[1]/Schedules[1]/Schedule[1]/ScheduleBody[1]/P1group[4]/P1[1]/P1para[1]/P2[2]" ;
