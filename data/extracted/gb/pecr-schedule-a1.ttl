lg:GB-SI-2003-2426-schA1-p3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-SI-2003-2426-schA1-p3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-SI-2003-2426-schedule-A1-source ;
    lgo:sourceElement "/Legislation/Secondary[1]/Schedules[1]/Schedule[1]/ScheduleBody[1]/P1group[3]/P1[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/uksi/2003/2426/schedule/A1"^^xsd:anyURI ;
    lgo:text """3. Regulation 6(1) does not apply to—
(a) technical storage of information in the terminal equipment of a subscriber or user, or
(b) technical access to information stored in such equipment,
for the sole purpose of carrying out the transmission of a communication over an electronic communications network."""@en .

