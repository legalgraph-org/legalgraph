lg:GB-SI-2003-2426-schA1-p2-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-SI-2003-2426-schA1-p2-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-SI-2003-2426-schedule-A1-source ;
    lgo:sourceElement "/Legislation/Secondary[1]/Schedules[1]/Schedule[1]/ScheduleBody[1]/P1group[2]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/uksi/2003/2426/schedule/A1"^^xsd:anyURI ;
    lgo:text """(1) Regulation 6(1) does not prevent a person storing information, or gaining access to information stored, in the terminal equipment of a subscriber or user if the subscriber or user—
(a) is provided with clear and comprehensive information about the purpose of the storage or access, and
(b) gives consent to the storage or access."""@en .

