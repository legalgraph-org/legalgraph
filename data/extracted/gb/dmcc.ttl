lg:GB-DMCC-2024-s230-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-DMCC-2024-s230-4 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-DMCC-2024-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[4]/Chapter[1]/Pblock[2]/P1group[6]/P1[1]/P1para[1]/P2[4]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/ukpga/2024/13/section/230"^^xsd:anyURI ;
    lgo:text "(4) For the purposes of subsection (2)(b) the total price of a product includes any fees, taxes, charges or other payments that the consumer will necessarily incur if the consumer purchases the product."@en .

lg:GB-DMCC-2024-s254-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-DMCC-2024 ;
    lgo:citation "s. 254(1) DMCC Act 2024" ;
    lgo:regulates lgv:TermsAndConditions ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-DMCC-2024-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[4]/Chapter[2]/Pblock[1]/P1group[2]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2024/13/section/254/1"^^xsd:anyURI .

lg:GB-DMCC-2024-s254-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-DMCC-2024-s254-1 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-DMCC-2024-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[4]/Chapter[2]/Pblock[1]/P1group[2]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2024/13/section/254/1"^^xsd:anyURI ;
    lgo:text """(1) For the purposes of this Chapter, a subscription contract is a contract between a trader and a consumer—
(a) for the supply of goods, services or digital content by the trader to the consumer in exchange for payment by the consumer,
(b) to which either or both of subsections (2) and (3) apply, and
(c) which is not an excluded contract (see section 255)."""@en .

lg:GB-DMCC-2024-s256-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-DMCC-2024 ;
    lgo:citation "s. 256(1) DMCC Act 2024" ;
    lgo:regulates lgv:TermsAndConditions ;
