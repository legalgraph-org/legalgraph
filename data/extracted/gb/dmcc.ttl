    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[4]/Chapter[2]/Pblock[2]/P1group[1]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2024/13/section/256/1"^^xsd:anyURI .

lg:GB-DMCC-2024-s256-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-DMCC-2024-s256-1 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-DMCC-2024-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[4]/Chapter[2]/Pblock[2]/P1group[1]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2024/13/section/256/1"^^xsd:anyURI ;
    lgo:text """(1) Before a trader enters into a subscription contract with a consumer, the trader must—
(a) give to the consumer the information set out in Part 1 of Schedule 23 (“key pre-contract information”), and
(b) give, or make available, to the consumer the information set out in Part 2 of Schedule 23 (“full pre-contract information”)."""@en .

