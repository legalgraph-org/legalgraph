    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2024/13/section/264/1"^^xsd:anyURI .

lg:GB-DMCC-2024-s264-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-DMCC-2024-s264-1 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-DMCC-2024-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[4]/Chapter[2]/Pblock[4]/P1group[1]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2024/13/section/264/1"^^xsd:anyURI ;
    lgo:text """(1) A consumer has the right to cancel a subscription contract during—
(a) the initial cooling-off period, and
(b) any renewal cooling-off period."""@en .

lg:GB-DMCC-2024-s266-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-DMCC-2024 ;
    lgo:citation "s. 266(1) DMCC Act 2024" ;
