    lgo:sourceDocument lg:GB-DMCC-2024-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[4]/Chapter[2]/Pblock[2]/P1group[5]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2024/13/section/260/1"^^xsd:anyURI .

lg:GB-DMCC-2024-s260-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-DMCC-2024-s260-1 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-DMCC-2024-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[4]/Chapter[2]/Pblock[2]/P1group[5]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2024/13/section/260/1"^^xsd:anyURI ;
    lgo:text """(1) A trader must make arrangements to enable a consumer to exercise a right to bring a subscription contract to an end—
(a) in a way which is straightforward, and
(b) without having to take any steps which are not reasonably necessary for bringing the contract to an end."""@en .

lg:GB-DMCC-2024-s264-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-DMCC-2024 ;
    lgo:citation "s. 264(1) DMCC Act 2024" ;
    lgo:regulates lgv:TermsAndConditions ;
