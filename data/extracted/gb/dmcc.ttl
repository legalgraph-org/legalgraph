lg:GB-DMCC-2024-s257-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-DMCC-2024-s257-1 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-DMCC-2024-source ;
    lgo:sourceElement "/Legislation/Primary[1]/Body[1]/Part[4]/Chapter[2]/Pblock[2]/P1group[2]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/id/ukpga/2024/13/section/257/1"^^xsd:anyURI ;
    lgo:text "(1) Subsections (2) and (3) apply in relation to a subscription contract entered into online."@en .

lg:GB-DMCC-2024-s260-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-DMCC-2024 ;
    lgo:citation "s. 260(1) DMCC Act 2024" ;
    lgo:regulates lgv:TermsAndConditions ;
