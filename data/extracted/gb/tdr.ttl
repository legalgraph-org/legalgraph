lg:GB-SI-2015-17-r25-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-SI-2015-17-r25-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-SI-2015-17-source ;
    lgo:sourceElement "/Legislation/Secondary[1]/Body[1]/Part[6]/P1group[6]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/uksi/2015/17/regulation/25"^^xsd:anyURI ;
    lgo:text """(1) Every company shall disclose the particulars set out in paragraph (2) on—
(a) its business letters;
(b) its order forms; and
(c) its websites."""@en .

