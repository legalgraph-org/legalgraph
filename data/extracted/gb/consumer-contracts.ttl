lg:GB-SI-2013-3134-r40-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-SI-2013-3134-r40-1 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-SI-2013-3134-source ;
    lgo:sourceElement "/Legislation/Secondary[1]/Body[1]/Part[4]/P1group[2]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/uksi/2013/3134/regulation/40"^^xsd:anyURI ;
    lgo:text "(1) Under a contract between a trader and a consumer, no payment is payable in addition to the remuneration agreed for the trader's main obligation unless, before the consumer became bound by the contract, the trader obtained the consumer's express consent."@en .

lg:GB-SI-2013-3134-sch2
