lg:GB-SI-2013-3134-r13-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-SI-2013-3134-r13-1 ;
    lgo:retrievedOn "2026-11-07"^^xsd:date ;
    lgo:sourceDocument lg:GB-SI-2013-3134-source ;
    lgo:sourceElement "/Legislation/Secondary[1]/Body[1]/Part[2]/Chapter[1]/P1group[7]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/uksi/2013/3134/regulation/13"^^xsd:anyURI ;
    lgo:text """(1) Before the consumer is bound by a distance contract, the trader—
(a) must give or make available to the consumer the information listed in Schedule 2 in a clear and comprehensible manner, and in a way appropriate to the means of distance communication used, and
(b) if a right to cancel exists, must give or make available to the consumer a cancellation form as set out in part B of Schedule 3."""@en .

