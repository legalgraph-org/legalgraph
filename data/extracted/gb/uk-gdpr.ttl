lg:GB-UK-GDPR-art28-3-h-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art28-3-h ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[4]/EUSection[1]/P1group[5]/P1[1]/P1para[1]/P2[3]/P2para[1]/P3[8]" ;
