lg:GB-UK-GDPR-art28-3-h
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 28(3)(h) UK GDPR" ;
    lgo:regulates lgv:Processor ;
