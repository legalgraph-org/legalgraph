lg:GB-UK-GDPR-art28-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art28-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[4]/EUSection[1]/P1group[5]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/28"^^xsd:anyURI ;
    lgo:text "(1) Where processing is to be carried out on behalf of a controller, the controller shall use only processors providing sufficient guarantees to implement appropriate technical and organisational measures in such a manner that processing will meet the requirements of this Regulation and ensure the protection of the rights of the data subject."@en .

