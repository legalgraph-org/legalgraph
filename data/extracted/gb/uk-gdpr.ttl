lg:GB-UK-GDPR-art3-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art3-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[1]/P1group[3]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/3"^^xsd:anyURI ;
    lgo:text """(2) This Regulation applies to the relevant processing of personal data of data subjects who are in the United Kingdom by a controller or processor not established in the United Kingdom, where the processing activities are related to:
(a) the offering of goods or services, irrespective of whether a payment of the data subject is required, to such data subjects in the United Kingdom; or
(b) the monitoring of their behaviour as far as their behaviour takes place within the United Kingdom."""@en .

lg:GB-UK-GDPR-art30-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 30(1) UK GDPR" ;
    lgo:regulates lgv:ProcessingRecord ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[4]/EUSection[1]/P1group[7]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/30"^^xsd:anyURI .

lg:GB-UK-GDPR-art30-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art30-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[4]/EUSection[1]/P1group[7]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/30"^^xsd:anyURI ;
    lgo:text """(1) Each controller and, where applicable, the controller's representative, shall maintain a record of processing activities under its responsibility. That record shall contain all of the following information:
(a) the name and contact details of the controller and, where applicable, the joint controller, the controller's representative and the data protection officer;
(b) the purposes of the processing;
(c) a description of the categories of data subjects and of the categories of personal data;
(d) the categories of recipients to whom the personal data have been or will be disclosed including recipients in third countries or international organisations;
(e) where applicable, transfers of personal data to a third country or an international organisation, including the identification of that third country or international organisation and, in the case of transfers referred to in the second subparagraph of Article 49(1), the documentation of suitable safeguards;
(f) where possible, the envisaged time limits for erasure of the different categories of data;
(g) where possible, a general description of the technical and organisational security measures referred to in Article 32(1) or, as appropriate, the security measures referred to in section 28(3) of the 2018 Act."""@en .

lg:GB-UK-GDPR-art30-2
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 30(2) UK GDPR" ;
    lgo:regulates lgv:ProcessingRecord ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[4]/EUSection[1]/P1group[7]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/30"^^xsd:anyURI .

lg:GB-UK-GDPR-art30-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art30-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[4]/EUSection[1]/P1group[7]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/30"^^xsd:anyURI ;
    lgo:text """(2) Each processor and, where applicable, the processor's representative shall maintain a record of all categories of processing activities carried out on behalf of a controller, containing:
(a) the name and contact details of the processor or processors and of each controller on behalf of which the processor is acting, and, where applicable, of the controller's or the processor's representative, and the data protection officer;
(b) the categories of processing carried out on behalf of each controller;
(c) where applicable, transfers of personal data to a third country or an international organisation, including the identification of that third country or international organisation and, in the case of transfers referred to in the second subparagraph of Article 49(1), the documentation of suitable safeguards;
(d) where possible, a general description of the technical and organisational security measures referred to in Article 32(1) or, as appropriate, the security measures referred to in section 28(3) of the 2018 Act."""@en .

lg:GB-UK-GDPR-art4-1-11
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 4(1)(11) UK GDPR" ;
    lgo:defines lgv:Consent ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[1]/P1group[4]/P1[1]/P1para[1]/P2[1]/P2para[1]/P3[16]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/4"^^xsd:anyURI .

lg:GB-UK-GDPR-art4-1-11-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art4-1-11 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[1]/P1group[4]/P1[1]/P1para[1]/P2[1]/P2para[1]/P3[16]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/4"^^xsd:anyURI ;
    lgo:text "(11) ‘consent’ of the data subject means any freely given, specific, informed and unambiguous indication of the data subject's wishes by which he or she, by a statement or by a clear affirmative action, signifies agreement to the processing of personal data relating to him or her (and see paragraphs 6 and 7 of this Article);"@en .

lg:GB-UK-GDPR-art5-1-e
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 5(1)(e) UK GDPR" ;
    lgo:regulates lgv:StorageLimitation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[1]/P1[1]/P1para[1]/P2[1]/P2para[1]/P3[5]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/5"^^xsd:anyURI .

lg:GB-UK-GDPR-art5-1-e-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art5-1-e ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[1]/P1[1]/P1para[1]/P2[1]/P2para[1]/P3[5]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/5"^^xsd:anyURI ;
    lgo:text "(e) kept in a form which permits identification of data subjects for no longer than is necessary for the purposes for which the personal data are processed; personal data may be stored for longer periods insofar as the personal data will be processed solely for archiving purposes in the public interest, scientific or historical research purposes or statistical purposes in accordance with Article 84B (‘storage limitation’);"@en .

lg:GB-UK-GDPR-art5-2
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 5(2) UK GDPR" ;
    lgo:regulates lgv:Accountability ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[1]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/5"^^xsd:anyURI .

lg:GB-UK-GDPR-art5-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art5-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[1]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/5"^^xsd:anyURI ;
    lgo:text "(2) The controller shall be responsible for, and be able to demonstrate compliance with, paragraph 1 (‘accountability’)."@en .

lg:GB-UK-GDPR-art6-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 6(1) UK GDPR" ;
    lgo:defines lgv:LawfulBasis ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[2]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/6"^^xsd:anyURI .

lg:GB-UK-GDPR-art6-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art6-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[2]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/6"^^xsd:anyURI ;
    lgo:text """(1) Processing shall be lawful only if and to the extent that at least one of the following applies:
(a) the data subject has given consent to the processing of his or her personal data for one or more specific purposes;
(b) processing is necessary for the performance of a contract to which the data subject is party or in order to take steps at the request of the data subject prior to entering into a contract;
(c) processing is necessary for compliance with a legal obligation to which the controller is subject;
(d) processing is necessary in order to protect the vital interests of the data subject or of another natural person;
(e) processing is necessary for the performance of a task of the controller carried out in the public interest or a task carried out in the exercise of official authority vested in the controller;
(ea) processing is necessary for the purposes of a recognised legitimate interest;
(f) processing is necessary for the purposes of the legitimate interests pursued by the controller or by a third party, except where such interests are overridden by the interests or fundamental rights and freedoms of the data subject which require protection of personal data, in particular where the data subject is a child.
Points (ea) and (f) of the first subparagraph shall not apply to processing carried out by public authorities in the performance of their tasks."""@en .

lg:GB-UK-GDPR-art7-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 7(1) UK GDPR" ;
    lgo:regulates lgv:Consent ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[3]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/7"^^xsd:anyURI .

lg:GB-UK-GDPR-art7-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art7-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[3]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/7"^^xsd:anyURI ;
    lgo:text "(1) Where processing is based on consent, the controller shall be able to demonstrate that the data subject has consented to processing of his or her personal data."@en .

lg:GB-UK-GDPR-art7-2
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 7(2) UK GDPR" ;
    lgo:regulates lgv:Consent ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[3]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/7"^^xsd:anyURI .

lg:GB-UK-GDPR-art7-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art7-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[3]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/7"^^xsd:anyURI ;
    lgo:text "(2) If the data subject's consent is given in the context of a written declaration which also concerns other matters, the request for consent shall be presented in a manner which is clearly distinguishable from the other matters, in an intelligible and easily accessible form, using clear and plain language. Any part of such a declaration which constitutes an infringement of this Regulation shall not be binding."@en .

lg:GB-UK-GDPR-art7-3
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 7(3) UK GDPR" ;
    lgo:regulates lgv:Consent ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[3]/P1[1]/P1para[1]/P2[3]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/7"^^xsd:anyURI .

lg:GB-UK-GDPR-art7-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art7-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[3]/P1[1]/P1para[1]/P2[3]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/7"^^xsd:anyURI ;
    lgo:text "(3) The data subject shall have the right to withdraw his or her consent at any time. The withdrawal of consent shall not affect the lawfulness of processing based on consent before its withdrawal. Prior to giving consent, the data subject shall be informed thereof. It shall be as easy to withdraw as to give consent."@en .

lg:GB-UK-GDPR-art7-4
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 7(4) UK GDPR" ;
    lgo:regulates lgv:Consent ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[3]/P1[1]/P1para[1]/P2[4]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/7"^^xsd:anyURI .

lg:GB-UK-GDPR-art7-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art7-4 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[2]/P1group[3]/P1[1]/P1para[1]/P2[4]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/7"^^xsd:anyURI ;
    lgo:text "(4) When assessing whether consent is freely given, utmost account shall be taken of whether, inter alia, the performance of a contract, including the provision of a service, is conditional on consent to the processing of personal data that is not necessary for the performance of that contract."@en .

lg:GB-UK-GDPR-art82-1
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 82(1) UK GDPR" ;
    lgo:regulates lgv:LiabilityForProcessing ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[8]/P1group[6]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/82"^^xsd:anyURI .

lg:GB-UK-GDPR-art82-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art82-1 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[8]/P1group[6]/P1[1]/P1para[1]/P2[1]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/82"^^xsd:anyURI ;
    lgo:text "(1) Any person who has suffered material or non-material damage as a result of an infringement of this Regulation shall have the right to receive compensation from the controller or processor for the damage suffered."@en .

lg:GB-UK-GDPR-art82-2
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 82(2) UK GDPR" ;
    lgo:regulates lgv:LiabilityForProcessing ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[8]/P1group[6]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/82"^^xsd:anyURI .

lg:GB-UK-GDPR-art82-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art82-2 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[8]/P1group[6]/P1[1]/P1para[1]/P2[2]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/82"^^xsd:anyURI ;
    lgo:text "(2) Any controller involved in processing shall be liable for the damage caused by processing which infringes this Regulation. A processor shall be liable for the damage caused by processing only where it has not complied with obligations of this Regulation specifically directed to processors or where it has acted outside or contrary to lawful instructions of the controller."@en .

lg:GB-UK-GDPR-art82-3
    a lgo:Provision ;
    eli:is_part_of lg:GB-UK-GDPR ;
    lgo:citation "Art. 82(3) UK GDPR" ;
    lgo:regulates lgv:LiabilityForProcessing ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[8]/P1group[6]/P1[1]/P1para[1]/P2[3]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/82"^^xsd:anyURI .

lg:GB-UK-GDPR-art82-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:GB-UK-GDPR-art82-3 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:GB-UK-GDPR-source ;
    lgo:sourceElement "/Legislation/EURetained[1]/EUBody[1]/EUChapter[8]/P1group[6]/P1[1]/P1para[1]/P2[3]" ;
    lgo:sourceUrl "https://www.legislation.gov.uk/eur/2016/679/article/82"^^xsd:anyURI ;
    lgo:text "(3) A controller or processor shall be exempt from liability under paragraph 2 if it proves that it is not in any way responsible for the event giving rise to the damage."@en .

