lg:US-CA-BPC
    a lgo:LegalAct ;
    eli:date_document "2025-01-01"^^xsd:date ;
    eli:title "California Business and Professions Code (§ 17602 Automatic Purchase Renewals; §§ 22575–22579 Internet Privacy Requirements)"@en ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:US-CA ;
