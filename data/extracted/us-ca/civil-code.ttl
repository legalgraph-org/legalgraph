lg:US-CA-CIV-s1789-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:US-CA-CIV-s1789-3 ;
    lgo:retrievedOn "2026-11-03"^^xsd:date ;
    lgo:sourceDocument lg:US-CA-CIV-1789-3-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?sectionNum=1789.3.&lawCode=CIV"^^xsd:anyURI ;
    lgo:text """The provider of an electronic commercial service shall provide to consumers with which it contracts to provide the service, at the time it contracts to provide the service and annually, on or before June 30 of each year thereafter, all of the following information:
(a) The name, address, and telephone number of the provider of service.
(b) Any charges to the consumer imposed by the provider for the use of the service.
(c) The procedures a consumer may follow in order to resolve a complaint regarding the service or to receive further information regarding use of the service, including the telephone number and address of the Complaint Assistance Unit of the Division of Consumer Services of the Department of Consumer Affairs. (Amended by Stats. 1986, Ch. 508, Sec. 1.)"""@en .
