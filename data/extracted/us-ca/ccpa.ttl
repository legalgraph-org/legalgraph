lg:US-CA-CCPA-1798-120-b-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:US-CA-CCPA-1798-120-b ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:US-CA-CCPA-source-2 ;
    lgo:sourceElement "/law/section[2]/paragraph[2]" ;
    lgo:sourceUrl "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=1798.120"^^xsd:anyURI ;
    lgo:text "(b) A business that sells consumers’ personal information to, or shares it with, third parties shall provide notice to consumers, pursuant to subdivision (a) of Section 1798.135, that this information may be sold or shared and that consumers have the “right to opt out” of the sale or sharing of their personal information."@en .

lg:US-CA-CCPA-1798-121-a
    a lgo:Provision ;
    eli:is_part_of lg:US-CA-CCPA ;
