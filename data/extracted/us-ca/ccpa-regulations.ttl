    lgo:sourceElement "/law/section[2]/paragraph[2]" ;
    lgo:sourceUrl "https://cppa.ca.gov/regulations/pdf/ccpa_statute_eff_20260101.pdf"^^xsd:anyURI .

lg:US-CA-CCR-11-7002-b-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:US-CA-CCR-11-7002-b ;
    lgo:retrievedOn "2026-11-08"^^xsd:date ;
    lgo:sourceDocument lg:US-CA-CCR-11-CCPA-source ;
    lgo:sourceElement "/law/section[2]/paragraph[2]" ;
    lgo:sourceUrl "https://cppa.ca.gov/regulations/pdf/ccpa_statute_eff_20260101.pdf"^^xsd:anyURI ;
    lgo:text "(b) The purpose(s) for which the personal information was collected or processed shall be consistent with the reasonable expectations of the consumer(s) whose personal information is collected or processed."@en .

lg:US-CA-CCR-11-7025-b
    a lgo:Provision ;
    eli:is_part_of lg:US-CA-CCR-11-CCPA ;
    lgo:citation "Cal. Code Regs. tit. 11, § 7025(b)" ;
    lgo:refersTo lg:US-CA-CCPA-1798-120-a ;
    lgo:regulates lgv:OptOutPreferenceSignal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:US-CA-CCR-11-CCPA-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://cppa.ca.gov/regulations/pdf/ccpa_statute_eff_20260101.pdf"^^xsd:anyURI .

lg:US-CA-CCR-11-7025-b-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:US-CA-CCR-11-7025-b ;
    lgo:retrievedOn "2026-11-08"^^xsd:date ;
    lgo:sourceDocument lg:US-CA-CCR-11-CCPA-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://cppa.ca.gov/regulations/pdf/ccpa_statute_eff_20260101.pdf"^^xsd:anyURI ;
    lgo:text """(b) A business that sells or shares personal information shall process any opt-out preference signal that meets the following requirements as a valid request to opt-out of sale/sharing:
(1) The signal shall be in a format commonly used and recognized by businesses. An example would be an HTTP header field or JavaScript object.
(2) The platform, technology, or mechanism that sends the opt-out preference signal shall make clear to the consumer, whether in its configuration or in disclosures to the public, that the use of the signal is meant to have the effect of opting the consumer out of the sale and sharing of their personal information. The configuration or disclosure does not need to be tailored only to California or to refer to California."""@en .

lg:US-CA-CCR-11-7025-c-1
    a lgo:Provision ;
    eli:is_part_of lg:US-CA-CCR-11-CCPA ;
    lgo:citation "Cal. Code Regs. tit. 11, § 7025(c)(1)" ;
    lgo:refersTo lg:US-CA-CCPA-1798-120-a ;
    lgo:regulates lgv:OptOutPreferenceSignal ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:US-CA-CCR-11-CCPA-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
