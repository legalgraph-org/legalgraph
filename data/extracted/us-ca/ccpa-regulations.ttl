lg:US-CA-CCR-11-7025-c-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:US-CA-CCR-11-7025-c-1 ;
    lgo:retrievedOn "2026-11-08"^^xsd:date ;
    lgo:sourceDocument lg:US-CA-CCR-11-CCPA-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://cppa.ca.gov/regulations/pdf/ccpa_statute_eff_20260101.pdf"^^xsd:anyURI ;
    lgo:text "(1) The business shall treat the opt-out preference signal as a valid request to opt-out of sale/sharing submitted pursuant to Civil Code section 1798.120 for that browser or device and any consumer profile associated with that browser or device, including pseudonymous profiles. If known, the business shall also treat the opt-out preference signal as a valid request to opt-out of sale/sharing for the consumer. This is not required for a business that does not sell or share personal information."@en .

lg:US-CA-CCR-11-7026-a
    a lgo:Provision ;
    eli:is_part_of lg:US-CA-CCR-11-CCPA ;
    lgo:citation "Cal. Code Regs. tit. 11, § 7026(a)" ;
    lgo:refersTo lg:US-CA-CCPA-1798-120-a ;
    lgo:regulates lgv:RightToOptOutOfSale ;
    lgo:reviewStatus lgv:SourceChecked ;
