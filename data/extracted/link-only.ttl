    lgo:sourceUrl "http://web.archive.org/web/20220111202235/https://www.legifrance.gouv.fr/cnil/id/CNILTEXT000044840062"^^xsd:anyURI ;
    lgo:supports lg:FR-CNIL-SAN-2021-023 ;
    rdfs:comment "The first publication of SAN-2021-023 names the companies shown today as [X] (fined €90m) and [Y] (fined €60m), in the same operative points the graph quotes from the current text."@en .

lg:ref-cnil-san-2021-024-archived-publication
    a lgo:ExternalReference ;
    dcterms:date "2022-01-06"^^xsd:date ;
    dcterms:publisher "Internet Archive (Wayback Machine capture of legifrance.gouv.fr)" ;
    dcterms:title "Délibération SAN-2021-024 du 31 décembre 2021 (Légifrance, as published in January 2022)" ;
    lgo:linkOnlyReason "the decision as first published, before the two-year anonymisation the decision itself provides for; linked so the party shown as [X] and the website shown as [V].com can be verified, not stored, so the graph does not republish names the regulator has withdrawn" ;
    lgo:sourceUrl "http://web.archive.org/web/20220106231046/https://www.legifrance.gouv.fr/cnil/id/CNILTEXT000044840532"^^xsd:anyURI ;
    lgo:supports lg:FR-CNIL-SAN-2021-024 ;
    rdfs:comment "The first publication of SAN-2021-024 names the company shown today as [X] (fined €60m) and the website shown as [V].com, in the same operative points the graph quotes from the current text."@en .

lg:ref-oag-sephora-press-release
    a lgo:ExternalReference ;
    dcterms:date "2022-08-24"^^xsd:date ;
    dcterms:publisher "California Attorney General" ;
    dcterms:title "Attorney General Bonta Announces Settlement with Sephora as Part of Ongoing Enforcement of California Consumer Privacy Act" ;
    lgo:excerpt "failed to process user requests to opt out of sale via user-enabled global privacy controls in violation of the CCPA, and that it did not cure these violations within the 30-day period currently allowed"@en ;
    lgo:excerptLocator "second paragraph" ;
    lgo:linkOnlyReason "government press release; the filed judgment is stored as us-ca/ag-v-sephora — this page adds the enforcement context (first CCPA enforcement, GPC sweep) in the AG's own words" ;
    lgo:sourceUrl "https://oag.ca.gov/news/press-releases/attorney-general-bonta-announces-settlement-sephora-part-ongoing-enforcement"^^xsd:anyURI ;
    lgo:supports lg:US-CA-SFSC-2022-0824-sephora ;
    rdfs:comment "California AG v. Sephora (2022): $1.2m — the first CCPA enforcement action, for not honouring Global Privacy Control opt-out signals."@en .
