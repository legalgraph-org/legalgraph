lg:ref-cnil-google-cookie-injunction-closure
    a lgo:ExternalReference ;
    dcterms:date "2023-07-13"^^xsd:date ;
    dcterms:publisher "CNIL" ;
    dcterms:title "Closure of the injunction issued against GOOGLE" ;
    lgo:excerpt "in addition to imposing a fine of 150 million euros, the CNIL's restricted committee ordered GOOGLE LLC and GOOGLE IRELAND LIMITED to allow users of the websites google.fr and youtube.com located in France to refuse the cookies placed on their terminal as easily as to accept them"@en ;
    lgo:excerptLocator "second paragraph" ;
    lgo:linkOnlyReason "official press item on cnil.fr; useful as the English-language account of SAN-2021-023 and its outcome, but not a normative text worth storing as an original" ;
    lgo:sourceUrl "https://www.cnil.fr/en/closure-injunction-issued-against-google"^^xsd:anyURI ;
    lgo:supports lg:FR-CNIL-SAN-2021-023 ;
    rdfs:comment "CNIL fined Google a total of €150m on 31 December 2021 (SAN-2021-023) for making cookies harder to refuse than to accept, and closed the injunction on 13 July 2023 after Google added an equally easy refusal button."@en .

