lg:ref-oag-sephora-press-release
    a lgo:ExternalReference ;
    dcterms:date "2022-08-24"^^xsd:date ;
    dcterms:publisher "California Attorney General" ;
    dcterms:title "Attorney General Bonta Announces Settlement with Sephora as Part of Ongoing Enforcement of California Consumer Privacy Act" ;
    lgo:excerpt "failed to process user requests to opt out of sale via user-enabled global privacy controls in violation of the CCPA, and that it did not cure these violations within the 30-day period currently allowed"@en ;
