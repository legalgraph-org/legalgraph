lg:ref-oag-sephora-press-release
    a lgo:ExternalReference ;
    dcterms:date "2022-08-24"^^xsd:date ;
    dcterms:publisher "California Attorney General" ;
    dcterms:title "Attorney General Bonta Announces Settlement with Sephora as Part of Ongoing Enforcement of California Consumer Privacy Act" ;
    lgo:excerpt "failed to process user requests to opt out of sale via user-enabled global privacy controls in violation of the CCPA, and that it did not cure these violations within the 30-day period currently allowed"@en ;
    lgo:excerptLocator "second paragraph" ;
    lgo:linkOnlyReason "government press release; the filed judgment is stored as us-ca/ag-v-sephora — this page adds the enforcement context (first CCPA enforcement, GPC sweep) in the AG's own words" ;
    lgo:sourceUrl "https://oag.ca.gov/news/press-releases/attorney-general-bonta-announces-settlement-sephora-part-ongoing-enforcement"^^xsd:anyURI ;
    lgo:supports lg:US-CA-SFSC-2022-0824-sephora ;
    rdfs:comment "California AG v. Sephora (2022): $1.2m — the first CCPA enforcement action, for not honouring Global Privacy Control opt-out signals."@en .
