lg:BG-ZET-art4-1
    a lgo:Provision ;
    eli:is_part_of lg:BG-ZET ;
    lgo:citation "член 4, ал. 1 ЗЕТ" ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:EmailAddress , lgv:GeographicAddress , lgv:PhoneNumber , lgv:ProfessionalBody , lgv:ProfessionalRules , lgv:ProfessionalTitle , lgv:ProviderName , lgv:RapidContact , lgv:RegisterEntry , lgv:SupervisoryAuthority , lgv:VatId ;
    lgo:reviewStatus lgv:SourceChecked ;
