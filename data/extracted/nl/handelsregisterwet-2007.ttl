lg:NL-HRW-art27-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:NL-HRW-art27-2 ;
    lgo:retrievedOn "2026-11-14"^^xsd:date ;
    lgo:sourceDocument lg:NL-HRW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0021777/2025-07-16/0/Hoofdstuk4/Paragraaf4.4/Artikel27"^^xsd:anyURI ;
    lgo:text "2 Het in het eerste lid bedoelde nummer is het nummer, bedoeld in artikel 9, onderdeel a, of in artikel 13, onderdeel a."@nl .

