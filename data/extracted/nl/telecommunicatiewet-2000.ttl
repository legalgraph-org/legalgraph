    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0009950/2025-07-01/0/Hoofdstuk11/Paragraaf11.7/Artikel11.7a"^^xsd:anyURI .

lg:NL-TW-art11-7a-3-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:NL-TW-art11-7a-3 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:NL-TW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[3]" ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0009950/2025-07-01/0/Hoofdstuk11/Paragraaf11.7/Artikel11.7a"^^xsd:anyURI ;
    lgo:text """Het bepaalde in het eerste lid is niet van toepassing indien het de opslag of toegang betreft:
a. met als uitsluitend doel de communicatie over een elektronisch communicatienetwerk uit te voeren,
b. die strikt noodzakelijk is om de door de abonnee of gebruiker gevraagde dienst van de informatiemaatschappij te leveren of – mits dit geen of geringe gevolgen heeft voor de persoonlijke levenssfeer van de betrokken abonnee of gebruiker – om informatie te verkrijgen over de kwaliteit of effectiviteit van een geleverde dienst van de informatiemaatschappij."""@nl .

lg:NL-TW-art11-7a-4
    a lgo:Provision ;
    eli:is_part_of lg:NL-TW ;
    lgo:citation "art. 11.7a, lid 4 Telecommunicatiewet" ;
    lgo:regulates lgv:PersonalData ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:NL-TW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0009950/2025-07-01/0/Hoofdstuk11/Paragraaf11.7/Artikel11.7a"^^xsd:anyURI .

lg:NL-TW-art11-7a-4-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:NL-TW-art11-7a-4 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:NL-TW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[4]" ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0009950/2025-07-01/0/Hoofdstuk11/Paragraaf11.7/Artikel11.7a"^^xsd:anyURI ;
    lgo:text "Een handeling als bedoeld in het eerste lid, die tot doel heeft gegevens over het gebruik van verschillende diensten van de informatiemaatschappij door de gebruiker of de abonnee te verzamelen, combineren of analyseren zodat de betrokken gebruiker of abonnee anders behandeld kan worden, wordt vermoed een verwerking van persoonsgegevens te zijn."@nl .

lg:NL-TW-art11-7a-5
    a lgo:Provision ;
    eli:is_part_of lg:NL-TW ;
    lgo:citation "art. 11.7a, lid 5 Telecommunicatiewet" ;
    lgo:regulates lgv:Consent ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:NL-TW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[5]" ;
