lg:NL-TW-art11-7a-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:NL-TW-art11-7a-5 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:NL-TW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[5]" ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0009950/2025-07-01/0/Hoofdstuk11/Paragraaf11.7/Artikel11.7a"^^xsd:anyURI ;
    lgo:text "De toegang van de gebruiker tot een dienst van de informatiemaatschappij die wordt geleverd door of namens een krachtens publiekrecht ingestelde rechtspersoon wordt niet afhankelijk gemaakt van het verlenen van toestemming als bedoeld in het eerste lid."@nl .

lg:NL-TW-art11-7a-6
    a lgo:Provision ;
    eli:is_part_of lg:NL-TW ;
    lgo:citation "art. 11.7a, lid 6 Telecommunicatiewet" ;
    lgo:regulates lgv:TerminalEquipmentAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:NL-TW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[6]" ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0009950/2025-07-01/0/Hoofdstuk11/Paragraaf11.7/Artikel11.7a"^^xsd:anyURI .

lg:NL-TW-art11-7a-6-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:NL-TW-art11-7a-6 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:NL-TW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[6]" ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0009950/2025-07-01/0/Hoofdstuk11/Paragraaf11.7/Artikel11.7a"^^xsd:anyURI ;
    lgo:text "Bij of krachtens algemene maatregel van bestuur kunnen in overeenstemming met Onze Minister van Veiligheid en Justitie nadere regels worden gegeven met betrekking tot de in het eerste lid, onder a en b, genoemde vereisten en de in het derde lid genoemde uitzonderingen."@nl .

