lg:NL-TW-art11-7a-1-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:NL-TW-art11-7a-1 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:NL-TW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[1]" ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0009950/2025-07-01/0/Hoofdstuk11/Paragraaf11.7/Artikel11.7a"^^xsd:anyURI ;
    lgo:text """Onverminderd de Algemene verordening gegevensbescherming is het via een elektronisch communicatienetwerk opslaan van of toegang verkrijgen tot informatie in de randapparatuur van een gebruiker, alleen toegestaan op voorwaarde dat de betrokken gebruiker:
a. is voorzien van duidelijke en volledige informatie overeenkomstig de Algemene verordening gegevensbescherming, in ieder geval over de doeleinden waarvoor deze informatie wordt gebruikt, en
b. daarvoor toestemming heeft verleend."""@nl .

lg:NL-TW-art11-7a-2
    a lgo:Provision ;
    eli:is_part_of lg:NL-TW ;
    lgo:citation "art. 11.7a, lid 2 Telecommunicatiewet" ;
    lgo:implements lg:EU-2002-58-art5-3 ;
    lgo:regulates lgv:Consent , lgv:TerminalEquipmentAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:NL-TW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0009950/2025-07-01/0/Hoofdstuk11/Paragraaf11.7/Artikel11.7a"^^xsd:anyURI .

lg:NL-TW-art11-7a-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:NL-TW-art11-7a-2 ;
    lgo:retrievedOn "2026-11-15"^^xsd:date ;
    lgo:sourceDocument lg:NL-TW-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0009950/2025-07-01/0/Hoofdstuk11/Paragraaf11.7/Artikel11.7a"^^xsd:anyURI ;
    lgo:text "De in het eerste lid, onder a en b, genoemde vereisten zijn ook van toepassing in het geval op een andere wijze dan door middel van een elektronisch communicatienetwerk wordt bewerkstelligd dat via een elektronisch communicatienetwerk informatie wordt opgeslagen of toegang wordt verleend tot op het randapparaat opgeslagen informatie."@nl .

lg:NL-TW-art11-7a-3
    a lgo:Provision ;
    eli:is_part_of lg:NL-TW ;
    lgo:citation "art. 11.7a, lid 3 Telecommunicatiewet" ;
    lgo:implements lg:EU-2002-58-art5-3 ;
    lgo:regulates lgv:StrictlyNecessaryAccess , lgv:TransmissionOnlyAccess ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:NL-TW-source ;
