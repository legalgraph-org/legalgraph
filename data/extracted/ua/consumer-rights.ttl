lg:UA-3153-art17-1
    a lgo:Provision ;
    eli:is_part_of lg:UA-3153 ;
    lgo:citation "ст. 17 ч. 1 Закону «Про захист прав споживачів»" ;
    lgo:regulates lgv:PreContractInformation ;
    lgo:requiresDisclosureOf lgv:CodesOfConduct , lgv:CommercialGuarantee , lgv:CommunicationCosts , lgv:ComplaintAddress , lgv:ContractDuration , lgv:DeliveryCosts , lgv:Deposit , lgv:DigitalProductInformation , lgv:DisputeResolutionStatement , lgv:EmailAddress , lgv:GeographicAddress , lgv:LegalGuarantee , lgv:MainCharacteristics , lgv:PaymentAndDeliveryTerms , lgv:PersonalisedPricing , lgv:PhoneNumber , lgv:ProviderName , lgv:RegisterEntry , lgv:ReturnCosts , lgv:TaxId , lgv:TotalPrice , lgv:VatId , lgv:WithdrawalInformation ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:UA-3153-source ;
