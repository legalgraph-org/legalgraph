lg:UA-2704
    a lgo:LegalAct ;
    eli:date_document "2019-04-25"^^xsd:date ;
    eli:title "Про забезпечення функціонування української мови як державної"@uk ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:UA ;
    lgo:reviewStatus lgv:SourceChecked ;
    lgo:sourceDocument lg:UA-2704-source , lg:UA-2704-source-en ;
