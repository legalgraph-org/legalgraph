lg:UA-2849-art2-2
    a lgo:Provision ;
    eli:is_part_of lg:UA-2849 ;
    lgo:citation "ст. 2 ч. 2 Закону «Про медіа»" ;
    lgo:defines lgv:OnlineMedia ;
