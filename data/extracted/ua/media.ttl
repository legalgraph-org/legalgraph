lg:UA-2849-art37-5-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:UA-2849-art37-5 ;
    lgo:retrievedOn "2026-11-02"^^xsd:date ;
    lgo:sourceDocument lg:UA-2849-source ;
    lgo:sourceElement "/law/section[2]/paragraph[1]" ;
    lgo:sourceUrl "https://zakon.rada.gov.ua/laws/show/2849-20#n531"^^xsd:anyURI ;
    lgo:text """5. Зареєстровані суб’єкти у сфері онлайн-медіа зобов’язані оприлюднювати та регулярно оновлювати на своєму веб-сайті (у своєму онлайн-профілі) такі вихідні дані:
1) офіційна (зареєстрована) назва онлайн-медіа;
2) поштова адреса, телефон, адреса електронної пошти суб’єкта;
3) ідентифікатор онлайн-медіа в Реєстрі."""@uk .

