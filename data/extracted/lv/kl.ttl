lg:LV-KL-art17-2-q1
    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:LV-KL-art17-2 ;
    lgo:retrievedOn "2026-11-12"^^xsd:date ;
    lgo:sourceDocument lg:LV-KL-source ;
    lgo:sourceElement "/law/section[1]/paragraph[2]" ;
    lgo:sourceUrl "https://likumi.lv/ta/id/5490-komerclikums"^^xsd:anyURI ;
    lgo:text """(2) Ja komersants atvēris filiāli, tās dokumentos papīra vai elektroniskā formā papildus šā panta pirmajā daļā minētajām ziņām norāda:
1) filiāles firmu, ja tā atšķiras no komersanta firmas;
2) filiāles reģistrācijas numuru komercreģistrā;
3) filiāles juridisko adresi."""@lv .

