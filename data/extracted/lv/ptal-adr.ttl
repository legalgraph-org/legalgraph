    a lgo:Quote ;
    lgo:officialLanguageVersion true ;
    lgo:quoteOf lg:LV-PTAL-art19-1-2 ;
    lgo:retrievedOn "2026-11-13"^^xsd:date ;
    lgo:sourceDocument lg:LV-PTAL-source ;
