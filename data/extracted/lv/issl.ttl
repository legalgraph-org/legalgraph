lg:LV-ISSL-art4-1
    a lgo:Provision ;
    eli:is_part_of lg:LV-ISSL ;
    lgo:citation "4. pants (1) ISSL" ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:requiresDisclosureOf lgv:EmailAddress , lgv:GeographicAddress , lgv:ProfessionalBody , lgv:ProfessionalRules , lgv:ProfessionalTitle , lgv:ProviderName , lgv:RapidContact , lgv:RegisterEntry , lgv:SupervisoryAuthority , lgv:VatId ;
