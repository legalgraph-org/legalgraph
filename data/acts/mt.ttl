@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:  <https://legalgraph.org/id/> .
@prefix eli:  <http://data.europa.eu/eli/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

lg:MT-CAP426 a lgo:LegalAct ;
    eli:title "Electronic Commerce Act (Cap. 426)"@en ;
    lgo:shortName "e-Commerce Act (Malta)" ;
    eli:id_local "Cap. 426" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:MT ;
    eli:date_document "2002-05-10"^^xsd:date ;
    lgo:sourceUrl "https://legislation.mt/eli/cap/426/eng"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "Article 8C (added by Act XXXV of 2016) transposes Article 5 ECD and adds item (h): the provider must show, prominently and wherever users give data, how they can opt out of unsolicited commercial communications."@en .

lg:MT-CAP386
    lgo:shortName "Companies Act (Cap. 386)" ;
    eli:transposes lg:EU-2017-1132 ;
    rdfs:seeAlso <https://legislation.mt/eli/cap/386/eng> ;
    rdfs:comment "Article 6 is the Maltese company-law website duty: name, kind of partnership, registered office and registration number on business letters, order forms in any medium and the partnership's internet website(s); Part XI oversea companies add branch particulars and winding-up; sub-article (8) the issued-plus-paid-up capital clause."@en .

lg:MT-SL-378-18
    eli:transposes lg:EU-2013-11 ;
    rdfs:seeAlso <https://legislation.mt/eli/sl/378.18/eng> ;
    rdfs:comment "Regulation 14 is the trader ADR information duty transposing Directive 2013/11 Art. 13 in full; Cap. 378 Part VI delegates the details to these regulations."@en .
