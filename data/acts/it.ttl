# IT: draft. Act and citation from research notes; not yet checked against the official text.

lg:IT-DLGS-70-2003 a lgo:LegalAct ;
    eli:title "Decreto legislativo 9 aprile 2003, n. 70"@it , "Legislative Decree No. 70/2003 on electronic commerce"@en ;
    lgo:shortName "D.Lgs. 70/2003" ;
    lgo:actType lgv:Decree ;
    lgo:jurisdiction lg:IT ;
    eli:transposes lg:EU-2000-31 ;
    lgo:sourceUrl "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.legislativo:2003-04-09;70"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked .

# The provisions of art. 7 come from sources/it/dlgs-70-2003 (official
# normattiva.it text); this block keeps only act-level metadata.

lg:IT-196-2003 a lgo:LegalAct ;
    eli:title "Codice in materia di protezione dei dati personali"@it , "Personal Data Protection Code"@en ;
    lgo:shortName "Codice privacy" ;
    lgo:actType lgv:Decree ;
    lgo:jurisdiction lg:IT ;
    eli:date_document "2003-06-30"^^xsd:date ;
    eli:transposes lg:EU-2002-58 ;
    lgo:sourceUrl "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.legislativo:2003-06-30;196"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "Article 122 is the Italian cookie rule: informed consent for storage and access on terminal equipment, consent may come through browser or device settings (comma 2), and accessing stored information is otherwise prohibited (2-bis). The Garante's 2021 cookie guidelines apply it."@en .

# Codice del consumo (D.Lgs. 206/2005): art. 141-sexies, the trader-information
# duty for consumer ADR (Directive 2013/11/EU Art. 13).

lg:IT-DLGS-206-2005 a lgo:LegalAct ;
    eli:title "Codice del consumo"@it , "Consumer Code"@en ;
    lgo:shortName "Codice del consumo" ;
    eli:date_document "2005-09-06"^^xsd:date ;
    eli:transposes lg:EU-2013-11 ;
    lgo:reviewStatus lgv:SourceChecked .

# Garante Provvedimento n. 231 del 10 giugno 2021 (GU Serie generale n. 163
# del 09-07-2021): Italy's cookie guidance — consent via a positive act,
# scrolling is never consent, the cookie wall is unlawful without an
# equivalent content/service alternative, excessive banner re-proposal
# undermines freedom of consent, and legitimate interest cannot justify
# cookies or other tracking tools.

lg:IT-GARANTE-231-2021 a lgo:Guidance ;
    eli:title "Linee guida cookie e altri strumenti di tracciamento"@it , "Guidelines on cookies and other tracking tools"@en ;
    lgo:shortName "Linee guida cookie Garante" ;
    lgo:actType lgv:Guidelines ;
    lgo:jurisdiction lg:IT ;
    eli:id_local "Provvedimento Garante n. 231 del 10 giugno 2021, GU n. 163 del 09-07-2021" ;
    eli:date_document "2021-06-10"^^xsd:date ;
    lgo:sourceUrl "https://www.garanteprivacy.it/home/docweb/-/docweb-display/docweb/9677876"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "Guidance, not binding text: scrolling is never consent (§ 6.1); the cookie wall ('take it or leave it') is unlawful unless the site offers access to equivalent content or a service without consent (§ 6.1); excessive re-proposal of the banner after refusal undermines freedom of consent (§ 6.2); legitimate interest cannot justify cookies or other tracking tools (§ 5)."@en .
