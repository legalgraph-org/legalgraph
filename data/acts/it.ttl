# IT: draft. Act and citation from research notes; not yet checked against the official text.

lg:IT-DLGS-70-2003 a lgo:LegalAct ;
    eli:title "Decreto legislativo 9 aprile 2003, n. 70"@it , "Legislative Decree No. 70/2003 on electronic commerce"@en ;
    lgo:shortName "D.Lgs. 70/2003" ;
    lgo:actType lgv:Decree ;
    lgo:jurisdiction lg:IT ;
    eli:transposes lg:EU-2000-31 ;
    lgo:sourceUrl "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.legislativo:2003-04-09;70"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked .

# The provisions of art. 7 come from sources/it/dlgs-70-2003 (official
# normattiva.it text); this block keeps only act-level metadata.

lg:IT-196-2003 a lgo:LegalAct ;
    eli:title "Codice in materia di protezione dei dati personali"@it , "Personal Data Protection Code"@en ;
    lgo:shortName "Codice privacy" ;
    lgo:actType lgv:Decree ;
    lgo:jurisdiction lg:IT ;
    eli:date_document "2003-06-30"^^xsd:date ;
    eli:transposes lg:EU-2002-58 ;
    lgo:sourceUrl "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.legislativo:2003-06-30;196"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "Article 122 is the Italian cookie rule: informed consent for storage and access on terminal equipment, consent may come through browser or device settings (comma 2), and accessing stored information is otherwise prohibited (2-bis). The Garante's 2021 cookie guidelines apply it."@en .

# Codice del consumo (D.Lgs. 206/2005): art. 141-sexies, the trader-information
# duty for consumer ADR (Directive 2013/11/EU Art. 13).

