    eli:title "Codice del consumo"@it , "Consumer Code"@en ;
    lgo:shortName "Codice del consumo" ;
    eli:date_document "2005-09-06"^^xsd:date ;
    eli:transposes lg:EU-2013-11 ;
    lgo:reviewStatus lgv:SourceChecked .
