@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:  <https://legalgraph.org/id/> .
@prefix eli:  <http://data.europa.eu/eli/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Austria: § 5 ECG (Impressum) and the media-law disclosure of § 25 MedienG.

lg:AT-ECG a lgo:LegalAct ;
    eli:title "Bundesgesetz, mit dem bestimmte rechtliche Aspekte des elektronischen Geschäfts- und Rechtsverkehrs geregelt werden (E-Commerce-Gesetz – ECG)"@de , "E-Commerce Act"@en ;
    lgo:shortName "ECG" ;
    eli:id_local "BGBl. I Nr. 152/2001" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:AT ;
    eli:transposes lg:EU-2000-31 ;
    lgo:reviewStatus lgv:SourceChecked .

# § 5 ECG is now sourced from RIS's consolidated text: see sources/at/ecg and
# data/extracted/at/ecg.ttl. § 14 UGB and § 165(3) TKG come from sources/at/ugb and sources/at/tkg.

lg:AT-DSG a lgo:LegalAct ;
    eli:title "Bundesgesetz zum Schutz natürlicher Personen bei der Verarbeitung personenbezogener Daten (Datenschutzgesetz – DSG)"@de , "Data Protection Act"@en ;
    lgo:shortName "DSG" ;
    eli:id_local "BGBl. I Nr. 165/1999" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:AT ;
    eli:date_document "1999-07-08"^^xsd:date ;
    eli:transposes lg:EU-2016-679 ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/eli/bgbl/i/1999/165"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "The GDPR applies directly in Austria; the DSG adds national rules. Website-relevant provisions sourced from the consolidated RIS text: § 43 information duty (privacy policy content and timing), § 49 records of processing (Art. 30 GDPR plus profiling and legal basis), § 57 DPO designation and publication of contact details."@en .


lg:AT-UGB a lgo:LegalAct ;
    eli:title "Unternehmensgesetzbuch"@de , "Commercial Code"@en ;
    lgo:shortName "UGB" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:AT ;
    eli:transposes lg:EU-2017-1132 ;
    eli:date_document "2005-12-30"^^xsd:date ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "§ 14 is the Austrian imprint duty for companies in the Firmenbuch: Firma, Rechtsform, Sitz, Firmenbuchnummer, winding-up and Firmenbuchgericht on business letters, order forms and websites, and capital details where capital is stated (§ 14(2))."@en .

lg:AT-TKG-2021 a lgo:LegalAct ;
    eli:title "Telekommunikationsgesetz 2021"@de , "Telecommunications Act 2021"@en ;
    lgo:shortName "TKG 2021" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:AT ;
    eli:date_document "2021-10-28"^^xsd:date ;
    eli:transposes lg:EU-2002-58 ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/eli/bgbl/I/2021/190"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "§ 165(3) is the Austrian cookie rule: information-society services must tell the user which personal data they process, the legal basis, purposes and retention, and may collect it only with active consent on clear comprehensive information; the technical-necessity exception follows."@en .

lg:AT-FAGG
    lgo:shortName "FAGG" ;
    eli:transposes lg:EU-2011-83 ;
    rdfs:comment "Austria's transposition of the Consumer Rights Directive's information duties for distance contracts: § 4 Abs. 1 is the pre-contractual information list (Article 6(1))."@en .

lg:AT-KSCHG
    lgo:shortName "KSchG" ;
    eli:transposes lg:EU-1993-13 ;
    rdfs:comment "The Austrian consumer-protection act; § 6 is the blacklist of contract terms that are never effective against consumers (§ 879 ABGB is the general clause)."@en .

lg:AT-MEDIENG
    lgo:shortName "MedienG" ;
    rdfs:comment "The Austrian media act. § 25 is the media-owner disclosure (Offenlegung): it applies to websites as periodical electronic media, in full for most and reduced to name and residence or seat for sites limited to the owner's personal life or self-presentation (Abs. 5). It sits beside the e-Commerce imprint of § 5 ECG and may be published together with it (Abs. 1)."@en .

lg:AT-ASTG
    lgo:shortName "AStG" ;
    eli:transposes lg:EU-2013-11 ;
    rdfs:seeAlso <https://www.ris.bka.gv.at/eli/bgbl/i/2015/105/P19/NOR40173800> ;
    rdfs:comment "§ 19 transposes art. 13 of the ADR Directive: a trader committed or obliged to use a consumer ADR body names it with its website on its own website and in its terms; Abs. 3 is the durable-medium pointer after a failed settlement attempt."@en .

lg:AT-BAFG
    lgo:shortName "BaFG" ;
    eli:id_local "BGBl. I Nr. 76/2023" ;
    eli:transposes lg:EU-2019-882 ;
    eli:date_document "2023-07-19"^^xsd:date ;
    eli:first_date_entry_in_force "2025-06-28"^^xsd:date ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/eli/bgbl/I/2023/76"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "Austria's accessibility act (EAA transposition, in force 28.06.2025). § 2(2) Z 6 brings e-commerce services for consumers within scope; § 4(3) points to the accessibility requirements of Anlage 1 for services; § 6(1) exempts microenterprises (< 10 staff, turnover or balance sheet ≤ EUR 2m — § 3 Z 19); § 14(2) requires the service provider to create the Annex 3 information and make it available to the public in writing and orally, in a form accessible to people with disabilities — the accessibility statement."@en .
