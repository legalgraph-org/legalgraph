@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:  <https://legalgraph.org/id/> .
@prefix eli:  <http://data.europa.eu/eli/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Austria: § 5 ECG (Impressum) and the media-law disclosure of § 25 MedienG.

lg:AT-ECG a lgo:LegalAct ;
    eli:title "Bundesgesetz, mit dem bestimmte rechtliche Aspekte des elektronischen Geschäfts- und Rechtsverkehrs geregelt werden (E-Commerce-Gesetz – ECG)"@de , "E-Commerce Act"@en ;
    lgo:shortName "ECG" ;
    eli:id_local "BGBl. I Nr. 152/2001" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:AT ;
    eli:transposes lg:EU-2000-31 ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=20001703"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked .

# § 5 ECG is now sourced from RIS's consolidated text: see sources/at/ecg and
# data/extracted/at/ecg.ttl. § 14 UGB and § 165(3) TKG come from sources/at/ugb and sources/at/tkg.


lg:AT-UGB a lgo:LegalAct ;
    eli:title "Unternehmensgesetzbuch"@de , "Commercial Code"@en ;
    lgo:shortName "UGB" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:AT ;
    eli:date_document "2005-12-30"^^xsd:date ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10001702"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "§ 14 is the Austrian imprint duty for companies in the Firmenbuch: Firma, Rechtsform, Sitz, Firmenbuchnummer, winding-up and Firmenbuchgericht on business letters, order forms and websites, and capital details where capital is stated (§ 14(2))."@en .

lg:AT-TKG-2021 a lgo:LegalAct ;
    eli:title "Telekommunikationsgesetz 2021"@de , "Telecommunications Act 2021"@en ;
    lgo:shortName "TKG 2021" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:AT ;
    eli:date_document "2021-10-28"^^xsd:date ;
    eli:transposes lg:EU-2002-58 ;
    lgo:sourceUrl "https://www.ris.bka.gv.at/eli/bgbl/I/2021/190"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "§ 165(3) is the Austrian cookie rule: information-society services must tell the user which personal data they process, the legal basis, purposes and retention, and may collect it only with active consent on clear comprehensive information; the technical-necessity exception follows."@en .

lg:AT-FAGG
    lgo:shortName "FAGG" ;
    rdfs:comment "Austria's transposition of the Consumer Rights Directive's information duties for distance contracts: § 4 Abs. 1 is the pre-contractual information list (Article 6(1))."@en .

lg:AT-KSCHG
    lgo:shortName "KSchG" ;
    rdfs:comment "The Austrian consumer-protection act; § 6 is the blacklist of contract terms that are never effective against consumers (§ 879 ABGB is the general clause)."@en .
