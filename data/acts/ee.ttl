# Estonia: § 4 of the Information Society Services Act.

lg:EE-ISSA a lgo:LegalAct ;
    eli:title "Infoühiskonna teenuse seadus"@et , "Information Society Services Act"@en ;
    lgo:shortName "InfoTS" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:EE ;
    eli:transposes lg:EU-2000-31 ;
    lgo:sourceUrl "https://www.riigiteataja.ee/et/akt/104072024024"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked .

# The provisions of § 4 come from sources/ee/iss (official riigiteataja.ee text);
# this block keeps only act-level metadata.

# Tarbijakaitseseadus (Consumer Protection Act): the trader-information duty;
# provisions come from sources/ee/tks (official riigiteataja.ee text).
lg:EE-TKS a lgo:LegalAct ;
    eli:title "Tarbijakaitseseadus"@et , "Consumer Protection Act"@en ;
    lgo:shortName "TKS" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:EE ;
    eli:transposes lg:EU-2013-11 ;
    lgo:sourceUrl "https://www.riigiteataja.ee/akt/103072026028"^^xsd:anyURI ;
    eli:id_local "RT I, 31.12.2015, 1" ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "§ 26 requires traders to make complaint contact details available (lõige 1), to notify consumers of the recognised ADR body incl. its name, contact details, website address and procedure rules (lõige 2), to display that information clearly, understandably and accessibly on the trader's website where it has one and in its general terms or at its place of business (lõige 3), and to give the ADR information on durable media when refusing a claim (lõige 4). Lõige 5 (ODR platform notice) is repealed in the current consolidation."@en .
