# SI: draft. Act and citation from research notes; not yet checked against the official text.

lg:SI-ZEPT a lgo:LegalAct ;
    eli:title "Zakon o elektronskem poslovanju na trgu"@sl , "Electronic Commerce Market Act"@en ;
    lgo:shortName "ZEPT" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:SI ;
    eli:transposes lg:EU-2000-31 ;
    lgo:sourceUrl "http://www.pisrs.si/Pis.web/pregledPredpisa?id=ZAKO4600"^^xsd:anyURI ;
    lgo:reviewStatus lgv:Draft .

lg:SI-ZEPT-cl5 a lgo:Provision ;
    eli:is_part_of lg:SI-ZEPT ;
    lgo:citation "5. člen ZEPT" ;
    lgo:sourceUrl "http://www.pisrs.si/Pis.web/pregledPredpisa?id=ZAKO4600"^^xsd:anyURI ;
    lgo:implements lg:EU-2000-31-art5-1 ;
    lgo:regulates lgv:ProviderIdentification ;
    lgo:reviewStatus lgv:Draft .
