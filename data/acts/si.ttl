@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:  <https://legalgraph.org/id/> .
@prefix eli:  <http://data.europa.eu/eli/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Slovenia: 5. člen of the ZEPT, sourced from the official pisrs.si consolidated text.

lg:SI-ZEPT a lgo:LegalAct ;
    eli:title "Zakon o elektronskem poslovanju na trgu"@sl , "Electronic Commerce Market Act"@en ;
    lgo:shortName "ZEPT" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:SI ;
    eli:transposes lg:EU-2000-31 ;
    lgo:reviewStatus lgv:SourceChecked .

# The provisions of 5. člen come from sources/si/zept (official pisrs.si text);
# this block keeps only act-level metadata.

lg:SI-ZISRPS a lgo:LegalAct ;
    eli:title "Zakon o izvensodnem reševanju potrošniških sporov"@sl , "Out-of-Court Resolution of Consumer Disputes Act"@en ;
    lgo:shortName "ZIsRPS" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:SI ;
    eli:transposes lg:EU-2013-11 ;
    rdfs:comment "Art. 32(4) asks online sellers to link to the EU ODR platform. The platform closed on 20 July 2025 when Regulation (EU) 2024/3228 repealed Regulation 524/2013; the Slovenian text is unamended, but the government stated the related obligation ceases to apply from that date."@en ;
    lgo:reviewStatus lgv:SourceChecked .

# 32. člen comes from sources/si/zisrps (official gazette PDF, Ur. l. RS
# 81/15); the act was never amended, so the original text is current.

# ZEKom-2: 225. člen ("piškotki") is the storage-and-access rule — the
# ePrivacy Directive Art. 5(3) transposition, on the consent model.

lg:SI-ZEKOM-2 a lgo:LegalAct ;
    eli:title "Zakon o elektronskih komunikacijah"@sl , "Electronic Communications Act"@en ;
    lgo:shortName "ZEKom-2" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:SI ;
    lgo:sourceUrl "https://pisrs.si/pregledPredpisa?id=ZAKO8611"^^xsd:anyURI ;
    eli:id_local "Uradni list RS št. 130/22" ;
    eli:transposes lg:EU-2002-58 ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "225. člen permits storing information on, or accessing information stored on, a subscriber's or user's terminal equipment only with the subscriber's or user's consent after clear and exhaustive information about the controller and the purposes of processing under the personal-data-protection rules; odstavek 2 excepts transmission-only storage/access and access strictly necessary for an expressly requested information-society service; odstavek 3 lets consent be expressed through appropriate browser or application settings, counting as personal consent under the data-protection rules."@en .
