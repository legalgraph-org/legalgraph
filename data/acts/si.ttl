@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:  <https://legalgraph.org/id/> .
@prefix eli:  <http://data.europa.eu/eli/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Slovenia: 5. člen of the ZEPT, sourced from the official pisrs.si consolidated text.

lg:SI-ZEPT a lgo:LegalAct ;
    eli:title "Zakon o elektronskem poslovanju na trgu"@sl , "Electronic Commerce Market Act"@en ;
    lgo:shortName "ZEPT" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:SI ;
    eli:transposes lg:EU-2000-31 ;
    lgo:reviewStatus lgv:SourceChecked .

# The provisions of 5. člen come from sources/si/zept (official pisrs.si text);
# this block keeps only act-level metadata.

lg:SI-ZISRPS a lgo:LegalAct ;
    eli:title "Zakon o izvensodnem reševanju potrošniških sporov"@sl , "Out-of-Court Resolution of Consumer Disputes Act"@en ;
    lgo:shortName "ZIsRPS" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:SI ;
    eli:transposes lg:EU-2013-11 ;
    lgo:reviewStatus lgv:SourceChecked .

# 32. člen comes from sources/si/zisrps (official gazette PDF, Ur. l. RS
# 81/15); the act was never amended, so the original text is current.
