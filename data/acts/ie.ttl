@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:  <https://legalgraph.org/id/> .
@prefix eli:  <http://data.europa.eu/eli/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Ireland: Regulation 7 of S.I. No. 68/2003 (additions to data/extracted/ie/).

lg:IE-SI-2003-68
    lgo:shortName "S.I. No. 68/2003" ;
    eli:transposes lg:EU-2000-31 ;
    rdfs:seeAlso <https://www.irishstatutebook.ie/eli/2003/si/68/made/en/> ;
    rdfs:comment "Regulation 7(1)(d) is Ireland's own addition: the website must show, prominently and wherever users are asked for information, how natural persons can register their choice about unsolicited commercial communications."@en .

lg:IE-SI-336-2011 a lgo:LegalAct ;
    eli:title "European Communities (Electronic Communications Networks and Services) (Privacy and Electronic Communications) Regulations 2011"@en ;
    lgo:shortName "Irish PECR" ;
    lgo:actType lgv:StatutoryInstrument ;
    lgo:jurisdiction lg:IE ;
    eli:date_document "2011-07-01"^^xsd:date ;
    eli:transposes lg:EU-2002-58 ;
    lgo:sourceUrl "https://www.irishstatutebook.ie/eli/2011/si/336/made/en"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "Regulation 5(3)-(5) is the Irish cookie rule: consent plus clear and comprehensive information for storage or access on terminal equipment, consent may come through browser settings, and the technical-necessity exception."@en .

# Ireland: section 151 of the Companies Act 2014 (additions to data/extracted/ie/).

lg:IE-CA-2014
    lgo:shortName "CA 2014" ;
    eli:transposes lg:EU-2017-1132 ;
    rdfs:seeAlso <https://www.irishstatutebook.ie/eli/2014/act/38/enacted/en> ;
    rdfs:comment "Section 151(4) is the Irish company-law website duty: the name-and-legal-form, place-of-registration-and-number and registered-office particulars of subsection (2) must appear prominently and accessibly on any company website, and any stated share capital must be the issued paid-up capital."@en .

lg:IE-SI-343-2015
    lgo:shortName "SI 343/2015" ;
    eli:transposes lg:EU-2013-11 ;
    rdfs:seeAlso <https://www.irishstatutebook.ie/eli/2015/si/343/made/en/print> ;
    rdfs:comment "Reg. 18 transposes art. 13 of the ADR Directive: traders committed or obliged to use ADR name the entity with its website on their own website and in general terms; (5) makes breach a summary offence."@en .
