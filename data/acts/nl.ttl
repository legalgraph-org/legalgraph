@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lgv:  <https://legalgraph.org/vocab/> .
@prefix lg:  <https://legalgraph.org/id/> .
@prefix eli:  <http://data.europa.eu/eli/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Netherlands: Article 3:15d of the Civil Code.

lg:NL-BW3 a lgo:LegalAct ;
    eli:title "Burgerlijk Wetboek Boek 3"@nl , "Dutch Civil Code, Book 3"@en ;
    lgo:shortName "BW" ;
    eli:id_local "BWBR0005291" ;
    lgo:actType lgv:Code ;
    lgo:jurisdiction lg:NL ;
    eli:transposes lg:EU-2000-31 ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0005291/"^^xsd:anyURI ;
    lgo:reviewStatus lgv:SourceChecked .

# The provisions of art. 3:15d come from sources/nl/bw-boek3 (official
# wetten.overheid.nl text); this block keeps only act-level metadata.

# Handelsregisterwet 2007: the KvK-number duty; provisions come from
# sources/nl/handelsregisterwet-2007.
lg:NL-HRW a lgo:LegalAct ;
    eli:title "Handelsregisterwet 2007"@nl , "Trade Register Act 2007"@en ;
    lgo:shortName "Hrw 2007" ;
    lgo:actType lgv:Statute ;
    lgo:jurisdiction lg:NL ;
    lgo:sourceUrl "https://wetten.overheid.nl/BWBR0021777/"^^xsd:anyURI ;
    eli:id_local "BWBR0021777" ;
    lgo:reviewStatus lgv:SourceChecked ;
    rdfs:comment "Art. 27 requires registered undertakings and legal persons to state their trade-register number on all outgoing letters, orders, invoices, offers and other announcements, except advertisements; whether 'andere aankondigingen' reaches a website is for review — the express website duty is BW art. 3:15d(1)(c)."@en .
