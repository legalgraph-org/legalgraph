lg:SE-SFS-2002-562-s8-1-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "30d97cc93bb70a0eac0785eee6c912255601a0c6bae25e2421208b803930c22d" ;
    lgo:text """When a service provider provides information society services, the provider shall give information about its name, its address in the state of establishment and its e-mail address and, where applicable,
1. its corporate identity number,
2. its VAT registration number, and
3. the competent licensing authority."""@en ;
    lgo:translatedBy "devin-swe-2" ;
    lgo:translatedOn "2026-11-12"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-SFS-2002-562-s8-1-q1 .

lg:SE-SFS-2002-562-s8-2-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "f8e8078052695426e5da9273ef370461b8936893808b229acc466344f04b60f2" ;
    lgo:text """If a service provider carries on a regulated professional activity, the information shall also include details of
1. the professional title and the state in which it was obtained,
2. the professional body or similar organisation with which the service provider is registered, and
3. the rules that apply to the professional activity and how to access them."""@en ;
    lgo:translatedBy "devin-swe-2" ;
    lgo:translatedOn "2026-11-12"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-SFS-2002-562-s8-2-q1 .

lg:SE-SFS-2002-562-s8-3-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "133147985ade34bebbdec1392d6228b43d849a404a1e38ac9e3165bcea79091e" ;
    lgo:text "The information shall be available to service recipients and authorities in an easy, direct and permanent manner."@en ;
    lgo:translatedBy "devin-swe-2" ;
    lgo:translatedOn "2026-11-12"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-SFS-2002-562-s8-3-q1 .

lg:SE-SFS-2002-562-s8-4-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "ecf2c06f81c52503784a37d4db29599338bc64b1a601c7a080bd1d3c48a255c1" ;
    lgo:text "For providers of on-demand television and providers that provide on-demand radio and have an assignment under the Public Service Act (2025:986), Chapter 2, Section 1 of the Radio and Television Act (2010:696) also applies. Act (2025:989)."@en ;
    lgo:translatedBy "devin-swe-2" ;
    lgo:translatedOn "2026-11-12"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-SFS-2002-562-s8-4-q1 .
