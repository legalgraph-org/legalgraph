lg:SE-ABL-k28-s5-1-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "e9de0bd7faebfaa0e528ca980b94fce5dbf66e2832f9882445d76d5a19fda1f5" ;
    lgo:text "A limited company's letters, invoices, order forms and websites shall state the company's business name, the place where the board of directors has its seat, and the company's organisation number under the Act (1974:174) on identification codes for legal persons etc. If the company has gone into liquidation, this shall also be stated."@en ;
    lgo:translatedBy "SWE-2 (Devin)" ;
    lgo:translatedOn "2026-11-12"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-ABL-k28-s5-1-q1 .

lg:SE-ABL-k28-s5-2-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "74ddbfdf1b7c1858a6bf05a162cb1f8317b68e9d719b34bf94c5bafdf1e5e4ed" ;
    lgo:text "Where there are special reasons, the Swedish Companies Registration Office may permit a limited company not to state the company's business name on its websites. In that case, information shall instead be provided that the company is a limited company and of the company category. Such a permit shall be limited to a specified period and may be made subject to conditions."@en ;
    lgo:translatedBy "SWE-2 (Devin)" ;
    lgo:translatedOn "2026-11-12"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-ABL-k28-s5-2-q1 .

lg:SE-ABL-title-53e9a1ef4761-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "53e9a1ef47613ceda7c47d713ef5e55fa019799c30f01a3ce9b9c5e6eb8e8749" ;
    lgo:text "Companies Act (2005:551)"@en ;
    lgo:translatedBy "SWE-2 (Devin)" ;
    lgo:translatedOn "2026-11-12"^^xsd:date ;
    lgo:translatedProperty eli:title ;
    lgo:translationMethod lgv:MachineTranslation ;
