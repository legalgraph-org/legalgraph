lg:SE-ARL-s10-1-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "1db42180cebed3da7c409176877518159bf54779c31c886058f2f144acb702d6" ;
    lgo:text "A trader who has undertaken to resolve a dispute with a consumer through alternative dispute resolution shall provide clear, comprehensible and easily accessible information about the alternative dispute resolution board or boards to which the undertaking relates."@en ;
    lgo:translatedBy "Devin (SWE-2)" ;
    lgo:translatedOn "2026-11-13"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-ARL-s10-1-q1 .

lg:SE-ARL-s10-2-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "5e5c59f1dad6fd160227abe1880398a48a972c2b443374168669ce9158f043b5" ;
    lgo:text """The information shall be provided
1. on the trader's websites that are directed at consumers, if any, and
2. in any written contract terms between the trader and consumers."""@en ;
    lgo:translatedBy "Devin (SWE-2)" ;
    lgo:translatedOn "2026-11-13"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-ARL-s10-2-q1 .

lg:SE-ARL-s10-3-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "0b1a38064aa16ddaeba89a1be7bddad01683a6a58429033fd52767856432fd7b" ;
    lgo:text "The information shall contain the web address and postal address of the dispute resolution board concerned."@en ;
    lgo:translatedBy "Devin (SWE-2)" ;
    lgo:translatedOn "2026-11-13"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-ARL-s10-3-q1 .

lg:SE-ARL-s11-1-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "33a1ce04a429f59f1b82cbbe48317bc5d3106a54f21a713317e8f591865f5f1e" ;
    lgo:text "A trader who wholly or partly objects to a claim by a consumer arising from a contract between them shall at the same time inform the consumer of the alternative dispute resolution board to which the consumer may turn to have the claim examined. The trader shall also inform the consumer whether the trader intends to participate in the dispute resolution procedure."@en ;
    lgo:translatedBy "Devin (SWE-2)" ;
    lgo:translatedOn "2026-11-13"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-ARL-s11-1-q1 .

lg:SE-ARL-s11-2-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "b0b0ff89d1ea9a5003f91fa708b2d9afe6724f78533675704f531e062d97d1a9" ;
    lgo:text "The information referred to in the first paragraph shall be clear and comprehensible, contain the web address and postal address of the dispute resolution board concerned, and be given in a document or in some other readable and durable form accessible to the consumer."@en ;
    lgo:translatedBy "Devin (SWE-2)" ;
    lgo:translatedOn "2026-11-13"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-ARL-s11-2-q1 .

lg:SE-ARL-s12-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "3ee6b64afd800b023e80eb1fddc4747d575241fb0f2df0eb33699d2e5eb79a7f" ;
    lgo:text "12 § Provisions on consumer information to be provided by traders are found in Article 14 of the EU dispute resolution regulation."@en ;
    lgo:translatedBy "swe-2-high" ;
    lgo:translatedOn "2026-11-13"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SE-ARL-s12-q1 .

lg:SE-ARL-title-47cb2fac27ba-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "47cb2fac27ba6596d47d82fa32d84ad9b56ae8c5fea8c5a20c64554c524c2c2f" ;
    lgo:text "Act (2015:671) on alternative dispute resolution in consumer relations"@en ;
    lgo:translatedBy "swe-2-high" ;
    lgo:translatedOn "2026-11-13"^^xsd:date ;
    lgo:translatedProperty eli:title ;
