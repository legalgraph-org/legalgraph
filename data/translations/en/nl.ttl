lg:NL-BW3-art15d-1-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "1b343844275e34ad99f8075a35df70c7e9c5e8dbb936f0deac18c134aaa4a592" ;
    lgo:text """A person who provides an information society service shall make the following details easily, directly and permanently accessible to those who use that service, in particular to obtain information or to make information accessible:
a. their identity and place of establishment;
b. details that allow rapid contact and direct and effective communication with them, including their electronic mail address;
c. where they are entered in a trade register or a comparable public register: the register in which they are entered and their registration number, or an equivalent means of identification in that register;
[…]"""@en ;
