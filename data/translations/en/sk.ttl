lg:SK-ARS-391-s11-1-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "8b1aa945fa0c0dfdb7cc0839795fcd972c7b3d5a8a933583328bf599233bde3d" ;
    lgo:text "(1) The consumer has the right to submit a remedy request to the trader where a dispute arises between the consumer and the trader over the exercise of rights from liability for defects or where the consumer believes that the trader has infringed other consumer rights."@en ;
    lgo:translatedBy "swe-2-high" ;
    lgo:translatedOn "2026-11-13"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SK-ARS-391-s11-1-q1 .

lg:SK-ARS-391-s11-2-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "ecb9d1f96a7bebd29cd125843462b94cf1df055e56d3d726db305dc0cfa22bc7" ;
    lgo:text "(2) The trader shall inform the consumer on a durable medium about the competent alternative dispute resolution entities if the trader has answered the request under paragraph 1 negatively."@en ;
    lgo:translatedBy "swe-2-high" ;
    lgo:translatedOn "2026-11-13"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SK-ARS-391-s11-2-q1 .

lg:SK-ARS-391-s11-3-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "c06b33fbc038871a14f9be2fe2eabad5ac9669430e5ff0c557ac09788e4b21af" ;
    lgo:text "(3) The consumer has the right to submit a proposal to initiate alternative dispute resolution (hereinafter the “proposal”) to an alternative dispute resolution entity if the trader has answered the request under paragraph 1 negatively or has not answered it within 30 days of its dispatch."@en ;
    lgo:translatedBy "swe-2-high" ;
    lgo:translatedOn "2026-11-13"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:SK-ARS-391-s11-3-q1 .

lg:SK-ARS-391-title-6819ef5c6cf0-en
    a lgo:Translation ;
