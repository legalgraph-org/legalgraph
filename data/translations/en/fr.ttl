lg:FR-LIL-art82-3-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "2293fdd6affeae73d42eb5db8f7c5c539dd64f0971c4c4244540cd0e2d27ab82" ;
    lgo:text """These provisions do not apply if accessing information stored in the user's terminal equipment, or writing information to the user's terminal equipment:
1° Either has the sole purpose of enabling or facilitating communication by electronic means;
2° Or is strictly necessary for providing an online communication service at the express request of the user."""@en ;
    lgo:translatedBy "claude-opus-5-5" ;
    lgo:translatedOn "2026-11-04"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:FR-LIL-art82-3-q1 .

