lg:FR-CNIL-SAN-2021-023-d2-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "27f8664789596702348e2dce1d580987e9e1a0c5e75da9817a1efc69d802af54" ;
    lgo:text "impose on the company [Y] an administrative fine of 60,000,000 euros (sixty million euros) for breach of Article 82 of the Informatique et Libertés law"@en ;
    lgo:translatedBy "claude-opus-5-5" ;
    lgo:translatedOn "2026-11-04"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
