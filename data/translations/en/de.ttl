lg:DE-UStG-s27a-1-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "c74b220b9efcff352452e4219be647dce6f52162d4fb54e6ba818c05c7188aa0" ;
    lgo:text "(1) The Federal Central Tax Office issues a VAT identification number on application to entrepreneurs within the meaning of § 2. The Federal Central Tax Office also issues a VAT identification number to legal persons that are not entrepreneurs or that do not acquire goods for their business, if they need it for intra-Community acquisitions. In the case of a fiscal unity, a separate VAT identification number is issued on application for each legal person. The application for a VAT identification number under sentences 1 to 3 must be made in writing. The application must state the name, address and tax number under which the applicant is registered for VAT."@en ;
    lgo:translatedBy "claude-opus-5-5" ;
    lgo:translatedOn "2026-10-31"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:DE-UStG-s27a-1-q1 .

