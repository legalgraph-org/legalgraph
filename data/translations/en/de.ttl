lg:DE-VerpackDG-s6-1-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "52bdc32b7fc352fe08678b3cf6817f32ed89417f1495079c9a872d6aa8bfcb60" ;
    lgo:text "(1) Producers are obliged to register with the Central Agency Packaging Register, in the cases of Article 3(1) point 15(a) to (d) of Regulation (EU) 2025/40 as amended on 19 December 2024 before first making packaging available, or in the case of Article 3(1) point 15(e) of that Regulation before unpacking. Producers shall notify the Central Agency Packaging Register without delay of changes to registration data and of the permanent cessation of their activity as producer. The obligation under sentence 2 includes in particular notifying changes to or the ending of the appointment of the authorised representative for extended producer responsibility."@en ;
    lgo:translatedBy "claude-opus-5-5" ;
    lgo:translatedOn "2026-11-02"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:DE-VerpackDG-s6-1-q1 .

