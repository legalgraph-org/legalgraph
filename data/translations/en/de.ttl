    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "28ca5cccfd6a8da34819ff07e85f327cae04014a7c517a1a5d1b7d3204d0238f" ;
    lgo:text "in the case of a contract of indeterminate duration or a subscription contract, the total price; this comprises the total costs per billing period and, where such a contract is charged at a fixed rate, also the total monthly costs; where the total costs cannot reasonably be calculated in advance, the manner in which the price is calculated"@en ;
    lgo:translatedBy "devin" ;
