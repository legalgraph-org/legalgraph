lg:DE-GewO-s6c-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "ea76a8ea5dd17c940c60de764b6b1cde909366f71866762f9d7c523ec232e63c" ;
    lgo:text "The Federal Government is empowered to issue, by ordinance with the consent of the Bundesrat and in order to implement Directive 2006/123/EC, rules on information, in particular its content, scope and form, that a service provider must make or makes available to service recipients. The ordinance may also contain rules on the manner in which the information is to be made available."@en ;
    lgo:translatedBy "claude-opus-5-5" ;
    lgo:translatedOn "2026-10-31"^^xsd:date ;
    lgo:translationMethod lgv:MachineTranslation ;
    lgo:translationOf lg:DE-GewO-s6c-q1 .

