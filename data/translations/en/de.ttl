lg:DE-DDG-source-legalStatus-e38b4fd94f97-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "e38b4fd94f97f3b9c7eabb7ab16515b8e2db420362cb558b9f0e283066f9f5b6" ;
    lgo:text "Last amended by Art. 26(2) of the Act of 25 March 2026 (BGBl. I No. 81)"@en ;
    lgo:translatedBy "claude-opus-5-5" ;
