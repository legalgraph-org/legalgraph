lg:DE-AO-s139c-1-q1-en
    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "6dacd6c5d86d5a6930156f6e5d785afe1e54af3be58a6bc308d606f83113a6a1" ;
    lgo:text "(1) The economic identification number is assigned at the request of the competent tax authority. It begins with the letters „DE“. Each economic identification number may be assigned only once."@en ;
