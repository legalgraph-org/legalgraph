    a lgo:Translation ;
    lgo:reviewStatus lgv:Draft ;
    lgo:sourceTextSha256 "a201b7937610a9dae44c77e8d262f3fbd620c95343d5cebcadeea1b88a0c2768" ;
    lgo:text "Last amended by Art. 6 of the Act of 22 October 2026 (BGBl. I No. 322)"@en ;
    lgo:translatedBy "claude-opus-5-5" ;
    lgo:translatedOn "2026-11-08"^^xsd:date ;
