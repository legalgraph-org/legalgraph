# --- Beyond the EU and EEA ---------------------------------------------------------
lg:CA a lgo:Country ;
    rdfs:label "Canada"@en ;
    lgo:isoCode "CA" ;
    lgo:officialLanguage "en"^^xsd:language , "fr"^^xsd:language ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/country/CAN> .


lg:GB a lgo:Country ;
    rdfs:label "United Kingdom"@en ;
    lgo:isoCode "GB" ;
    lgo:officialLanguage "en"^^xsd:language ;
    rdfs:comment "Left the EU on 31 January 2020. Websites of companies must show the company's registered name, number and office (Company, Limited Liability Partnership and Business (Names and Trading Disclosures) Regulations 2015); cookies are governed by PECR, personal data by the UK GDPR and the Data Protection Act 2018."@en .

lg:US a lgo:Country ;
    rdfs:label "United States"@en ;
    lgo:isoCode "US" ;
    lgo:officialLanguage "en"^^xsd:language ;
    rdfs:comment "No general website disclosure duty like the Impressum. Accessibility claims rest on the Americans with Disabilities Act; privacy is regulated sector by sector and by states, such as California (CCPA)."@en .

lg:US-CA a lgo:Subdivision ;
    rdfs:label "California"@en ;
    lgo:isoCode "US-CA" ;
    lgo:subdivisionOf lg:US ;
    lgo:officialLanguage "en"^^xsd:language .

lg:CA-ON a lgo:Subdivision ;
    rdfs:label "Ontario"@en ;
    lgo:isoCode "CA-ON" ;
    lgo:subdivisionOf lg:CA ;
    lgo:officialLanguage "en"^^xsd:language , "fr"^^xsd:language .

lg:CA-QC a lgo:Subdivision ;
    rdfs:label "Quebec"@en ;
    lgo:isoCode "CA-QC" ;
    lgo:subdivisionOf lg:CA ;
    lgo:officialLanguage "fr"^^xsd:language .

lg:UA a lgo:Country ;
    rdfs:label "Ukraine"@en ;
    lgo:isoCode "UA" ;
    lgo:officialLanguage "uk"^^xsd:language ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/country/UKR> ;
    rdfs:comment "EU candidate country since 2022, aligning its law with the EU's (consumer rights, personal data, media). Laws are published by the Verkhovna Rada on zakon.rada.gov.ua, in Ukrainian; English versions there are unofficial."@en .
