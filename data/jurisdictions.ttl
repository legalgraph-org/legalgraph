@prefix lgo:  <https://legalgraph.org/ontology#> .
@prefix lg:  <https://legalgraph.org/id/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Jurisdictions: the EU, the EEA, the European countries the graph covers, and the others it has laws for.
# skos:exactMatch links to the EU Publications Office country authority table.

lg:EU a lgo:SupranationalOrganisation ;
    rdfs:label "European Union"@en , "Europäische Union"@de ;
    lgo:isoCode "EU" .

lg:EEA a lgo:SupranationalOrganisation ;
    rdfs:label "European Economic Area"@en , "Europäischer Wirtschaftsraum"@de ;
    rdfs:comment "EU law on the internal market, including the e-Commerce Directive, applies in Iceland, Liechtenstein and Norway through the EEA Agreement."@en ;
    lgo:isoCode "EEA" .

